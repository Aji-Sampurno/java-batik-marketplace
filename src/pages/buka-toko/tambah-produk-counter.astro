				const colorKeywords = [
					{ kw: "HITAM", name: "Hitam" }, { kw: "BLACK", name: "BLACK" },
					{ kw: "PUTIH", name: "Putih" }, { kw: "WHITE", name: "Putih" },
					{ kw: "MERAH", name: "Merah" }, { kw: "RED", name: "Merah" },
					{ kw: "MAROON", name: "Maroon" }, { kw: "MARON", name: "MARON" },
					{ kw: "COKLAT", name: "Coklat" }, { kw: "BROWN", name: "Coklat" },
					{ kw: "KUNING", name: "Kuning" }, { kw: "YELLOW", name: "Kuning" },
					{ kw: "HIJAU", name: "Hijau" }, { kw: "GREEN", name: "Hijau" },
					{ kw: "BIRU", name: "Biru" }, { kw: "BLUE", name: "Biru" },
					{ kw: "NAVY", name: "NAVY" }, { kw: "ABU", name: "Abu-abu" },
					{ kw: "GREY", name: "GREY" }, { kw: "GRAY", name: "GREY" },
					{ kw: "KREM", name: "Krem" }, { kw: "CREAM", name: "Krem" },
					{ kw: "PINK", name: "PINK" }, { kw: "UNGU", name: "Ungu" },
					{ kw: "GOLD", name: "Gold" }, { kw: "SOGA", name: "SOGA" },
					{ kw: "SOGAN", name: "SOGA" }, { kw: "ORANYE", name: "Oranye" }
				];
				colorKeywords.forEach(c => {
					if (itemUpperName.includes(c.kw)) {
						const cb = colorGrid.querySelector(`input[value="${c.name}" i]`);
						if (cb) cb.checked = true;
					}
				});
			}

			// Render Counter & Motif Variant Rows
			let detailsArr = item.details;
			if (typeof detailsArr === "string") {
				try { detailsArr = JSON.parse(detailsArr); } catch(e) {}
			}

			if (Array.isArray(detailsArr) && detailsArr.length > 0) {
				renderCounterRows(detailsArr, item);
			} else {
				renderCounterRows([{
					id: item.id,
					counter: item.counter || "01",
