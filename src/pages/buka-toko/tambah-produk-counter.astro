						<button type="button" class="btn-delete-row" style="background: none; border: none; color: #94a3b8; font-size: 0.9rem; font-weight: 800; cursor: pointer; padding: 4px; transition: color 0.15s;" onmouseover="this.style.color='#dc2626'" onmouseout="this.style.color='#94a3b8'" title="Hapus Varian Ini">✕</button>
					</td>
				`;

				container.appendChild(row);

				// Connect Events
				const cb = row.querySelector(".v-counter-cb");
				const sizeHidden = row.querySelector(".v-size-hidden");
				const skuHidden = row.querySelector(".v-sku-hidden");
				const sizeSelect = row.querySelector(".v-size-select");
				const priceDisp = row.querySelector(".v-price-display");
				const priceHidden = row.querySelector(".v-price-hidden");
				const stockInput = row.querySelector(".v-stock-input");
				const dalamanSelect = row.querySelector(".v-dalaman-select");
				const motifSelect = row.querySelector(".v-motif-select");
				const motifHidden = row.querySelector(".v-motif-hidden");
				const deleteBtn = row.querySelector(".btn-delete-row");

				// Photo upload per row
				const thumbBox = row.querySelector(".v-thumb-box");
				const overlay = row.querySelector(".v-upload-overlay");
				const fileInp = row.querySelector(".v-row-file-input");
				const triggerBtn = row.querySelector(".btn-trigger-upload");

				if (thumbBox && overlay && fileInp) {
					thumbBox.addEventListener("mouseenter", () => overlay.style.opacity = "1");
					thumbBox.addEventListener("mouseleave", () => overlay.style.opacity = "0");
					thumbBox.addEventListener("click", () => fileInp.click());
					if (triggerBtn) triggerBtn.addEventListener("click", () => fileInp.click());

					fileInp.addEventListener("change", () => {
						if (fileInp.files && fileInp.files[0]) {
							const file = fileInp.files[0];
							const currentMotif = motifSelect?.value || "Motif A";
							createWatermarkedDataUrl(file, (watermarkedUrl) => {
								syncPhotosForMotif(currentMotif, watermarkedUrl, file);
							});
						}
					});
				}

				cb.addEventListener("change", () => {
					const active = cb.checked;
					row.style.opacity = active ? "1" : "0.35";
					sizeHidden.disabled = !active;
					skuHidden.disabled = !active;
					sizeSelect.disabled = !active;
					priceDisp.disabled = !active;
					priceHidden.disabled = !active;
					stockInput.disabled = !active;
					dalamanSelect.disabled = !active;
					motifSelect.disabled = !active;
					motifHidden.disabled = !active;
					if (fileInp) fileInp.disabled = !active;
				});

				motifSelect.addEventListener("change", () => {
					motifHidden.value = motifSelect.value;
					updateRowVariantName(row);
					renderMotifPhotoCards();
				});

				sizeSelect.addEventListener("change", () => updateRowVariantName(row));

				priceDisp.addEventListener("input", (e) => {
					const num = e.target.value.replace(/\D/g, "");
					priceHidden.value = num || "0";
					priceDisp.value = num ? parseInt(num, 10).toLocaleString("id-ID") : "";
				});

				deleteBtn.addEventListener("click", () => {
					row.remove();
					renderMotifPhotoCards();
				});
			});

			updateAllVariantNames();
			renderMotifPhotoCards();
		}

		function updateRowVariantName(row) {
			const sizeHidden = row.querySelector(".v-size-hidden");
			const motifSelect = row.querySelector(".v-motif-select");
			const sizeSelect = row.querySelector(".v-size-select");
			const currentSize = sizeSelect?.value || "ALL SIZE";
			const counter = row.dataset.counter || "";
			const format = document.querySelector('input[name="variant_name_format"]:checked')?.value || "motif_size";

			const chosenMotif = motifSelect?.value || "Motif";
			if (format === "motif_size") {
				sizeHidden.value = `${chosenMotif} - ${currentSize}`;
			} else if (format === "size_counter") {
				sizeHidden.value = `${currentSize} (${counter})`;
			} else {
				sizeHidden.value = currentSize;
			}
		}

		function updateAllVariantNames() {
			document.querySelectorAll(".counter-table-row").forEach(updateRowVariantName);
		}

		function renderSubCategoriesFromList(parentIds) {
			const container = document.getElementById("sub-category-checkboxes");
			if (!container) return;

			const hasExistingParents = parentIds && parentIds.length > 0 && parentIds[0] !== "";
			if (!hasExistingParents) {
				container.innerHTML = "";
				container.style.display = "none";
				return;
			}

			const l2Children = hierarchicalTypes.filter(t => parentIds.includes(t.parent_id));

			container.innerHTML = `
				<div style="margin-top: 0.85rem; padding: 0.85rem 1rem; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px;">
					<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem;">
						<label class="text-uppercase" style="font-size: 0.65rem; font-weight: 700; color: #64748b; margin: 0;">
							Jenis / Bahan Produk (Level 2)
						</label>
						<button type="button" id="btn-toggle-add-l2" style="background: none; border: none; font-size: 0.65rem; color: #0284c7; cursor: pointer; font-weight: 700; padding: 0;">
							+ Tambah Baru
						</button>
					</div>

					<div class="subcat-pills-container" id="l2-selection-row" style="display: flex; flex-wrap: wrap; gap: 0.4rem;"></div>

					<div id="new-l2-form-row" style="display: none; margin-top: 0.6rem; gap: 6px; align-items: center;">
						<input type="text" id="new-l2-input" placeholder="Nama Jenis/Bahan baru..." style="flex: 1; font-size: 0.75rem; padding: 5px 8px; border: 1px solid #cbd5e1; border-radius: 5px;" />
						<button type="button" id="add-l2-btn" style="font-size: 0.7rem; background: #0f172a; color: white; border: none; padding: 6px 10px; border-radius: 5px; cursor: pointer; font-weight: 700;">Simpan</button>
					</div>

					<div id="l3-selection-area" style="display: none; margin-top: 0.85rem; padding-top: 0.75rem; border-top: 1px dashed #cbd5e1;">
						<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem;">
							<label class="text-uppercase" style="font-size: 0.65rem; font-weight: 700; color: #64748b; margin: 0;">
								Pilihan Detail (Level 3)
							</label>
							<button type="button" id="btn-toggle-add-l3" style="background: none; border: none; font-size: 0.65rem; color: #0284c7; cursor: pointer; font-weight: 700; padding: 0;">
								+ Tambah Detail
							</button>
						</div>
						<div class="subcat-pills-container" id="l3-grid" style="display: flex; flex-wrap: wrap; gap: 0.4rem;"></div>
						<div id="new-l3-form-row" style="display: none; margin-top: 0.6rem; gap: 6px; align-items: center;">
							<input type="text" id="new-l3-input" placeholder="Nama Detail baru..." style="flex: 1; font-size: 0.75rem; padding: 5px 8px; border: 1px solid #cbd5e1; border-radius: 5px;" />
							<button type="button" id="add-l3-btn" style="font-size: 0.7rem; background: #0f172a; color: white; border: none; padding: 6px 10px; border-radius: 5px; cursor: pointer; font-weight: 700;">Simpan</button>
						</div>
					</div>
				</div>
			`;
			container.style.display = "block";

			const l2Row = container.querySelector("#l2-selection-row");
			const l3Area = container.querySelector("#l3-selection-area");
			const l3Grid = container.querySelector("#l3-grid");

			function createCatPill(name, id, isL2, parentId, isCustom = false) {
				const label = document.createElement("label");
				label.className = "cat-pill-label";
				label.style.cssText = "display: inline-flex; align-items: center; gap: 5px; font-size: 0.75rem; padding: 4px 10px; background: white; border: 1px solid #cbd5e1; border-radius: 20px; cursor: pointer; font-weight: 600; color: #334155; user-select: none; transition: all 0.15s;";

				const cleanVal = isCustom ? name : id;
				label.innerHTML = `
					<input type="checkbox" name="category_ids" value="${cleanVal}" data-id="${id}" data-parent="${parentId}" data-name="${name}" style="width: 14px; height: 14px; accent-color: #0f172a; cursor: pointer;" ${isCustom ? 'data-custom="true" checked' : ""} />
					<span>${name}</span>
				`;

				const cb = label.querySelector("input");
				const updateStyle = () => {
					if (cb.checked) {
						label.style.background = "#0f172a";
						label.style.color = "#ffffff";
						label.style.borderColor = "#0f172a";
					} else {
						label.style.background = "#ffffff";
						label.style.color = "#334155";
						label.style.borderColor = "#cbd5e1";
					}
				};

				cb.addEventListener("change", () => {
					if (isL2 && cb.checked) {
						l2Row.querySelectorAll("input:checked").forEach(o => {
							if (o !== cb) {
								o.checked = false;
								o.parentElement.style.background = "#ffffff";
								o.parentElement.style.color = "#334155";
								o.parentElement.style.borderColor = "#cbd5e1";
							}
						});
					}
					updateStyle();
					if (isL2) updateL3Selection();
				});

				updateStyle();
				return label;
			}

			function updateL3Selection() {
				const checkedL2s = Array.from(l2Row.querySelectorAll("input:checked"));
				l3Grid.innerHTML = "";

				if (checkedL2s.length === 0) {
					l3Area.style.display = "none";
					return;
				}

				let totalL3 = 0;
				checkedL2s.forEach(l2 => {
					const l2Id = l2.getAttribute("data-id");
					const isCustomL2 = l2.dataset.custom === "true";

					if (!isCustomL2) {
						const dbL3s = hierarchicalTypes.filter(t => String(t.parent_id) === String(l2Id));
						dbL3s.forEach(c => {
							totalL3++;
							l3Grid.appendChild(createCatPill(c.name, c.id, false, l2Id, false));
						});
					}
				});

				// Always show L3 area if L2 is selected so user can see or add L3
				l3Area.style.display = "block";
			}

			// Render existing L2
			l2Children.forEach(c => {
				l2Row.appendChild(createCatPill(c.name, c.id, true, c.parent_id, false));
			});

			// Toggle Add L2
			const toggleL2Btn = container.querySelector("#btn-toggle-add-l2");
			const formL2Row = container.querySelector("#new-l2-form-row");
			const inpL2 = container.querySelector("#new-l2-input");
			const btnL2 = container.querySelector("#add-l2-btn");

			toggleL2Btn?.addEventListener("click", () => {
				formL2Row.style.display = formL2Row.style.display === "flex" ? "none" : "flex";
				if (formL2Row.style.display === "flex") inpL2?.focus();
			});

			const handleL2Add = () => {
				const text = inpL2?.value.trim();
				if (!text) return;
				l2Row.querySelectorAll("input:checked").forEach(o => {
					o.checked = false;
					o.parentElement.style.background = "#ffffff";
					o.parentElement.style.color = "#334155";
					o.parentElement.style.borderColor = "#cbd5e1";
				});
				const rndId = "custom-l2-" + Math.random().toString(36).substr(2, 5);
				const el = createCatPill(text, rndId, true, parentIds[0], true);
				l2Row.appendChild(el);
				inpL2.value = "";
				formL2Row.style.display = "none";
				updateL3Selection();
			};
			btnL2?.addEventListener("click", handleL2Add);
			inpL2?.addEventListener("keypress", (e) => {
				if (e.key === "Enter") { e.preventDefault(); handleL2Add(); }
			});

			// Toggle Add L3
			const toggleL3Btn = container.querySelector("#btn-toggle-add-l3");
			const formL3Row = container.querySelector("#new-l3-form-row");
			const inpL3 = container.querySelector("#new-l3-input");
			const btnL3 = container.querySelector("#add-l3-btn");

			toggleL3Btn?.addEventListener("click", () => {
				formL3Row.style.display = formL3Row.style.display === "flex" ? "none" : "flex";
				if (formL3Row.style.display === "flex") inpL3?.focus();
			});

			const handleL3Add = () => {
				const text = inpL3?.value.trim();
				if (!text) return;
				const activeL2 = l2Row.querySelector("input:checked");
				const parentId = activeL2 ? activeL2.getAttribute("data-id") : null;
				const rndId = "custom-l3-" + Math.random().toString(36).substr(2, 5);
				const el = createCatPill(text, rndId, false, parentId, true);
				l3Grid.appendChild(el);
				inpL3.value = "";
				formL3Row.style.display = "none";
			};
			btnL3?.addEventListener("click", handleL3Add);
			inpL3?.addEventListener("keypress", (e) => {
				if (e.key === "Enter") { e.preventDefault(); handleL3Add(); }
			});
		}

		function setupCategoryDropdown() {
			const container = document.querySelector('.searchable-select[data-ss-type="product-l1"]');
			if (!container) return;
			const input = container.querySelector(".ss-input");
			const dropdown = container.querySelector(".ss-dropdown");
			const search = container.querySelector(".ss-search");
			const options = container.querySelectorAll(".ss-option");
			const hidden = document.getElementById("l1_category_input");

			input.addEventListener("click", () => {
				dropdown.style.display = dropdown.style.display === "block" ? "none" : "block";
				if (search) search.focus();
			});

			document.addEventListener("click", (e) => {
				if (!container.contains(e.target)) dropdown.style.display = "none";
			});

			if (search) {
				search.addEventListener("input", () => {
					const q = search.value.toLowerCase();
					options.forEach(opt => {
						opt.style.display = opt.textContent.toLowerCase().includes(q) ? "flex" : "none";
					});
				});
			}

			options.forEach(opt => {
				opt.addEventListener("click", () => {
					hidden.value = opt.dataset.value;
					input.value = opt.querySelector("span").textContent;
					dropdown.style.display = "none";
					renderSubCategoriesFromList([opt.dataset.value]);
				});
			});
		}

		function setupPriceMasking() {
			const disp = document.getElementById("product_price_input_display");
			const hdn = document.getElementById("product_price_input");
			if (disp && hdn) {
				disp.addEventListener("input", (e) => {
					const num = e.target.value.replace(/\D/g, "");
					hdn.value = num || "0";
					disp.value = num ? parseInt(num, 10).toLocaleString("id-ID") : "";
				});
			}

			document.querySelectorAll('input[name="variant_name_format"]').forEach(radio => {
				radio.addEventListener("change", updateAllVariantNames);
			});
		}

