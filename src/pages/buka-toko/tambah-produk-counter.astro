			function createCatPill(name, id, isL2, parentId, isCustom = false) {
				const label = document.createElement("label");
				label.className = "cat-pill-label";
				label.title = name;

				// Format Title Case
				const formattedName = name
					.split(" ")
					.map(w => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase())
					.join(" ");

				const cleanVal = isCustom ? name : id;
				label.innerHTML = `
					<input type="checkbox" name="category_ids" value="${cleanVal}" data-id="${id}" data-parent="${parentId}" data-name="${name}" ${isCustom ? 'data-custom="true" checked' : ""} />
					<span class="cat-icon">${isL2 ? "👗" : "✨"}</span>
					<span class="cat-name">${formattedName}</span>
					<span class="check-icon">✓</span>
				`;

				const cb = label.querySelector("input");
				cb.addEventListener("change", () => {
					if (isL2 && cb.checked) {
						l2Row.querySelectorAll("input:checked").forEach(o => {
							if (o !== cb) {
								o.checked = false;
							}
						});
					}
					if (isL2) updateL3Selection();
					updateName();
				});

				return label;
			}

			function updateL3Selection() {
				const checkedL2s = Array.from(l2Row.querySelectorAll("input:checked"));
				l3Grid.innerHTML = "";

				if (checkedL2s.length === 0) {
					l3Area.style.display = "none";
					return;
				}

				let totalL3 = 0;
				checkedL2s.forEach(l2 => {
					const l2Id = l2.getAttribute("data-id");
					const isCustomL2 = l2.dataset.custom === "true";

					if (!isCustomL2) {
						const dbL3s = hierarchicalTypes.filter(t => String(t.parent_id) === String(l2Id));
						dbL3s.forEach(c => {
							totalL3++;
							l3Grid.appendChild(createCatPill(c.name, c.id, false, l2Id, false));
						});
					}
				});

				if (totalL3 === 0) {
					const emptyNote = document.createElement("div");
					emptyNote.style.cssText = "grid-column: 1 / -1; font-size: 0.72rem; color: #94a3b8; padding: 0.4rem 0.2rem; font-style: italic;";
					emptyNote.innerHTML = "Belum ada pilihan detail turunan. Klik <strong>+ Tambah Detail</strong> jika ingin menambahkan spesifikasi baru.";
					l3Grid.appendChild(emptyNote);
				}

				l3Area.style.display = "block";
			}

			// Render existing L2
			l2Children.forEach(c => {
				l2Row.appendChild(createCatPill(c.name, c.id, true, c.parent_id, false));
			});

			// Toggle Add L2
			const toggleL2Btn = container.querySelector("#btn-toggle-add-l2");
			const formL2Row = container.querySelector("#new-l2-form-row");
			const inpL2 = container.querySelector("#new-l2-input");
			const btnL2 = container.querySelector("#add-l2-btn");

			toggleL2Btn?.addEventListener("click", () => {
				formL2Row.style.display = formL2Row.style.display === "flex" ? "none" : "flex";
				if (formL2Row.style.display === "flex") inpL2?.focus();
			});

			const handleL2Add = () => {
				const text = inpL2?.value.trim();
				if (!text) return;
				l2Row.querySelectorAll("input:checked").forEach(o => {
					o.checked = false;
				});
				const rndId = "custom-l2-" + Math.random().toString(36).substr(2, 5);
				const el = createCatPill(text, rndId, true, parentIds[0], true);
				l2Row.appendChild(el);
				inpL2.value = "";
				formL2Row.style.display = "none";
				updateL3Selection();
				updateName();
			};
			btnL2?.addEventListener("click", handleL2Add);
			inpL2?.addEventListener("keypress", (e) => {
				if (e.key === "Enter") { e.preventDefault(); handleL2Add(); }
			});

			// Toggle Add L3
			const toggleL3Btn = container.querySelector("#btn-toggle-add-l3");
			const formL3Row = container.querySelector("#new-l3-form-row");
			const inpL3 = container.querySelector("#new-l3-input");
			const btnL3 = container.querySelector("#add-l3-btn");

			toggleL3Btn?.addEventListener("click", () => {
				formL3Row.style.display = formL3Row.style.display === "flex" ? "none" : "flex";
				if (formL3Row.style.display === "flex") inpL3?.focus();
			});

			const handleL3Add = () => {
				const text = inpL3?.value.trim();
				if (!text) return;
				const activeL2 = l2Row.querySelector("input:checked");
				const parentId = activeL2 ? activeL2.getAttribute("data-id") : null;
				const rndId = "custom-l3-" + Math.random().toString(36).substr(2, 5);
				const el = createCatPill(text, rndId, false, parentId, true);
				// Remove empty note if exists
				const note = l3Grid.querySelector("div[style*='grid-column']");
				if (note) note.remove();
				l3Grid.appendChild(el);
				inpL3.value = "";
				formL3Row.style.display = "none";
				updateName();
			};
			btnL3?.addEventListener("click", handleL3Add);
			inpL3?.addEventListener("keypress", (e) => {
				if (e.key === "Enter") { e.preventDefault(); handleL3Add(); }
			});
		}

		// --- Product Naming Automation Logic ---
		function updateName() {
			const nameInput = document.getElementById("product_name_input");
			if (!nameInput) return;

			// 1. Get L1 context
			const visibleL1 = document.querySelector('[data-ss-type="product-l1"] .ss-input');
			const l1Text = visibleL1 ? visibleL1.value.trim() : "";

			// 2. Get L2 context
			const l2Container = document.getElementById("l2-selection-row");
			let l2Text = "";
			if (l2Container) {
				const checkedL2 = l2Container.querySelector("input:checked");
				if (checkedL2) {
					l2Text = (checkedL2.dataset.name || checkedL2.parentElement.querySelector(".cat-name")?.textContent || checkedL2.parentElement.textContent).replace(/^[^\w]+|[✓✨👗]/g, "").trim();
				}
			}

			// 3. Get L3 context
			const l3Container = document.getElementById("l3-grid");
			const l3Strings = [];
			if (l3Container) {
				const checkedL3s = Array.from(l3Container.querySelectorAll("input:checked"));
				checkedL3s.forEach(c => {
					const txt = (c.dataset.name || c.parentElement.querySelector(".cat-name")?.textContent || c.parentElement.textContent).replace(/^[^\w]+|[✓✨👗]/g, "").trim();
					if (txt) l3Strings.push(txt);
				});
			}

			const selectedCategories = [];
			if (l1Text && l1Text.toLowerCase() !== "root") selectedCategories.push(l1Text);
			if (l2Text) selectedCategories.push(l2Text);
			l3Strings.forEach(s => selectedCategories.push(s));
			const jenis = selectedCategories.join(" ");

			// 4. Get Motifs
			let motifStr = "";
			const motifGrid = document.getElementById("motif-grid");
			if (motifGrid) {
				const checkedMotifs = Array.from(motifGrid.querySelectorAll("input:checked"));
				motifStr = checkedMotifs.map(m => (m.dataset.name || m.parentElement.querySelector(".motif-name")?.textContent || m.parentElement.textContent).replace(/^[^\w]+|[✓✨]/g, "").trim()).join(", ");
			}

			// 5. Get Colors
			let colorStr = "";
			const colorGrid = document.getElementById("color-grid");
			if (colorGrid) {
				const checkedColors = Array.from(colorGrid.querySelectorAll("input:checked"));
				colorStr = checkedColors.map(c => c.value).join(", ");
			}

			// 6. Get Item Code / SKU
			const itemCodeInput = document.getElementById("product_item_code_input");
			const skuInput = document.getElementById("product_sku_input");
			const itemCode = (itemCodeInput?.value || skuInput?.value || "").trim().replace(/[^a-zA-Z0-9_\-\s]/g, '');

			const parts = [];
			if (jenis) parts.push(jenis);
			if (motifStr) parts.push(motifStr);
			if (colorStr) parts.push(colorStr);

			// Kemeja Tanpa Furing check
			if (jenis && jenis.toLowerCase().includes("kemeja")) {
				const dalamanSelects = Array.from(document.querySelectorAll(".v-dalaman-select"));
				if (dalamanSelects.length > 0 && dalamanSelects.some(s => s.value === "TF")) {
					parts.push("Tanpa Furing");
				}
			}

			if (itemCode) parts.push(itemCode);

			if (parts.length > 0) {
				nameInput.value = parts.join(" ");
			}
		}

		function setupCategoryDropdown() {
			const container = document.querySelector('.searchable-select[data-ss-type="product-l1"]');
			if (!container) return;
			const input = container.querySelector(".ss-input");
			const dropdown = container.querySelector(".ss-dropdown");
			const search = container.querySelector(".ss-search");
			const optionsContainer = container.querySelector(".ss-options");
			const hidden = document.getElementById("l1_category_input");

			input.addEventListener("click", () => {
				dropdown.style.display = dropdown.style.display === "block" ? "none" : "block";
				if (search) search.focus();
			});

			document.addEventListener("click", (e) => {
				if (!container.contains(e.target)) dropdown.style.display = "none";
			});

			if (search) {
				search.addEventListener("input", () => {
					const q = search.value.toLowerCase();
					const allOptions = container.querySelectorAll(".ss-option");
					allOptions.forEach(opt => {
						opt.style.display = opt.textContent.toLowerCase().includes(q) ? "flex" : "none";
					});
				});
			}

			if (optionsContainer) {
				optionsContainer.addEventListener("click", (e) => {
					const opt = e.target.closest(".ss-option");
					if (!opt) return;
					const val = opt.dataset.value;
					const text = opt.querySelector("span") ? opt.querySelector("span").textContent : opt.textContent;
					applyL1CategorySelection(val, text);
				});
			}
		}

		function setupPriceMasking() {
			const disp = document.getElementById("product_price_input_display");
			const hdn = document.getElementById("product_price_input");
			if (disp && hdn) {
				disp.addEventListener("input", (e) => {
					const num = e.target.value.replace(/\D/g, "");
					hdn.value = num || "0";
					disp.value = num ? parseInt(num, 10).toLocaleString("id-ID") : "";
				});
			}
		}

		function getCheckedCounterRows() {
			return Array.from(document.querySelectorAll(".counter-table-row")).filter(row => {
				const cb = row.querySelector(".v-counter-cb");
				return cb && cb.checked;
			});
		}

		function updateSelectedCounterBadge() {
			const total = document.querySelectorAll(".counter-table-row").length;
			const checked = getCheckedCounterRows().length;
			const badge = document.getElementById("selectedCounterCountBadge");
			if (badge) {
				badge.textContent = `✓ ${checked} dari ${total} Varian Dipilih`;
				if (checked === 0) {
					badge.style.color = "#dc2626";
					badge.style.background = "#fee2e2";
					badge.style.borderColor = "#fecaca";
				} else {
					badge.style.color = "#16a34a";
					badge.style.background = "#dcfce7";
					badge.style.borderColor = "#bbf7d0";
				}
			}
		}

		function setupBatchControls() {
			// Apply Same Motif to Checked Rows
			document.getElementById("btnApplySameMotif")?.addEventListener("click", () => {
				const selectedMotif = document.getElementById("globalBatchMotifSelect")?.value;
				if (!selectedMotif) return;
				const checkedRows = getCheckedCounterRows();
				if (checkedRows.length === 0) {
					alert("Silakan centang [✓] varian counter yang ingin diubah terlebih dahulu.");
					return;
				}
				checkedRows.forEach(row => {
					const select = row.querySelector(".v-motif-select");
					const hidden = row.querySelector(".v-motif-hidden");
					if (select) {
						select.value = selectedMotif;
						if (hidden) hidden.value = selectedMotif;
						updateRowVariantName(row);
					}
				});
				renderMotifPhotoCards();
			});

			// Apply Same Size to Checked Rows
			document.getElementById("btnApplySameSize")?.addEventListener("click", () => {
				const selectedSize = document.getElementById("globalBatchSizeSelect")?.value;
				if (!selectedSize) return;
				const checkedRows = getCheckedCounterRows();
				if (checkedRows.length === 0) {
					alert("Silakan centang [✓] varian counter yang ingin diubah terlebih dahulu.");
