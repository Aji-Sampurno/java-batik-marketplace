		function renderMotifPhotoCards() {
			const cardsContainer = document.getElementById("motifPhotoCardsContainer");
			if (!cardsContainer) return;
			cardsContainer.innerHTML = "";

			const groupsMap = new Map();
			document.querySelectorAll(".counter-table-row").forEach(row => {
				const isChecked = row.querySelector(".v-counter-cb")?.checked;
				if (!isChecked) return;
				const motifSelect = row.querySelector(".v-motif-select");
				const motifName = motifSelect?.value || "Motif A";
				const sleeveSelect = row.querySelector(".v-sleeve-select");
				const sleeveVal = sleeveSelect?.value || "";
				const sizeSelect = row.querySelector(".v-size-select");
				const sizeVal = sizeSelect?.value || "";
				const counterCode = row.getAttribute("data-counter") || "CTR";
				const outletName = row.getAttribute("data-outlet") || "";

				const key = getRowPhotoGroupKey(row);
				let sleeveLabel = "";
				if (sleeveVal && sleeveVal !== "-") {
					sleeveLabel = sleeveVal.toLowerCase().includes("lengan") ? sleeveVal : `Lengan ${sleeveVal}`;
				}

				if (!groupsMap.has(key)) {
					groupsMap.set(key, {
						key: key,
						motifName: motifName,
						sleeve: sleeveVal,
						sleeveLabel: sleeveLabel,
						counters: []
					});
				}
				const sizeText = sizeVal ? ` (${sizeVal})` : '';
				groupsMap.get(key).counters.push(`${counterCode}${sizeText} [${outletName}]`);
			});

			if (groupsMap.size === 0) {
				cardsContainer.innerHTML = `<div style="font-size: 0.75rem; color: #94a3b8; font-style: italic; padding: 0.5rem 0;">Belum ada counter yang dipilih.</div>`;
				return;
			}

			// Set default active target motif/key if not set
			if (!activeTargetMotif || !groupsMap.has(activeTargetMotif)) {
				activeTargetMotif = groupsMap.keys().next().value || null;
			}

			groupsMap.forEach((groupData, key) => {
				const motifName = groupData.motifName;
				const sleeveLabel = groupData.sleeveLabel;
				const counters = groupData.counters;

				const currentStore = motifPhotoStore.get(key) || motifPhotoStore.get(motifName) || { file: null, previewUrl: "", isCustom: false };
