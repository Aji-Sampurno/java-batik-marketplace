		function getMotifLetter(index) {
			let letter = "";
			let temp = index;
			while (temp >= 0) {
				letter = String.fromCharCode(65 + (temp % 26)) + letter;
				temp = Math.floor(temp / 26) - 1;
			}
			return `Motif ${letter}`;
		}

		const logoImgPreload = new Image();
		logoImgPreload.crossOrigin = "anonymous";
		logoImgPreload.src = "/images/java_batik_gold.png";

		function createWatermarkedDataUrl(file, callback) {
			if (!file) return;

			// Gunakan Blob URL agar tidak ada batasan ukuran base64 di browser (Safari/Chrome)
			const srcBlobUrl = URL.createObjectURL(file);
			const img = new Image();

			img.onerror = () => {
				console.warn("Gagal membaca file gambar, menggunakan URL langsung");
				callback(srcBlobUrl, file);
			};

			img.onload = () => {
				try {
					// Batasi resolusi maksimum ke 1200px agar pemrosesan cepat & hemat bandwidth
					const maxDim = 1200;
					let w = img.naturalWidth || img.width || 800;
					let h = img.naturalHeight || img.height || 800;

					if (w > maxDim || h > maxDim) {
						if (w > h) {
							h = Math.round((h * maxDim) / w);
							w = maxDim;
						} else {
							w = Math.round((w * maxDim) / h);
							h = maxDim;
						}
					}

					// 1. Canvas Bersih untuk File Upload ke Server (100% Mentah / Murni Tanpa Watermark)
					const cleanCanvas = document.createElement("canvas");
					cleanCanvas.width = w;
					cleanCanvas.height = h;
					const cleanCtx = cleanCanvas.getContext("2d");

					if (!cleanCtx) {
						callback(srcBlobUrl, file);
						return;
					}

					// Gambar foto asli mentah
					cleanCtx.drawImage(img, 0, 0, w, h);

					// 2. Canvas Pratinjau (Preview) untuk Tampilan UI di Layar Admin
					const previewCanvas = document.createElement("canvas");
					previewCanvas.width = w;
					previewCanvas.height = h;
					const previewCtx = previewCanvas.getContext("2d");
					if (previewCtx) {
						previewCtx.drawImage(cleanCanvas, 0, 0);

						// Gambar logo watermark untuk preview di layar
						if (logoImgPreload && logoImgPreload.complete && logoImgPreload.naturalWidth > 0) {
							try {
								const logoMargin = Math.round(w * 0.04);
								const logoW = Math.round(w * 0.18);
								const logoH = logoImgPreload.naturalHeight * (logoW / logoImgPreload.naturalWidth);
								previewCtx.imageSmoothingEnabled = true;
								previewCtx.imageSmoothingQuality = "high";
								previewCtx.drawImage(logoImgPreload, w - logoW - logoMargin, logoMargin, logoW, logoH);
							} catch(errLogo) {
								console.warn("Logo watermark preview dilewati:", errLogo);
							}
						}

						// Gambar teks kode untuk preview di layar
						const itemCodeInput = document.getElementById("product_item_code_input");
						const skuInput = document.getElementById("product_sku_input");
						let codeTxt = (itemCodeInput && "value" in itemCodeInput ? String(itemCodeInput.value) : (skuInput && "value" in skuInput ? String(skuInput.value) : "")).trim().replace(/[^a-zA-Z0-9_\-\s]/g, '');

						if (codeTxt) {
							const fontSize = Math.max(Math.round(h * 0.024), 14);
							const textMarginRight = Math.round(w * 0.04);
							const textY = h - Math.round(h * 0.05);
							previewCtx.font = `bold ${fontSize}px sans-serif`;
							previewCtx.textAlign = "right";
							previewCtx.textBaseline = "alphabetic";

							// Bayangan teks
							previewCtx.fillStyle = "black";
							previewCtx.fillText(codeTxt, w - textMarginRight + 2, textY + 2);
							// Teks putih
							previewCtx.fillStyle = "white";
							previewCtx.fillText(codeTxt, w - textMarginRight, textY);
						}
					}

					// Eksekusi pembuatan file WebP bersih untuk Server dan Blob URL untuk UI
					if (cleanCanvas.toBlob) {
						cleanCanvas.toBlob((cleanBlob) => {
							const cleanName = (file.name || "motif.jpg").replace(/\.[^/.]+$/, "") + ".webp";
							const cleanRawFile = cleanBlob ? new File([cleanBlob], cleanName, { type: "image/webp" }) : file;

							if (previewCanvas.toBlob) {
								previewCanvas.toBlob((prevBlob) => {
									const previewUrl = prevBlob ? URL.createObjectURL(prevBlob) : (cleanBlob ? URL.createObjectURL(cleanBlob) : srcBlobUrl);
									callback(previewUrl, cleanRawFile);
								}, "image/webp", 0.88);
							} else {
								const previewUrl = cleanBlob ? URL.createObjectURL(cleanBlob) : srcBlobUrl;
								callback(previewUrl, cleanRawFile);
							}
						}, "image/webp", 0.90);
					} else {
						callback(srcBlobUrl, file);
					}
				} catch(err) {
					console.warn("Kesalahan proses canvas:", err);
					callback(srcBlobUrl, file);
				}
			};

			img.src = srcBlobUrl;
		}

