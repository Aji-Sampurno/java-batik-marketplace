---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import { apiFetch, uploadToLaravel } from "../../lib/api";
import sharp from "sharp";
import fs from "node:fs";

// Check for session (Authentication Gate)
const session = Astro.cookies.get("admin_session");
if (session?.value !== "authenticated") {
	return Astro.redirect("/login");
}

// Handle Logout & Search
const { searchParams } = Astro.url;
if (searchParams.get("logout")) {
	Astro.cookies.delete("admin_session", { path: "/" });
	return Astro.redirect("/login");
}
const adminSearchQuery = searchParams.get("q");
const publicApiUrl = import.meta.env.PUBLIC_API_URL || "https://java.batik.katalog.gooproper.id/api";

// Fetch Types and Motifs for the dropdowns
let types: any[] = [];
let motifs: any[] = [];
let sizesData: any[] = [];
let colorsData: any[] = [];
let settings: any = null;

try {
	const tRes = await apiFetch<any>("types");
	types = tRes?.data || tRes || [];

	const mRes = await apiFetch<any>("motifs");
	motifs = mRes?.data || mRes || [];

	const szRes = await apiFetch<any>("sizes");
	sizesData = (szRes?.data || szRes || []).filter((s: any) => {
		const name = (s.name || "").trim().toUpperCase();
		return !name.endsWith(" SF") && !name.includes("LENGAN");
	});

	const colRes = await apiFetch<any>("colors");
	colorsData = colRes?.data || colRes || [];

	// Sort sizes
	const sizeOrder = [
		"ALL SIZE", "XS", "S", "M", "L", "XL", "XXL", "2XL", "3XL", "4XL", "5XL", "6XL"
	];
	sizesData.sort((a, b) => {
		const nameA = (a.name || "").trim().toUpperCase();
		const nameB = (b.name || "").trim().toUpperCase();
		let idxA = sizeOrder.indexOf(nameA);
		let idxB = sizeOrder.indexOf(nameB);
		if (idxA === -1) idxA = 999;
		if (idxB === -1) idxB = 999;
		return idxA - idxB;
	});

	const sRes = await apiFetch<any>("settings");
	settings = sRes?.data || sRes || { site_name: "Batik Nusantara" };
} catch (e: any) {
	console.error("API Fetch Error:", e.message);
}

// Hierarchical Helper: Sort categories into a flat list with levels
const buildCategoryTree = (list: any[], parentId = null, depth = 0): any[] => {
	let result: any[] = [];
	list.filter((item) => item.parent_id === parentId).forEach((item) => {
		result.push({ ...item, depth });
		const children = buildCategoryTree(list, item.id, depth + 1);
		result = result.concat(children);
	});
	return result;
};

const hierarchicalTypes = buildCategoryTree(types);

let message = "";
let isError = false;

// Handle Form Submission (Server Side)
if (Astro.request.method === "POST") {
	const contentType = Astro.request.headers.get("content-type");
	if (contentType?.includes("form")) {
		try {
			const formData = await Astro.request.formData();
			const action = formData.get("action");

			if (action === "add_motif") {
				const name = formData.get("name");
				await apiFetch("motifs", {
					method: "POST",
					body: JSON.stringify({ name }),
				});
				return Astro.redirect("/buka-toko/tambah-produk-counter?success=motif");
			}

			if (action === "add_product") {
				const name = formData.get("name");
				const price = formData.get("price");
				const category_ids = formData.getAll("category_ids");
				const category_chain = formData.getAll("category_chain");
				const type_id = category_ids[0] || null;
				const motif_ids = formData.getAll("motif_ids");
				const colors = formData.getAll("colors");
				const description = formData.get("description");
				const code = formData.get("code");
				const tokopedia_url = formData.get("tokopedia_url");
				const original_price = formData.get("original_price");
				const item_code = formData.get("item_code");

				// Variant Arrays
				const variant_motif_names = formData.getAll("variant_motif_name") as string[];
				const variant_image_files = formData.getAll("variant_image_file") as File[];
				const variant_image_urls = formData.getAll("variant_image_url") as string[];
				const variant_sizes = formData.getAll("variant_size") as string[];
				const variant_skus = formData.getAll("variant_sku") as string[];
				const variant_prices = formData.getAll("variant_price") as string[];
				const variant_stocks = formData.getAll("variant_stock") as string[];
				const variant_dalamans = formData.getAll("variant_dalaman") as string[];

				const selectedType = hierarchicalTypes.find((t: any) => t.id === type_id);
				let folderPath = "products";
				if (selectedType) {
					const slug = selectedType.name
						.toLowerCase()
						.replace(/[^a-z0-9]+/g, "-")
						.replace(/(^-|-$)+/g, "");
					folderPath = `products/${slug}`;
				}

				// Fetch logo buffer once if needed
				let logoBuffer: Buffer | null = null;
				let fontBase64 = "";
				try {
					logoBuffer = fs.readFileSync(process.cwd() + "/public/images/java_batik_gold.png");
					const fontBuffer = fs.readFileSync(process.cwd() + "/public/fonts/Roboto-Bold.ttf");
					fontBase64 = fontBuffer.toString("base64");
				} catch (e) {
					console.error("Failed to load assets for watermark", e);
				}

				// -------------------------------------------------------------
				// DEDUPLICATE IMAGES BY MOTIF (Jika motif sama -> 1 gambar saja)
				// -------------------------------------------------------------
				const motifImagesMap = new Map<string, { file: File | null, existingUrl: string }>();

				variant_motif_names.forEach((motif, idx) => {
					const file = variant_image_files[idx];
					const existingUrl = variant_image_urls[idx] || "";
					const cleanMotif = (motif || `Motif-${idx}`).trim();

					if (!motifImagesMap.has(cleanMotif)) {
						motifImagesMap.set(cleanMotif, {
							file: (file && file.size > 0) ? file : null,
							existingUrl
						});
					} else {
						const current = motifImagesMap.get(cleanMotif)!;
						if (!current.file && file && file.size > 0) {
							motifImagesMap.set(cleanMotif, { file, existingUrl: current.existingUrl || existingUrl });
						}
					}
				});

				let images: string[] = [];
				let raw_images: string[] = [];
				let motifIdx = 0;
				const motifFinalUrlMap = new Map<string, string>();

				for (const [motifKey, imgData] of motifImagesMap.entries()) {
					motifIdx++;
					let finalMotifUrl = "";

					if (imgData.file && imgData.file.size > 0) {
						const file = imgData.file;
						const actualCode = (item_code || code || "PRODUK").toString().trim().replace(/[^a-zA-Z0-9]/g, '');
						const cleanMotifTag = `_${motifKey.toUpperCase().replace(/[^A-Z0-9]/g, '')}`;
						const timestamp = Date.now();
						const originalExt = file.name.split('.').pop() || 'jpg';

						// 1. Upload Raw Original Image
						const rawCustomName = `${actualCode}${cleanMotifTag}_raw_${timestamp}_${motifIdx}.${originalExt}`;
						const rawFileToUpload = new File([await file.arrayBuffer()], rawCustomName, { type: file.type });
						const rawPublicUrl = await uploadToLaravel(rawFileToUpload, folderPath).catch(e => {
							console.error("Raw original image upload error:", e);
							return "";
						});
						if (rawPublicUrl) {
							raw_images.push(rawPublicUrl);
						}

						// 2. Process Watermarked & WebP Compressed Image
						let webpBuffer: Buffer;
						try {
							const imgBuffer = Buffer.from(await file.arrayBuffer());
							const imgSharp = sharp(imgBuffer);
							const metadata = await imgSharp.metadata();
							const width = metadata.width || 1000;
							const height = metadata.height || 1000;

							const compositeArr: any[] = [];

							if (logoBuffer) {
								const logoWidth = Math.round(width * 0.18);
								const resizedLogo = await sharp(logoBuffer)
									.resize({ width: logoWidth, withoutEnlargement: true })
									.toBuffer();
								const resizedMeta = await sharp(resizedLogo).metadata();
								const actualLogoW = resizedMeta.width || logoWidth;
								const logoMargin = Math.round(width * 0.04);

								compositeArr.push({
									input: resizedLogo,
									top: logoMargin,
									left: width - actualLogoW - logoMargin,
									blend: "over",
								});
							}

							const textCode = (item_code || code || "")
								.toString()
								.replace(/[\r\n\t\f\v\u00A0\uFEFF]/g, '')
								.replace(/[^a-zA-Z0-9_\-\s]/g, '')
								.trim();
							if (textCode) {
								const fontSize = Math.max(Math.round(height * 0.022), 12);
								const textMarginRight = Math.round(width * 0.04);
								const textY = height - Math.round(height * 0.05);
								const svgText = `
									<svg width="${width}" height="${height}">
										<style>
											@font-face {
												font-family: 'Roboto';
												src: url('data:font/ttf;base64,${fontBase64}');
											}
											.title { fill: white; font-size: ${fontSize}px; font-weight: bold; font-family: 'Roboto', sans-serif; }
											.shadow { fill: black; font-size: ${fontSize}px; font-weight: bold; font-family: 'Roboto', sans-serif; }
										</style>
										<text x="${width - textMarginRight + 2}" y="${textY + 2}" text-anchor="end" class="shadow">${textCode}</text>
										<text x="${width - textMarginRight}" y="${textY}" text-anchor="end" class="title">${textCode}</text>
									</svg>
								`;
								compositeArr.push({
									input: Buffer.from(svgText),
									top: 0,
									left: 0,
								});
							}

							if (compositeArr.length > 0) {
								webpBuffer = await imgSharp
									.composite(compositeArr)
									.webp({ quality: 80 })
									.toBuffer();
							} else {
								webpBuffer = await imgSharp
									.webp({ quality: 80 })
									.toBuffer();
							}
						} catch (e) {
							console.error("Sharp WebP & Watermark error:", e);
							webpBuffer = Buffer.from(await file.arrayBuffer());
						}

						const webpCustomName = `${actualCode}${cleanMotifTag}_${timestamp}_${motifIdx}.webp`;
						const webpFileToUpload = new File([new Uint8Array(webpBuffer)], webpCustomName, { type: "image/webp" });

						const publicUrl = await uploadToLaravel(webpFileToUpload, folderPath);
						if (publicUrl) {
							images.push(publicUrl);
							finalMotifUrl = publicUrl;
						}
					} else if (imgData.existingUrl) {
						images.push(imgData.existingUrl);
						finalMotifUrl = imgData.existingUrl;
					}

					if (finalMotifUrl) {
						motifFinalUrlMap.set(motifKey, finalMotifUrl);
					}
				}

				// Final deduplication & primary image
				images = [...new Set(images.filter(Boolean))];
				raw_images = [...new Set(raw_images.filter(Boolean))];
				const image_url = images[0] || "";
				const raw_image_url = raw_images[0] || "";

				// -------------------------------------------------------------
				// UPDATE AI_FOTO KE NOIR API (PUT /v1/beli1/{id}/ai-foto)
				// -------------------------------------------------------------
				const variant_praproduk_ids = formData.getAll("variant_praproduk_id") as string[];
				const main_praproduk_id = formData.get("main_praproduk_id") as string;
				const NOIR_API_BASE = "https://noir.grace.gracianna.web.id/api/v1";

				// 1. Update AI_foto untuk setiap counter detail berdasarkan motifnya
				for (let i = 0; i < variant_praproduk_ids.length; i++) {
					const detailId = variant_praproduk_ids[i];
					const motifName = (variant_motif_names[i] || `Motif-${i}`).trim();
					const photoUrlForMotif = motifFinalUrlMap.get(motifName) || image_url;

					if (detailId && photoUrlForMotif) {
						try {
							await fetch(`${NOIR_API_BASE}/beli1/${detailId}/ai-foto`, {
								method: "PUT",
								headers: {
									"Content-Type": "application/json",
									"Accept": "application/json"
								},
								body: JSON.stringify({
									AI_foto: photoUrlForMotif
								})
							});
							console.log(`[Noir API] PUT /beli1/${detailId}/ai-foto (${motifName}) -> ${photoUrlForMotif}`);
						} catch (err) {
							console.error(`[Noir API] Gagal update AI_foto detail #${detailId}:`, err);
						}
					}
				}

				// 2. Update AI_foto untuk parent pra-produk utama
				if (main_praproduk_id && image_url) {
					try {
						await fetch(`${NOIR_API_BASE}/beli1/${main_praproduk_id}/ai-foto`, {
							method: "PUT",
							headers: {
								"Content-Type": "application/json",
								"Accept": "application/json"
							},
							body: JSON.stringify({
								AI_foto: image_url
							})
						});
						console.log(`[Noir API] PUT /beli1/${main_praproduk_id}/ai-foto (Main Parent) -> ${image_url}`);
					} catch (err) {
						console.error(`[Noir API] Gagal update AI_foto parent #${main_praproduk_id}:`, err);
					}
				}

				// Build variants array from Counter schema
				const variants = variant_sizes.map((size, index) => ({
					size_name: size,
					sku: variant_skus[index] || null,
					price: parseFloat(variant_prices[index] || price?.toString() || "0"),
					stock: parseInt(variant_stocks[index] || "0", 10),
					dalaman: variant_dalamans[index] || null,
				}));

				console.log("DEBUG POST Counter variants payload:", JSON.stringify(variants, null, 2));
				console.log("DEBUG POST Deduplicated images:", JSON.stringify(images, null, 2));

				await apiFetch("products", {
					method: "POST",
					body: JSON.stringify({
						name,
						price,
						type_id,
						category_ids,
						category_chain,
						motif_ids,
						colors,
						description,
						code,
						original_price,
						item_code,
						image_url,
						images,
						raw_image_url,
						raw_images,
						tokopedia_url,
						variants,
						is_active: true,
					}),
				});

				return Astro.redirect("/buka-toko?success=product");
			}
		} catch (e: any) {
			isError = true;
			message = "Gagal menyimpan produk: " + e.message;
		}
	}
}

const success = Astro.url.searchParams.get("success");
if (success === "motif") message = "Motif baru berhasil ditambahkan!";
---

<Layout title={`Tambah Produk (Skema Counter) - ${settings?.site_name || "Batik Nusantara"}`}>
	<section style="padding: 130px 0 var(--spacing-2xl) 0; background: #f8fafc; min-height: 100vh;">
		<div class="container" style="max-width: 1100px;">
			<!-- Header -->
			<div style="margin-bottom: var(--spacing-xl); display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem;">
				<div>
					<div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;">
						<h1 style="font-family: var(--font-serif); font-size: 2.2rem; margin: 0; font-weight: 400; color: #0f172a;">
							Tambah Produk <span style="font-style: italic; color: #b45309;">Skema Counter</span>
						</h1>
						<span style="background: #fef3c7; color: #92400e; font-size: 0.7rem; font-weight: 800; padding: 0.25rem 0.75rem; border-radius: 20px; border: 1px solid #fde68a;">
							Foto per Counter & Motif Sinkron
						</span>
					</div>
					<p style="color: #64748b; margin-top: 0.5rem; font-size: 0.9rem;">
						Kelola foto langsung per motif/counter. Jika beberapa counter memiliki motif yang sama, sistem otomatis memakai 1 foto yang sama.
					</p>
				</div>

				<a
					href="/buka-toko/pra-produk-counter"
					style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px; font-weight: 600; text-decoration: none; padding: 0.6rem 1.2rem; border: 1px solid #cbd5e1; border-radius: var(--radius-sm); color: #1e293b; background: white; transition: 0.2s; box-shadow: 0 1px 2px rgba(0,0,0,0.05);"
					onmouseover="this.style.background='#f1f5f9'; this.style.borderColor='#94a3b8';"
					onmouseout="this.style.background='white'; this.style.borderColor='#cbd5e1';"
				>
					&larr; Kembali ke Pra-Produk
				</a>
			</div>

			{message && (
				<div class="animate-fade-in" style={`padding: 1rem; margin-bottom: 2rem; border-radius: var(--radius-sm); border: 1px solid ${isError ? "#ff4d4d" : "#03ac0e"}; background: ${isError ? "#fff5f5" : "#f5fff5"}; color: ${isError ? "#ff4d4d" : "#03ac0e"}; text-align: center; font-size: 0.9rem; font-weight: 500;`}>
					{message}
				</div>
			)}

			<!-- Main Product Form Container -->
			<div style="background: white; border: 1px solid #e2e8f0; padding: var(--spacing-lg); border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -2px rgba(0,0,0,0.05);">
				<h2 style="font-size: 1rem; margin-bottom: var(--spacing-lg); font-weight: 700; color: #1e293b;" class="text-uppercase">
					Form Input Produk (Skema Counter)
				</h2>

				<form method="POST" enctype="multipart/form-data" id="counterProductForm" style="display: flex; flex-direction: column; gap: var(--spacing-md);">
					<input type="hidden" id="setting_logo_url" value={settings?.logo_url || ""} />
					<input type="hidden" name="action" value="add_product" />
					<input type="hidden" name="from_praproduk" id="from_praproduk_input" value="true" />
					<input type="hidden" name="main_praproduk_id" id="main_praproduk_id_input" value="" />

					<!-- Main Inputs -->
					<div style="display: flex; flex-direction: column; gap: var(--spacing-md); width: 100%;">
						<div>
							<label class="text-uppercase" style="font-size: 0.65rem; font-weight: 700; color: #64748b; display: block; margin-bottom: 0.3rem;">Nama Produk</label>
							<input name="name" id="product_name_input" type="text" required placeholder="Contoh: Rok Klok TP Furing J780" style="width: 100%; padding: 0.7rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
						</div>

						<div>
							<label class="text-uppercase" style="font-size: 0.65rem; font-weight: 700; color: #64748b; display: block; margin-bottom: 0.3rem;">Kode SKU / Counter Utama</label>
							<input name="code" id="product_sku_input" type="text" placeholder="01930798" style="width: 100%; padding: 0.7rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
						</div>

						<div>
							<label class="text-uppercase" style="font-size: 0.65rem; font-weight: 700; color: #64748b; display: block; margin-bottom: 0.3rem;">Kode Barang (Auto-Name)</label>
							<input name="item_code" id="product_item_code_input" type="text" placeholder="J780" style="width: 100%; padding: 0.7rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
						</div>

						<div>
							<label class="text-uppercase" style="font-size: 0.65rem; font-weight: 700; color: #64748b; display: block; margin-bottom: 0.3rem;">Harga Utama (Rp)</label>
							<input type="text" class="currency-mask" data-hidden-id="product_price_input" required id="product_price_input_display" placeholder="450.000" style="width: 100%; padding: 0.7rem; border: 1px solid #cbd5e1; border-radius: 6px;" />
							<input type="hidden" name="price" id="product_price_input" />
							<div id="price_markup_preview" style="font-size: 0.65rem; color: #10b981; margin-top: 0.4rem; font-weight: 600; display: none;">
								Harga Coret: Rp <span id="markup_val">0</span> (Hemat Rp <span id="markup_pct">0</span>)
							</div>
							<input type="hidden" name="original_price" id="original_price_input" />
						</div>
					</div>

					<!-- Categories Section -->
					<div>
						<div id="category-chain-container" style="display:none;"></div>
						<label class="text-uppercase" style="font-size: 0.65rem; font-weight: 700; color: #64748b; display: block; margin-bottom: 0.3rem;">Kategori Produk (L1)</label>
						<div class="searchable-select" data-ss-type="product-l1">
							<input type="hidden" name="category_ids" id="l1_category_input" />
							<input type="text" class="ss-input" placeholder="Cari & Pilih Kategori Utama..." readonly style="background: #ffffff; border: 1px solid #cbd5e1; border-radius: 6px;" />
							<div class="ss-dropdown">
								<div class="ss-search-container">
									<svg class="ss-search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><path d="M21 21l-4.35-4.35"></path></svg>
									<input type="text" class="ss-search" placeholder="Cari kategori..." />
								</div>
								<div class="ss-options">
									{hierarchicalTypes.filter((t: any) => t.parent_id === null).map((t: any) => (
										<div class="ss-option" data-value={t.id}>
											<span>{t.name}</span>
											<span class="lvl-badge lvl-1">Root</span>
										</div>
									))}
								</div>
							</div>
						</div>
						<div id="sub-category-checkboxes" class="cascading-container"></div>
					</div>

					<!-- Motif Global Section (Multi-Select) -->
					<div>
						<label class="text-uppercase" style="font-size: 0.65rem; font-weight: 700; color: #64748b; display: block; margin-bottom: 0.3rem;">Motif Global (Multi-select)</label>
						<div class="motif-style-container" id="motif-grid">
							{motifs?.map((m: any) => (
								<label class="motif-style-label">
									<input type="checkbox" name="motif_ids" value={m.id} data-name={m.name} />
									{m.name}
								</label>
							))}
						</div>
						<div class="custom-entry-row" style="margin-top: 8px; display: flex; gap: 8px;">
							<input type="text" id="new-motif-input" placeholder="Motif Baru..." style="flex: 1; font-size: 0.75rem; padding: 6px 10px; border: 1px dashed #cbd5e1; border-radius: 6px;" />
							<button type="button" id="add-motif-btn" style="font-size: 0.7rem; background: var(--color-dark); color: #fff; border: none; padding: 0 12px; border-radius: 6px; cursor: pointer; font-weight: 600;">+ TAMBAH</button>
						</div>
					</div>

					<!-- Warna Section -->
					<div>
						<label class="text-uppercase" style="font-size: 0.65rem; font-weight: 700; color: #64748b; display: block; margin-bottom: 0.3rem;">Warna Utama (Multi-select)</label>
						<div class="motif-style-container" id="color-grid">
							{colorsData?.map((c: any) => (
								<label class="motif-style-label" style="gap: 0.5rem !important;">
									<input type="checkbox" name="colors" value={c.name} />
