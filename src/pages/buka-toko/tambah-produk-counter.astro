				const cb = row.querySelector(".v-counter-cb");
				const sizeHidden = row.querySelector(".v-size-hidden");
				const skuHidden = row.querySelector(".v-sku-hidden");
				const sizeSelect = row.querySelector(".v-size-select");
				const priceDisp = row.querySelector(".v-price-display");
				const priceHidden = row.querySelector(".v-price-hidden");
				const stockInput = row.querySelector(".v-stock-input");
				const dalamanSelect = row.querySelector(".v-dalaman-select");
				const motifSelect = row.querySelector(".v-motif-select");
				const motifHidden = row.querySelector(".v-motif-hidden");
				const deleteBtn = row.querySelector(".btn-delete-row");

				// Photo upload per row
				const thumbBox = row.querySelector(".v-thumb-box");
				const overlay = row.querySelector(".v-upload-overlay");
				const fileInp = row.querySelector(".v-row-file-input");
				const triggerBtn = row.querySelector(".btn-trigger-upload");

				if (thumbBox && overlay && fileInp) {
					thumbBox.addEventListener("mouseenter", () => overlay.style.opacity = "1");
					thumbBox.addEventListener("mouseleave", () => overlay.style.opacity = "0");
					thumbBox.addEventListener("click", () => fileInp.click());
					if (triggerBtn) triggerBtn.addEventListener("click", () => fileInp.click());

					fileInp.addEventListener("change", () => {
						if (fileInp.files && fileInp.files[0]) {
							const file = fileInp.files[0];
							const currentMotif = motifSelect?.value || "Motif A";
							const reader = new FileReader();
							reader.onload = (e) => {
								syncPhotosForMotif(currentMotif, e.target.result, file);
							};
							reader.readAsDataURL(file);
						}
					});
				}

				cb.addEventListener("change", () => {
					const active = cb.checked;
					row.style.opacity = active ? "1" : "0.35";
					sizeHidden.disabled = !active;
					skuHidden.disabled = !active;
					sizeSelect.disabled = !active;
					priceDisp.disabled = !active;
					priceHidden.disabled = !active;
					stockInput.disabled = !active;
					dalamanSelect.disabled = !active;
					motifSelect.disabled = !active;
					motifHidden.disabled = !active;
					if (fileInp) fileInp.disabled = !active;
				});

				motifSelect.addEventListener("change", () => {
					motifHidden.value = motifSelect.value;
					updateRowVariantName(row);
					renderMotifPhotoCards();
				});

				sizeSelect.addEventListener("change", () => updateRowVariantName(row));

				priceDisp.addEventListener("input", (e) => {
					const num = e.target.value.replace(/\D/g, "");
					priceHidden.value = num || "0";
					priceDisp.value = num ? parseInt(num, 10).toLocaleString("id-ID") : "";
				});

				deleteBtn.addEventListener("click", () => {
					row.remove();
					renderMotifPhotoCards();
				});
			});
		}

		function setupMotifEngine() {
			const btn = document.getElementById("add-motif-btn");
			const input = document.getElementById("new-motif-input");
			const grid = document.getElementById("motif-grid");

			if (btn && input && grid) {
				btn.addEventListener("click", async () => {
					const val = input.value.trim();
					if (!val) return;
					btn.disabled = true;

					try {
						const res = await fetch(`${publicApiUrl}/motifs`, {
							method: "POST",
							headers: { "Content-Type": "application/json", "Accept": "application/json" },
							body: JSON.stringify({ name: val })
						});
						const json = await res.json();
						const newMotif = json.data || json;

						if (newMotif && newMotif.id) {
							const lbl = document.createElement("label");
							lbl.className = "motif-style-label";
							lbl.innerHTML = `<input type="checkbox" name="motif_ids" value="${newMotif.id}" data-name="${newMotif.name}" checked /> ${newMotif.name}`;
							grid.appendChild(lbl);
							input.value = "";

							motifsMasterList.push(newMotif.name);

							// Update all row select options and global batch select
							const globalBatch = document.getElementById("globalBatchMotifSelect");
							if (globalBatch) {
								const opt = document.createElement("option");
								opt.value = newMotif.name;
								opt.textContent = newMotif.name;
								globalBatch.appendChild(opt);
							}

							document.querySelectorAll(".v-motif-select").forEach(sel => {
								const opt = document.createElement("option");
								opt.value = newMotif.name;
								opt.textContent = newMotif.name;
								sel.appendChild(opt);
							});

							renderMotifPhotoCards();
						}
					} catch (e) {
						console.error("Add motif fail:", e);
					} finally {
						btn.disabled = false;
					}
				});
			}
		}

		function setupDescGenerator() {
			const btn = document.getElementById("btn_generate_desc");
			const descInput = document.getElementById("description_input");
			const nameInput = document.getElementById("product_name_input");

			if (btn && descInput) {
				btn.addEventListener("click", async () => {
					const title = nameInput?.value.trim();
					if (!title) {
						alert("Silakan isi nama produk terlebih dahulu.");
						return;
					}
					btn.disabled = true;
					btn.innerHTML = "<span>✨ Menulis...</span>";

					try {
						const res = await fetch(`${publicApiUrl}/generate-description`, {
							method: "POST",
							headers: { "Content-Type": "application/json", "Accept": "application/json" },
							body: JSON.stringify({ name: title })
						});
						const json = await res.json();
						if (json && json.description) {
							descInput.value = json.description;
						} else {
							descInput.value = `Koleksi istimewa ${title}. Dibuat dari material berkualitas tinggi dengan pengerjaan batik yang teliti dan furing yang nyaman dipakai. Cocok untuk acara formal maupun kasual.`;
						}
					} catch (e) {
						descInput.value = `Koleksi eksklusif ${title}. Desain motif batik tradisional elegan dengan potongan modern yang nyaman dan pas di tubuh.`;
					} finally {
						btn.disabled = false;
						btn.innerHTML = "<span>✨ Tulis dengan Gemini</span>";
					}
				});
			}
		}
	</script>
</Layout>
