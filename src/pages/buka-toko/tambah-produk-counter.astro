			// Select All / Deselect All Buttons
			document.getElementById("btnSelectAllCounters")?.addEventListener("click", () => {
				document.querySelectorAll(".v-counter-cb").forEach(cb => {
					if (!cb.checked) { cb.checked = true; cb.dispatchEvent(new Event("change")); }
				});
				updateSelectedCounterBadge();
			});

			document.getElementById("btnUnselectAllCounters")?.addEventListener("click", () => {
				document.querySelectorAll(".v-counter-cb").forEach(cb => {
					if (cb.checked) { cb.checked = false; cb.dispatchEvent(new Event("change")); }
				});
				updateSelectedCounterBadge();
			});

			// Apply Price to Checked Rows
			document.getElementById("btnBatchPrice")?.addEventListener("click", () => {
				const checkedRows = getCheckedCounterRows();
				if (checkedRows.length === 0) {
					alert("Silakan centang [✓] varian counter yang ingin diatur harganya terlebih dahulu.");
					return;
				}
				const mainPrice = document.getElementById("product_price_input")?.value;
				const promptVal = prompt(`Masukkan harga jual (Rp) untuk ${checkedRows.length} varian yang dicentang [✓]:`, mainPrice || "");
				if (promptVal !== null) {
					const num = parseInt(promptVal.replace(/\D/g, ""), 10) || 0;
					checkedRows.forEach(row => {
						const disp = row.querySelector(".v-price-display");
						const hdn = row.querySelector(".v-price-hidden");
						if (hdn) hdn.value = num;
						if (disp) disp.value = num ? num.toLocaleString("id-ID") : "";
					});
				}
