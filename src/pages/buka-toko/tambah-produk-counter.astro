				const overlay = card.querySelector(".m-thumb-overlay");

				if (thumb && overlay) {
					thumb.addEventListener("mouseenter", () => overlay.style.opacity = "1");
					thumb.addEventListener("mouseleave", () => overlay.style.opacity = "0");
				}

				viewZoomBtn?.addEventListener("click", () => showFullscreenImageModal(currentStore.previewUrl));

				if (fileInp && uploadBtn && thumb) {
					uploadBtn.addEventListener("click", () => {
						setCardActive();
						fileInp.click();
					});
					thumb.addEventListener("click", () => {
						if (currentStore.previewUrl) {
							showFullscreenImageModal(currentStore.previewUrl);
						} else {
							setCardActive();
							fileInp.click();
						}
					});

					fileInp.addEventListener("change", () => {
						if (fileInp.files && fileInp.files[0]) {
							const file = fileInp.files[0];
							if (typeof window.openImageCropper === 'function') {
								window.openImageCropper([file], (croppedFiles) => {
									if (!croppedFiles || croppedFiles.length === 0) {
										fileInp.value = "";
										return;
									}
									const targetFile = croppedFiles[0];
									uploadBtn.innerHTML = "⏳ Memproses...";
									uploadBtn.disabled = true;
									createWatermarkedDataUrl(targetFile, (watermarkedUrl, processedFile) => {
										syncPhotosForGroup(key, watermarkedUrl || "", processedFile || targetFile);
									});
								});
							} else {
								uploadBtn.innerHTML = "⏳ Memproses...";
								uploadBtn.disabled = true;
								createWatermarkedDataUrl(file, (watermarkedUrl, processedFile) => {
									syncPhotosForGroup(key, watermarkedUrl || "", processedFile || file);
								});
							}
						}
					});
				}

				// --- DRAG & DROP HANDLING ON MOTIF CARD ---
				['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
					card.addEventListener(eventName, (e) => {
						e.preventDefault();
						e.stopPropagation();
					}, false);
				});

				['dragenter', 'dragover'].forEach(eventName => {
					card.addEventListener(eventName, () => {
						card.style.background = '#e0f2fe';
						card.style.borderColor = '#0284c7';
						card.style.transform = 'scale(1.01)';
					}, false);
				});

				['dragleave', 'drop'].forEach(eventName => {
					card.addEventListener(eventName, () => {
						card.style.background = isCurrentlyActive ? '#f0f9ff' : '#ffffff';
						card.style.borderColor = isCurrentlyActive ? '#0284c7' : (currentStore.isCustom ? '#10b981' : '#cbd5e1');
						card.style.transform = 'none';
					}, false);
				});

				card.addEventListener('drop', (e) => {
					const dt = e.dataTransfer;
					if (dt && dt.files && dt.files.length > 0) {
						const file = dt.files[0];
						if (file.type.startsWith('image/')) {
							if (typeof window.openImageCropper === 'function') {
								window.openImageCropper([file], (croppedFiles) => {
									if (!croppedFiles || croppedFiles.length === 0) return;
									const targetFile = croppedFiles[0];
									if (uploadBtn) {
										uploadBtn.innerHTML = "⏳ Memproses...";
										uploadBtn.disabled = true;
									}
									createWatermarkedDataUrl(targetFile, (watermarkedUrl, processedFile) => {
										syncPhotosForGroup(key, watermarkedUrl || "", processedFile || targetFile);
									});
								});
							} else {
								if (uploadBtn) {
									uploadBtn.innerHTML = "⏳ Memproses...";
									uploadBtn.disabled = true;
								}
								createWatermarkedDataUrl(file, (watermarkedUrl, processedFile) => {
									syncPhotosForGroup(key, watermarkedUrl || "", processedFile || file);
								});
							}
						}
					}
				}, false);
			});
		}

		// --- GLOBAL COPY-PASTE (CTRL+V / CMD+V) IMAGE HANDLER ---
		window.addEventListener("paste", (e) => {
			const activeEl = document.activeElement;
			const isTextInput = activeEl && (activeEl.tagName === "INPUT" || activeEl.tagName === "TEXTAREA") && activeEl.type === "text";
			if (isTextInput) return;

			const items = e.clipboardData?.items;
			if (!items) return;

			let imageFile = null;
			for (let i = 0; i < items.length; i++) {
				if (items[i].type.indexOf("image") !== -1) {
					imageFile = items[i].getAsFile();
					break;
				}
			}

			if (imageFile) {
				const targetGroup = activeTargetMotif || (motifPhotoStore.keys().next().value || "Motif A");
				if (targetGroup) {
					e.preventDefault();
					if (typeof window.openImageCropper === 'function') {
						window.openImageCropper([imageFile], (croppedFiles) => {
							if (!croppedFiles || croppedFiles.length === 0) return;
							const targetFile = croppedFiles[0];
							createWatermarkedDataUrl(targetFile, (watermarkedUrl, processedFile) => {
								syncPhotosForGroup(targetGroup, watermarkedUrl || "", processedFile || targetFile);
							});
						});
					} else {
						createWatermarkedDataUrl(imageFile, (watermarkedUrl, processedFile) => {
							syncPhotosForGroup(targetGroup, watermarkedUrl || "", processedFile || imageFile);
						});
					}
				}
			}
		});

		function syncPhotosForGroup(groupKey, dataUrl, file) {
			motifPhotoStore.set(groupKey, {
				file: file || null,
				previewUrl: dataUrl,
				isCustom: !!file
			});

			// 1. Re-render all photo cards
			renderMotifPhotoCards();

			// 2. Update all counter variant rows matching this groupKey
			document.querySelectorAll(".counter-table-row").forEach(row => {
				const rowKey = getRowPhotoGroupKey(row);
				if (rowKey === groupKey) {
					const img = row.querySelector(".v-preview-img");
					const svg = row.querySelector(".v-placeholder-svg");
					const photoHidden = row.querySelector(".v-photo-url-hidden");
					const fileInp = row.querySelector(".v-row-file-input");

					if (img) {
						img.src = dataUrl;
						img.style.display = dataUrl ? "block" : "none";
					}
					if (svg) svg.style.display = dataUrl ? "none" : "block";
					if (photoHidden) {
						if (dataUrl && dataUrl.startsWith("http") && !dataUrl.startsWith("blob:")) {
							photoHidden.value = dataUrl;
						} else {
							photoHidden.value = "";
						}
					}

					// If an actual File object was provided, attach it to the row's input
					if (file && fileInp && window.DataTransfer) {
						try {
							const dt = new DataTransfer();
							dt.items.add(file);
							fileInp.files = dt.files;
						} catch(e) {}
					}
				}
			});
		}

		document.addEventListener("DOMContentLoaded", async () => {
			setupCategoryDropdown();
			setupPriceMasking();
			setupBatchControls();
			setupMotifEngine();
			setupDescGenerator();

			const urlParams = new URLSearchParams(window.location.search);
			const praProdukId = urlParams.get("use_praproduk");
			const qParam = urlParams.get("q");

			// 1. Initial Data Hydration from Pra-Produk
			let rawItem = null;
			const stored = localStorage.getItem("selected_praproduk");
			if (stored) {
				try {
					const parsed = JSON.parse(stored);
					if (praProdukId && String(parsed.id) === String(praProdukId)) {
						rawItem = parsed;
					} else if (!praProdukId) {
						rawItem = parsed;
					}
				} catch (e) {
					console.error("Gagal parse local praproduk", e);
				}
			}

			if (!rawItem && praProdukId) {
				try {
					const res = await fetch(`/api/pra-produk/${praProdukId}`);
					if (res.ok) rawItem = await res.json();
				} catch (e) {
					console.error("Gagal fetch praproduk", e);
				}
			}

			if (rawItem) {
				hydrateFromPraProduk(rawItem);
			} else if (qParam) {
				const skuInp = document.getElementById("adminProductCode");
				if (skuInp) {
					skuInp.value = qParam;
					skuInp.dispatchEvent(new Event("change"));
				}
			}
		});

