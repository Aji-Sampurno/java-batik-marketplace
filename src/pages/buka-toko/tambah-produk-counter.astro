			// Apply Same Fit to Checked Rows
			document.getElementById("btnApplySameFit")?.addEventListener("click", () => {
				const selectedFit = document.getElementById("globalBatchFitSelect")?.value;
				if (!selectedFit) return;
				const checkedRows = getCheckedCounterRows();
				if (checkedRows.length === 0) {
					alert("Silakan centang [✓] varian counter yang ingin diubah terlebih dahulu.");
