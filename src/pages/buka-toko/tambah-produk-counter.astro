						}
					});
				}

				cb.addEventListener("change", () => {
					const active = cb.checked;
					row.style.opacity = active ? "1" : "0.35";
					if (counterHidden) counterHidden.disabled = !active;
					if (outletHidden) outletHidden.disabled = !active;
					sizeHidden.disabled = !active;
					skuHidden.disabled = !active;
					sizeSelect.disabled = !active;
					if (sleeveSelect) sleeveSelect.disabled = !active;
					if (fitSelect) fitSelect.disabled = !active;
					priceDisp.disabled = !active;
					priceHidden.disabled = !active;
					stockInput.disabled = !active;
					dalamanSelect.disabled = !active;
					motifSelect.disabled = !active;
					motifHidden.disabled = !active;
					if (fileInp) fileInp.disabled = !active;
					updateSelectedCounterBadge();
					renderMotifPhotoCards();
				});

				motifSelect.addEventListener("change", () => {
					motifHidden.value = motifSelect.value;
					updateRowVariantName(row);
					renderMotifPhotoCards();
				});

				if (sleeveSelect) {
					sleeveSelect.addEventListener("change", () => {
						updateRowVariantName(row);
						renderMotifPhotoCards();
					});
				}

				sizeSelect.addEventListener("change", () => updateRowVariantName(row));
				if (fitSelect) fitSelect.addEventListener("change", () => updateRowVariantName(row));

				priceDisp.addEventListener("input", (e) => {
					const num = e.target.value.replace(/\D/g, "");
					priceHidden.value = num || "0";
					priceDisp.value = num ? parseInt(num, 10).toLocaleString("id-ID") : "";
				});

				deleteBtn.addEventListener("click", () => {
					row.remove();
					updateSelectedCounterBadge();
					renderMotifPhotoCards();
				});

				updateSelectedCounterBadge();
			});
		}

		function setupMotifEngine() {
			const btn = document.getElementById("add-motif-btn");
			const input = document.getElementById("new-motif-input");
			const grid = document.getElementById("motif-grid");

			if (btn && input && grid) {
				btn.addEventListener("click", async () => {
					const val = input.value.trim();
					if (!val) return;
					btn.disabled = true;

					try {
						const res = await fetch(`${publicApiUrl}/motifs`, {
							method: "POST",
							headers: { "Content-Type": "application/json", "Accept": "application/json" },
							body: JSON.stringify({ name: val })
						});
						const json = await res.json();
						const newMotif = json.data || json;

						if (newMotif && newMotif.id) {
							const lbl = document.createElement("label");
							lbl.className = "motif-pill-label";
							lbl.title = newMotif.name;
							lbl.innerHTML = `<input type="checkbox" name="motif_ids" value="${newMotif.id}" data-name="${newMotif.name}" checked /><span class="motif-icon">✨</span><span class="motif-name">${newMotif.name}</span><span class="check-icon">✓</span>`;
							grid.appendChild(lbl);
							input.value = "";

							motifsMasterList.push(newMotif.name);

							// Update all row select options and global batch select
							const globalBatch = document.getElementById("globalBatchMotifSelect");
							if (globalBatch) {
								const opt = document.createElement("option");
								opt.value = newMotif.name;
								opt.textContent = newMotif.name;
								globalBatch.appendChild(opt);
							}

							document.querySelectorAll(".v-motif-select").forEach(sel => {
								const opt = document.createElement("option");
								opt.value = newMotif.name;
								opt.textContent = newMotif.name;
								sel.appendChild(opt);
							});

							renderMotifPhotoCards();
						}
					} catch (e) {
						console.error("Add motif fail:", e);
					} finally {
						btn.disabled = false;
					}
				});
			}
		}

		function setupAutoNamingListeners() {
			// Motif Grid Checkboxes & Helpers
			const motifGrid = document.getElementById("motif-grid");
			if (motifGrid) {
				motifGrid.addEventListener("change", (e) => {
					const target = e.target;
					if (target && target.tagName === "INPUT") {
						updateName();
					}
				});
			}

			// Motif Filter & Reset
			document.getElementById("motifFilterInput")?.addEventListener("input", (e) => {
				const q = (e.target.value || "").toLowerCase().trim();
				document.querySelectorAll("#motif-grid .motif-pill-label").forEach(pill => {
					const text = (pill.textContent || "").toLowerCase();
					pill.style.display = text.includes(q) ? "" : "none";
				});
			});

			document.getElementById("btnDeselectAllMotifs")?.addEventListener("click", () => {
				document.querySelectorAll("#motif-grid input[name='motif_ids']").forEach(cb => {
					cb.checked = false;
				});
				const filterInput = document.getElementById("motifFilterInput");
				if (filterInput) filterInput.value = "";
				document.querySelectorAll("#motif-grid .motif-pill-label").forEach(pill => {
					pill.style.display = "";
				});
				updateName();
			});

			// Color Grid Checkboxes & Helpers
			const colorGrid = document.getElementById("color-grid");
			if (colorGrid) {
				colorGrid.addEventListener("change", (e) => {
					const target = e.target;
					if (target && target.tagName === "INPUT") {
						updateName();
					}
				});
			}

			// Color Filter & Reset
			document.getElementById("colorFilterInput")?.addEventListener("input", (e) => {
				const q = (e.target.value || "").toLowerCase().trim();
				document.querySelectorAll("#color-grid .color-pill-label").forEach(pill => {
					const text = (pill.textContent || "").toLowerCase();
					pill.style.display = text.includes(q) ? "" : "none";
				});
			});

			document.getElementById("btnDeselectAllColors")?.addEventListener("click", () => {
				document.querySelectorAll("#color-grid input[name='colors']").forEach(cb => {
					cb.checked = false;
				});
				const filterInput = document.getElementById("colorFilterInput");
				if (filterInput) filterInput.value = "";
				document.querySelectorAll("#color-grid .color-pill-label").forEach(pill => {
					pill.style.display = "";
				});
				updateName();
			});

			// Item Code & SKU Inputs
			const itemCodeInput = document.getElementById("product_item_code_input");
			const skuInput = document.getElementById("product_sku_input");

			itemCodeInput?.addEventListener("input", updateName);
			skuInput?.addEventListener("input", updateName);

			// Table Dalaman / Furing changes
			const tableContainer = document.getElementById("counterVariantsListContainer");
			if (tableContainer) {
				tableContainer.addEventListener("change", (e) => {
					const target = e.target;
					if (target && target.classList && target.classList.contains("v-dalaman-select")) {
