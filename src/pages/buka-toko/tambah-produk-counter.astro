	</style>

	<script is:inline define:vars={{ publicApiUrl, typesListServer: hierarchicalTypes, motifsListServer: motifs, sizesListServer: sizesData, colorsListServer: colorsData }}>
		const BASE_PHOTO_URL = "https://noir.grace.gracianna.web.id/foto/";
		const BASE_PHOTO_URL_FALLBACK = "https://noir.grace.gracianna.web.id/storage/";
		const BASE_PHOTO_URL_IMAGES = "https://noir.grace.gracianna.web.id/images/";

		const hierarchicalTypes = typesListServer || [];
		const motifsMasterList = [
			"Motif A", "Motif B", "Motif C", "Motif D", "Motif E", "Motif F", "Motif G", "Motif H",
			...(Array.isArray(motifsListServer) ? motifsListServer.map(m => m.name) : [])
		];

		// Gunakan data ukuran resmi dari database (API /sizes)
		const dbSizes = Array.isArray(sizesListServer) ? sizesListServer.map(s => (s.name || "").trim().toUpperCase()).filter(Boolean) : [];
		const standardSizesList = ["ALL SIZE", ...dbSizes.filter(s => s !== "ALL SIZE")];

		// Global store for uploaded files & previews per motif: motifName -> { file: File|null, previewUrl: string, isCustom: boolean }
		const motifPhotoStore = new Map();

		function cleanSize(rawSize, rawKode) {
			if (!rawSize) {
				if (rawKode && rawKode.length >= 3) {
					const char3 = rawKode.charAt(2).toUpperCase();
					const sizeCodeMap = {
						'0': 'ALL SIZE', 'S': 'S', 'M': 'M', 'L': 'L', 'X': 'XL', 'Y': 'XXL',
						'2': '2L', '3': '3L', '4': '4L', '5': '5L', '6': '6L', '7': '7L'
					};
					if (sizeCodeMap[char3]) return sizeCodeMap[char3];
				}
				return "ALL SIZE";
			}
			const s = String(rawSize).trim().toUpperCase();
			if (s === "00" || s === "0" || s === "ALL" || s === "ALLSIZE" || s === "ALL SIZE" || s === "-") {
				return "ALL SIZE";
			}
			return s;
		}

		document.addEventListener("DOMContentLoaded", async () => {
			setupCategoryDropdown();
			setupPriceMasking();
			setupBatchControls();
			setupMotifEngine();
			setupDescGenerator();

			const urlParams = new URLSearchParams(window.location.search);
			const praProdukId = urlParams.get("use_praproduk");
			const qParam = urlParams.get("q");

			// 1. Initial Data Hydration from Pra-Produk
			let rawItem = null;
			const stored = localStorage.getItem("selected_praproduk");
			if (stored) {
				try {
					const parsed = JSON.parse(stored);
					if (parsed && (String(parsed.id) === String(praProdukId) || (qParam && parsed.kodeitem && parsed.kodeitem.toUpperCase() === qParam.toUpperCase()))) {
						rawItem = parsed;
					}
				} catch (e) {
					console.error("Localstorage parse error:", e);
				}
			}

			if (!rawItem && (praProdukId || qParam)) {
				const queryTerm = qParam || praProdukId;
				try {
					const res = await fetch(`https://noir.grace.gracianna.web.id/api/v1/beli1?per_page=12&q=${encodeURIComponent(queryTerm)}`);
					const json = await res.json();
					const listData = Array.isArray(json) ? json : (json.data?.data || json.data || []);
					if (listData.length > 0) {
						rawItem = listData.find(p => String(p.id) === String(praProdukId)) || listData.find(p => p.kodeitem && qParam && p.kodeitem.toUpperCase() === qParam.toUpperCase()) || listData[0];
					}
				} catch (err) {
					console.error("Fetch praproduk error:", err);
				}
			}

			if (rawItem) {
				hydrateForm(rawItem);
			}
		});

		function hydrateForm(item) {
			const nameInput = document.getElementById("product_name_input");
			const skuInput = document.getElementById("product_sku_input");
			const itemCodeInput = document.getElementById("product_item_code_input");
			const priceDisplay = document.getElementById("product_price_input_display");
			const priceHidden = document.getElementById("product_price_input");
			const mainPraInput = document.getElementById("main_praproduk_id_input");

			if (mainPraInput && item.id) mainPraInput.value = item.id;
			if (nameInput && item.nama) nameInput.value = item.nama;
			if (skuInput && item.counter) skuInput.value = item.counter;
			if (itemCodeInput && (item.kodeitem || item.kode)) itemCodeInput.value = item.kodeitem || item.kode;

			const rawPrice = parseInt(item.hjual || 0);
			if (rawPrice > 0) {
				if (priceHidden) priceHidden.value = rawPrice;
				if (priceDisplay) priceDisplay.value = rawPrice.toLocaleString("id-ID");
			}

			// ==========================================
			// 1. AUTO-DETECT CATEGORY (L1 & L2)
			// ==========================================
			const itemUpperName = (item.nama || "").toUpperCase();
			const activeCode = (item.kode || item.kodeitem || "").toString().trim();
			let typeLetter = activeCode.length >= 2 ? activeCode.charAt(1).toUpperCase() : (activeCode.length === 1 ? activeCode.toUpperCase() : "");

			const t2Map = {
				C: "CELANA", K: "KEMEJA", J: "JAKET", R: "ROK", T: "T - SHIRT", B: "BLUES",
				S: "STELAN", N: "TANK TOP", A: "JAS", M: "SARIMBIT", L: "SYAL", U: "JUMPSUIT",
				G: "GAUN", I: "TOPI", D: "SABUK", E: "LEGGING", P: "DRESS", H: "SELENDANG",
				O: "OUTER", F: "SARUNG", V: "KEBAYA", Q: "KLG/ANTG", W: "BROS", X: "GAMIS"
			};

			let categoryName = null;
			// Check direct keyword in name first (e.g. ROK, KEMEJA, CELANA, DRESS, GAMIS, dll.)
			const commonCategories = [
				{ kw: "ROK", cat: "ROK" },
				{ kw: "KEMEJA", cat: "KEMEJA" },
				{ kw: "CELANA", cat: "CELANA" },
				{ kw: "DRESS", cat: "DRESS" },
				{ kw: "GAMIS", cat: "GAMIS" },
				{ kw: "BLUS", cat: "BLUES" },
				{ kw: "BLUES", cat: "BLUES" },
				{ kw: "OUTER", cat: "OUTER" },
				{ kw: "JAKET", cat: "JAKET" },
				{ kw: "SETELAN", cat: "STELAN" },
				{ kw: "STELAN", cat: "STELAN" },
				{ kw: "KAIN", cat: "KAIN" },
				{ kw: "SARUNG", cat: "SARUNG" },
				{ kw: "KEBAYA", cat: "KEBAYA" },
				{ kw: "KAOS", cat: "T - SHIRT" },
				{ kw: "T-SHIRT", cat: "T - SHIRT" }
			];

			for (const itemCat of commonCategories) {
				if (itemUpperName.includes(itemCat.kw)) {
					categoryName = itemCat.cat;
					break;
				}
			}

			if (!categoryName && typeLetter && t2Map[typeLetter]) {
				categoryName = t2Map[typeLetter];
			}
			if (!categoryName && item.kategori) {
				categoryName = item.kategori;
			}

			if (categoryName) {
				selectCategoryByName(categoryName);
			}

			// Auto detect L2 (Bahan) from 4th char of SKU
			if (activeCode.length >= 4) {
				const bahanLetter = activeCode.charAt(3).toUpperCase();
				const t3Map = {
					J: "JEANS", K: "KAOS", T: "KATUN", P: "PARASIT", N: "NILON", B: "BENANG",
					L: "KALDORE", A: "BROKLAT", F: "SIFONE", U: "KULIT", R: "BLUDRU", M: "TENUN",
					E: "PARIS", S: "SATEN", C: "JERUK", D: "DOBY", G: "SUTRA", H: "PARIS",
					I: "BABY", V: "VISCOS", W: "SILKY", X: "KREP"
				};
				if (t3Map[bahanLetter]) {
					setTimeout(() => selectL2ByName(t3Map[bahanLetter]), 100);
				}
			}

			// ==========================================
			// 2. AUTO-DETECT MOTIF GLOBAL
			// ==========================================
			const motifGrid = document.getElementById("motif-grid");
			if (motifGrid) {
				const motifKeywords = [
					"MEGAMENDUNG", "SEKAR JAGAD", "TENUN", "WAYANG", "IKAN", "BUNGA", "AYAM",
					"BURUNG", "MERAK", "SOGAN", "SOGA", "WAJIK", "KAWUNG", "MACAN", "NAGA",
					"KUDA", "DAUN", "PARANG", "KOMBINASI", "KONTEMPORER", "SAWUNGGALING", "PAGODA"
				];
				motifKeywords.forEach(kw => {
					if (itemUpperName.includes(kw)) {
						const cb = motifGrid.querySelector(`input[data-name*="${kw}" i]`);
						if (cb) cb.checked = true;
					}
				});
			}

