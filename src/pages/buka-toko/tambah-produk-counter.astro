						<input type="text" id="new-l3-input" placeholder="Nama Detail baru..." style="flex: 1; font-size: 0.78rem; padding: 0.45rem 0.75rem; border: 1px dashed #94a3b8; border-radius: 6px; background: #f8fafc;" />
						<button type="button" id="add-l3-btn" style="font-size: 0.72rem; background: #0f172a; color: white; border: none; padding: 0 14px; border-radius: 6px; cursor: pointer; font-weight: 700; height: 34px;">Simpan</button>
