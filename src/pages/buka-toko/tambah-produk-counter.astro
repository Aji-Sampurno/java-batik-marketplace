		function decodePosItemInfo(item) {
			const rawCode = (item.kode || item.code || item.sku || "").toUpperCase().trim();
			const rawName = (item.nama || item.name || "").toUpperCase().trim();

			let divisi = "";
			let kategori = "";
			let bahan = "";
			let proses = "";
			let warna = "";
			let ukuran = "";
			let dalaman = "";

			// 1. PRIORITAS UTAMA MUTLAK: ANALISIS KODE BARCODE POS (17 DIGIT)
			if (rawCode.length >= 1) {
				const char1 = rawCode.charAt(0);
				if (NOIR_TIPE_MAP.t1[char1]) divisi = NOIR_TIPE_MAP.t1[char1];
			}
			if (rawCode.length >= 2) {
				const char2 = rawCode.charAt(1);
				if (NOIR_TIPE_MAP.t2[char2]) {
					kategori = NOIR_TIPE_MAP.t2[char2].name;
				}
			}
			if (rawCode.length >= 3) {
				const char3 = rawCode.charAt(2);
				if (NOIR_TIPE_MAP.t5[char3]) ukuran = NOIR_TIPE_MAP.t5[char3];
			}
			if (rawCode.length >= 4) {
				const char4 = rawCode.charAt(3);
				if (NOIR_TIPE_MAP.t3[char4]) bahan = NOIR_TIPE_MAP.t3[char4].name;
			}
			if (rawCode.length >= 5) {
				const char5 = rawCode.charAt(4);
				if (NOIR_TIPE_MAP.t6[char5]) proses = NOIR_TIPE_MAP.t6[char5].name;
			}
			if (rawCode.length >= 6) {
				const char6 = rawCode.charAt(5);
				if (NOIR_TIPE_MAP.t4[char6]) warna = NOIR_TIPE_MAP.t4[char6];
			}

			// Cek Furing / Tanpa Furing dari kode barcode
			if (rawCode.includes("TF")) {
				dalaman = "Tanpa Furing (TF)";
			} else if (rawCode.includes("F")) {
				dalaman = "Furing (F)";
			}

			// 2. CADANGAN HANYA JIKA KODE TIDAK MENYEDIAKAN
			if (!kategori) {
				if (rawName.includes("KMJ") || rawName.includes("KEMEJA")) kategori = "KEMEJA";
				else if (rawName.includes("HEM")) kategori = "T - SHIRT";
				else if (rawName.includes("BLUS") || rawName.includes("BLOUSE") || rawName.includes("BLUES")) kategori = "BLUES";
				else if (rawName.includes("DRS") || rawName.includes("DRESS")) kategori = "DRESS";
				else if (rawName.includes("GAUN")) kategori = "GAUN";
				else if (rawName.includes("GAMIS") || rawName.includes("KAFTAN")) kategori = "GAMIS";
				else if (rawName.includes("ROK") || rawName.includes("SKIRT")) kategori = "ROK";
				else if (rawName.includes("CLN") || rawName.includes("CELANA")) kategori = "CELANA";
				else if (rawName.includes("LEGGING")) kategori = "LEGGING";
				else if (rawName.includes("SARUNG")) kategori = "SARUNG";
				else if (rawName.includes("TNK") || rawName.includes("TUNIK")) kategori = "TUNIK";
				else if (rawName.includes("OUTER") || rawName.includes("CARDIGAN") || rawName.includes("ROMPI")) kategori = "OUTER";
				else if (rawName.includes("JAKET")) kategori = "JAKET";
				else if (rawName.includes("JAS") || rawName.includes("BLAZER")) kategori = "JAS";
				else if (rawName.includes("KEBAYA")) kategori = "KEBAYA";
				else if (rawName.includes("STL") || rawName.includes("SETELAN") || rawName.includes("STELAN")) kategori = "STELAN";
				else if (rawName.includes("JUMPSUIT")) kategori = "JUMPSUIT";
				else if (rawName.includes("TANK TOP")) kategori = "TANK TOP";
				else if (rawName.includes("SARIMBIT")) kategori = "SARIMBIT";
			}

			if (!bahan) {
				if (rawName.includes("KATUN") || rawName.includes("COTTON")) bahan = "KATUN";
				else if (rawName.includes("SUTRA") || rawName.includes("SILK") || rawName.includes("SUTERA")) bahan = "SUTRA";
				else if (rawName.includes("TENUN")) bahan = "TENUN";
				else if (rawName.includes("SATEN") || rawName.includes("SATIN")) bahan = "SATEN";
				else if (rawName.includes("DOBY") || rawName.includes("DOBBY")) bahan = "DOBY";
				else if (rawName.includes("BROKLAT") || rawName.includes("BRUKAT")) bahan = "BROKLAT";
				else if (rawName.includes("SIFONE") || rawName.includes("CHIFFON")) bahan = "SIFONE";
				else if (rawName.includes("PARIS")) bahan = "PARIS";
				else if (rawName.includes("VISCOS") || rawName.includes("VISCOSE")) bahan = "VISCOS";
				else if (rawName.includes("JEANS")) bahan = "JEANS";
			}

			if (!proses) {
				if (rawName.includes("TULIS")) proses = "TULIS";
				else if (rawName.includes("CAP")) proses = "CAP";
				else if (rawName.includes("PRINTING") || rawName.includes("PRINT")) proses = "PRINT";
				else if (rawName.includes("PERADA") || rawName.includes("PRADA")) proses = "PERADA";
			}

			if (!warna) {
				if (rawName.includes("MUST") || rawName.includes("MUSTARD")) warna = "KUNING";
				else if (rawName.includes("HTM") || rawName.includes("HITAM") || rawName.includes("BLACK")) warna = "HITAM";
				else if (rawName.includes("PTH") || rawName.includes("PUTIH") || rawName.includes("WHITE")) warna = "PUTIH";
				else if (rawName.includes("MRH") || rawName.includes("MERAH") || rawName.includes("RED")) warna = "MERAH";
				else if (rawName.includes("MRN") || rawName.includes("MAROON") || rawName.includes("MARON")) warna = "MAROON";
				else if (rawName.includes("NVY") || rawName.includes("NAVY")) warna = "NAVY";
				else if (rawName.includes("CKL") || rawName.includes("COKLAT") || rawName.includes("BROWN")) warna = "COKLAT";
				else if (rawName.includes("KNG") || rawName.includes("KUNING") || rawName.includes("YELLOW")) warna = "KUNING";
				else if (rawName.includes("HJU") || rawName.includes("HIJAU") || rawName.includes("GREEN")) warna = "HIJAU";
			}

			const parts = [];
			if (divisi) parts.push(divisi);
			if (kategori) parts.push(kategori);
			if (bahan) parts.push(`Bahan: ${bahan}`);
			if (proses) parts.push(`Proses: ${proses}`);
			if (dalaman) parts.push(dalaman);
			if (warna) parts.push(`Warna: ${warna}`);
			if (ukuran && ukuran !== "ALL SIZE") parts.push(`Ukuran: ${ukuran}`);

			return {
				divisi,
				kategori,
				bahan,
				proses,
				dalaman: dalaman || "Tanpa Furing (TF)",
				warna,
				ukuran,
				summary: parts.join(" • ") || "Produk Standar"
			};
		}

		function hydrateForm(item) {
			const nameInput = document.getElementById("product_name_input");
			const skuInput = document.getElementById("product_sku_input");
			const itemCodeInput = document.getElementById("product_item_code_input");
			const posCodeInput = document.getElementById("product_pos_code_input");
			const priceDisplay = document.getElementById("product_price_input_display");
			const priceHidden = document.getElementById("product_price_input");
			const mainPraInput = document.getElementById("main_praproduk_id_input");

			const activeSku = (item.counter || "").toString().trim();
			const activeItemCode = (item.kodeitem || "").toString().trim();
			const activePosCode = (item.kode || item.code || "").toString().trim();
			const activeName = (item.nama || item.name || "").toString().trim();

			if (mainPraInput && item.id) mainPraInput.value = item.id;
			if (nameInput && activeName) nameInput.value = activeName;
			if (skuInput && activeSku) skuInput.value = activeSku;
			if (itemCodeInput && activeItemCode) itemCodeInput.value = activeItemCode;
			if (posCodeInput && activePosCode) posCodeInput.value = activePosCode;

			// Tampilkan Master POS Reference Badge Card di atas form
			const posRefCard = document.getElementById("pos-reference-badge-card");
			const refPosCode = document.getElementById("ref-pos-code-val");
			const refPosItemCode = document.getElementById("ref-pos-itemcode-val");
			const refPosName = document.getElementById("ref-pos-name-val");
			const refPosType = document.getElementById("ref-pos-type-val");
			const refPosIdBadge = document.getElementById("ref-pos-id-badge");

			const posDecoded = decodePosItemInfo(item);

			if (posRefCard) {
				if (refPosCode) refPosCode.textContent = activePosCode || "-";
				if (refPosItemCode) refPosItemCode.textContent = activeItemCode || "-";
				if (refPosName) refPosName.textContent = activeName || "-";
				if (refPosType) refPosType.textContent = posDecoded.summary;
				if (refPosIdBadge) refPosIdBadge.textContent = item.id ? `ID: #${item.id}` : "ID: -";
				posRefCard.style.display = "block";
			}

			// Tampilkan informasi tipe terdeteksi
			const detectedRow = document.getElementById("detected-type-info-row");
			const detectedText = document.getElementById("detected-type-info-text");
			if (detectedRow && detectedText) {
				detectedText.innerHTML = `<strong>Tipe Terdeteksi dari Barcode POS:</strong> ${posDecoded.summary}`;
				detectedRow.style.display = "flex";
			}

			const rawPrice = parseInt(item.hjual || 0);
			if (rawPrice > 0) {
				if (priceHidden) priceHidden.value = rawPrice;
				if (priceDisplay) priceDisplay.value = rawPrice.toLocaleString("id-ID");
			}

			// =========================================================================
			// 1. AUTO-DETECT & SELECT KATEGORI (L1 & L2 SESUAI ATURAN MUTLAK)
			// =========================================================================
			autoDetectAndSelectCategories(item);

			// ==========================================
			// 2. AUTO-DETECT MOTIF GLOBAL
			// ==========================================
			const itemUpperName = activeName.toUpperCase();
			const motifGrid = document.getElementById("motif-grid");
			if (motifGrid) {
				const motifKeywords = [
					"MEGAMENDUNG", "SEKAR JAGAD", "TENUN", "WAYANG", "IKAN", "BUNGA", "AYAM",
					"BURUNG", "MERAK", "SOGAN", "SOGA", "WAJIK", "KAWUNG", "MACAN", "NAGA",
					"KUDA", "DAUN", "PARANG", "KOMBINASI", "KONTEMPORER", "SAWUNGGALING", "PAGODA"
				];
				motifKeywords.forEach(kw => {
					if (itemUpperName.includes(kw)) {
						const cb = motifGrid.querySelector(`input[data-name*="${kw}" i]`);
						if (cb) cb.checked = true;
					}
				});
			}

			// ==========================================
			// 3. AUTO-DETECT WARNA UTAMA
			// ==========================================
			const colorGrid = document.getElementById("color-grid");
			if (colorGrid) {
				const detectedColor = posDecoded.warna;
				if (detectedColor) {
					const cb = colorGrid.querySelector(`input[value="${detectedColor}" i]`);
					if (cb) cb.checked = true;
				}
			}

			// Render Counter & Motif Variant Rows
			let detailsArr = item.details;
			if (typeof detailsArr === "string") {
				try { detailsArr = JSON.parse(detailsArr); } catch(e) {}
			}

			if (Array.isArray(detailsArr) && detailsArr.length > 0) {
				renderCounterRows(detailsArr, item);
			} else {
				renderCounterRows([{
					id: item.id,
					counter: item.counter || "01",
					kode: item.kode || "",
					size: item.size || "ALL SIZE",
					stok: item.stok || item.total_stok || 1,
					hjual: item.hjual || 0,
					dalaman: item.dalaman || "",
					outlet: item.outlet || "UTAMA",
					foto: item.foto || item.img1 || null,
					img1: item.img1 || null
				}], item);
			}
		}

		function autoDetectAndSelectCategories(item, localProduct) {
			if (!item && !localProduct) return;

			// 1. Mode Edit Produk Lokal dengan Kategori Tersimpan
			if (localProduct && Array.isArray(localProduct.categories) && localProduct.categories.length > 0) {
				const catIds = localProduct.categories.map(c => String(c.id || c.category_id));
				const l1Cat = hierarchicalTypes.find(t => catIds.includes(String(t.id)) && t.parent_id === null);
				if (l1Cat) {
					applyL1CategorySelection(l1Cat.id, l1Cat.name);
					setTimeout(() => {
						const l2Cats = hierarchicalTypes.filter(t => catIds.includes(String(t.id)) && String(t.parent_id) === String(l1Cat.id));
						if (l2Cats.length > 0) {
							selectL2ByName(l2Cats[0].name);
							setTimeout(() => {
								const l3Cats = hierarchicalTypes.filter(t => catIds.includes(String(t.id)) && l2Cats.some(l2 => String(t.parent_id) === String(l2.id)));
								l3Cats.forEach(l3 => selectL3ByName(l3.name));
							}, 150);
						}
					}, 100);
					return;
				}
			}

			const rawCode = (item.kode || item.sku || item.code || "").toUpperCase().trim();
			const rawName = (item.nama || item.name || "").toUpperCase().trim();

			// 2. TAHAP 1: KATEGORI UTAMA (100% PRIORITAS MUTLAK DARI KARAKTER KE-2 KODE BARCODE POS - t2)
			let targetL1Name = null;
			let isAccessory = false;
			let accessorySubName = "";

			if (rawCode.length >= 2) {
				const char2 = rawCode.charAt(1);
				if (NOIR_TIPE_MAP.t2[char2]) {
					const t2Entry = NOIR_TIPE_MAP.t2[char2];
					targetL1Name = t2Entry.targetL1;
					isAccessory = !!t2Entry.isAccessory;
					accessorySubName = t2Entry.subName || "";
				}
			}

			// Fallback nama untuk L1 hanya jika kode barcode tidak tersedia (< 2 karakter)
			if (!targetL1Name) {
				if (rawName.includes("KMJ") || rawName.includes("KEMEJA")) targetL1Name = "Kemeja";
				else if (rawName.includes("HEM")) targetL1Name = "T - Shirt";
				else if (rawName.includes("BLUS") || rawName.includes("BLOUSE") || rawName.includes("BLUES")) targetL1Name = "Blues";
				else if (rawName.includes("DRS") || rawName.includes("DRESS")) targetL1Name = "Dress";
				else if (rawName.includes("GAUN")) targetL1Name = "Gaun";
				else if (rawName.includes("GAMIS") || rawName.includes("KAFTAN")) targetL1Name = "Gamis";
				else if (rawName.includes("ROK") || rawName.includes("SKIRT")) targetL1Name = "Rok";
				else if (rawName.includes("CLN") || rawName.includes("CELANA")) targetL1Name = "Celana";
				else if (rawName.includes("LEGGING")) targetL1Name = "Legging";
				else if (rawName.includes("SARUNG")) targetL1Name = "Sarung";
				else if (rawName.includes("TNK") || rawName.includes("TUNIK")) targetL1Name = "Tunik";
				else if (rawName.includes("OUTER") || rawName.includes("CARDIGAN") || rawName.includes("ROMPI")) targetL1Name = "Outer";
				else if (rawName.includes("JAKET")) targetL1Name = "Jaket";
				else if (rawName.includes("JAS") || rawName.includes("BLAZER")) targetL1Name = "Jas";
				else if (rawName.includes("KEBAYA")) targetL1Name = "Kebaya";
				else if (rawName.includes("SETELAN") || rawName.includes("STELAN") || rawName.includes("STL")) targetL1Name = "Setelan";
				else if (rawName.includes("JUMPSUIT")) targetL1Name = "Jumpsuit";
				else if (rawName.includes("TANK TOP")) targetL1Name = "Tank Top";
				else if (rawName.includes("SARIMBIT")) targetL1Name = "Sarimbit";
				else if (rawName.includes("SYAL")) { targetL1Name = "Accessories"; isAccessory = true; accessorySubName = "Syal"; }
				else if (rawName.includes("SELENDANG")) { targetL1Name = "Accessories"; isAccessory = true; accessorySubName = "Selendang"; }
				else if (rawName.includes("BROS")) { targetL1Name = "Accessories"; isAccessory = true; accessorySubName = "Bros"; }
				else if (rawName.includes("TOPI")) { targetL1Name = "Accessories"; isAccessory = true; accessorySubName = "Topi"; }
				else if (rawName.includes("SABUK")) { targetL1Name = "Accessories"; isAccessory = true; accessorySubName = "Sabuk"; }
				else if (rawName.includes("ANTING") || rawName.includes("KALUNG")) { targetL1Name = "Accessories"; isAccessory = true; accessorySubName = "Kalung / Anting"; }
			}

			if (targetL1Name) {
				selectCategoryByName(targetL1Name, isAccessory, accessorySubName);
			}

			// 3. TAHAP 2: JENIS / BAHAN L2 (UNTUK NON-AKSESORIS) DARI KARAKTER KE-4 (t3)
			if (!isAccessory) {
				let targetL2Name = null;
				if (rawCode.length >= 4) {
					const char4 = rawCode.charAt(3);
					if (NOIR_TIPE_MAP.t3[char4]) {
						targetL2Name = NOIR_TIPE_MAP.t3[char4].targetL2;
					}
				}

				if (!targetL2Name) {
					if (rawName.includes("KATUN") || rawName.includes("COTTON")) targetL2Name = "Katun";
					else if (rawName.includes("SUTRA") || rawName.includes("SILK") || rawName.includes("SUTERA")) targetL2Name = "Sutra";
					else if (rawName.includes("TENUN")) targetL2Name = "Tenun";
					else if (rawName.includes("SATEN") || rawName.includes("SATIN")) targetL2Name = "Saten";
					else if (rawName.includes("DOBY") || rawName.includes("DOBBY")) targetL2Name = "Dobby";
					else if (rawName.includes("BROKLAT") || rawName.includes("BRUKAT")) targetL2Name = "Broklat";
					else if (rawName.includes("SIFONE") || rawName.includes("CHIFFON")) targetL2Name = "Sifone";
					else if (rawName.includes("PARIS")) targetL2Name = "Paris";
					else if (rawName.includes("VISCOS") || rawName.includes("VISCOSE")) targetL2Name = "Viscos";
					else if (rawName.includes("JEANS")) targetL2Name = "Jeans";
					else if (rawName.includes("KAOS")) targetL2Name = "Kaos";
				}

				if (targetL2Name) {
					setTimeout(() => selectL2ByName(targetL2Name), 120);
				}
			}

			// 4. TAHAP 3: PROSES / DETAIL L3 DARI KARAKTER KE-5 (t6)
			let targetL3Name = null;
			if (rawCode.length >= 5) {
				const char5 = rawCode.charAt(4);
				if (NOIR_TIPE_MAP.t6[char5]) {
					targetL3Name = NOIR_TIPE_MAP.t6[char5].targetL3;
				}
			}

			if (!targetL3Name) {
				if (rawName.includes("TULIS")) targetL3Name = "Tulis";
				else if (rawName.includes("CAP")) targetL3Name = "Cap";
				else if (rawName.includes("PRINTING") || rawName.includes("PRINT")) targetL3Name = "Printing";
				else if (rawName.includes("LUKIS")) targetL3Name = "Lukis";
				else if (rawName.includes("PRADA") || rawName.includes("PERADA")) targetL3Name = "Prada";
			}

			if (targetL3Name) {
				setTimeout(() => selectL3ByName(targetL3Name), 250);
			}
		}

		function applyL1CategorySelection(val, text) {
			const container = document.querySelector('.searchable-select[data-ss-type="product-l1"]');
			if (!container) return;
			const input = container.querySelector(".ss-input");
			const hidden = document.getElementById("l1_category_input");
			const dropdown = container.querySelector(".ss-dropdown");

			if (hidden) hidden.value = val;
			if (input) input.value = text;
			if (dropdown) dropdown.style.display = "none";

			renderSubCategoriesFromList([val]);
			updateName();
		}

		function selectCategoryByName(targetName, isAccessory = false, subCategoryName = "") {
			if (!targetName) return;
			const cleanTarget = targetName.trim().toUpperCase();

			// 1. Search in existing hierarchicalTypes (L1 Roots)
			const l1Matches = hierarchicalTypes.filter(t => t.parent_id === null);
			let matchedL1 = l1Matches.find(t => t.name.trim().toUpperCase() === cleanTarget);

			// Fuzzy alias matching (misal Blues <-> Blus, Stelan <-> Setelan, T - Shirt <-> Hem, Accessories <-> Aksesoris)
			if (!matchedL1) {
				matchedL1 = l1Matches.find(t => {
					const tUpper = t.name.trim().toUpperCase();
					if (cleanTarget === "BLUES" && (tUpper === "BLUS" || tUpper === "BLOUSE")) return true;
					if ((cleanTarget === "STELAN" || cleanTarget === "SETELAN") && (tUpper === "SETELAN" || tUpper === "STELAN" || tUpper === "SET")) return true;
					if (cleanTarget === "T - SHIRT" && (tUpper === "HEM" || tUpper === "KAOS")) return true;
					if (cleanTarget === "ACCESSORIES" && tUpper === "AKSESORIS") return true;
					return tUpper.includes(cleanTarget) || cleanTarget.includes(tUpper);
				});
			}

			if (matchedL1) {
				applyL1CategorySelection(matchedL1.id, matchedL1.name);
				if (isAccessory && subCategoryName) {
					setTimeout(() => selectL2ByName(subCategoryName), 150);
				}
			} else {
				// JIKA BELUM ADA DI MARKETPLACE: BUAT BARU SECARA OTOMATIS!
				console.log(`[Auto-Create Category] Kategori L1 '${targetName}' belum ada di marketplace, membuat baru...`);

				// 1. Tambahkan ke hierarchicalTypes in-memory
				const newL1Obj = {
					id: targetName,
					name: targetName,
					parent_id: null,
					depth: 0,
					is_new: true
				};
				hierarchicalTypes.push(newL1Obj);

				// 2. Tambahkan opsi baru ke dropdown UI
				const dropdownOptions = document.querySelector('.searchable-select[data-ss-type="product-l1"] .ss-options');
				if (dropdownOptions) {
					const optDiv = document.createElement("div");
					optDiv.className = "ss-option";
					optDiv.dataset.value = targetName;
					optDiv.innerHTML = `<span>${targetName}</span><span class="lvl-badge lvl-1" style="background:#e0f2fe; color:#0369a1; border:1px solid #bae6fd;">Baru</span>`;
					optDiv.addEventListener("click", () => {
						applyL1CategorySelection(targetName, targetName);
					});
					dropdownOptions.appendChild(optDiv);
				}

				// 3. Langsung pilih kategori baru ini
				applyL1CategorySelection(targetName, targetName);
				if (isAccessory && subCategoryName) {
					setTimeout(() => selectL2ByName(subCategoryName), 150);
				}
			}
		}

