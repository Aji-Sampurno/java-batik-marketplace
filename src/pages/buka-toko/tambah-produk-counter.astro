					outlet: item.outlet || "UTAMA",
					foto: item.foto || item.img1 || null,
					img1: item.img1 || null
				}], item);
			}
		}

		function selectCategoryByName(name) {
			if (!name) return;
			const cleanTarget = name.trim().toUpperCase();
			const options = Array.from(document.querySelectorAll('.searchable-select[data-ss-type="product-l1"] .ss-option'));
			
			// 1. Try exact match first
			let targetOpt = options.find(opt => opt.querySelector("span")?.textContent.trim().toUpperCase() === cleanTarget);
			
			// 2. Try partial match
			if (!targetOpt) {
				targetOpt = options.find(opt => opt.textContent.toUpperCase().includes(cleanTarget) || cleanTarget.includes(opt.querySelector("span")?.textContent.trim().toUpperCase() || ""));
			}

			if (targetOpt) {
				targetOpt.click();
			} else {
				// If not found in L1 root, check if it exists in hierarchicalTypes to find its L1 parent
				const matchedType = hierarchicalTypes.find(t => t.name.trim().toUpperCase() === cleanTarget || t.name.toUpperCase().includes(cleanTarget));
				if (matchedType) {
					if (matchedType.parent_id) {
						const parentL1 = hierarchicalTypes.find(t => t.id === matchedType.parent_id);
						if (parentL1) {
							selectCategoryByName(parentL1.name);
							setTimeout(() => selectL2ByName(matchedType.name), 150);
							return;
						}
					}
					// Select directly
					const optDirect = options.find(opt => opt.dataset.value == matchedType.id);
					if (optDirect) optDirect.click();
				}
			}
		}

		function selectL2ByName(l2Name) {
			if (!l2Name) return;
			const l2Row = document.getElementById("l2-selection-row");
			if (!l2Row) return;

			const labels = l2Row.querySelectorAll("label.cat-pill-label, label");
			let found = false;
			for (const lbl of labels) {
				const text = lbl.textContent.trim().toUpperCase();
				if (text.includes(l2Name.toUpperCase()) || l2Name.toUpperCase().includes(text)) {
					const cb = lbl.querySelector('input[type="checkbox"]');
					if (cb) {
						cb.checked = true;
						cb.dispatchEvent(new Event("change"));
						found = true;
						break;
					}
				}
			}

			if (!found) {
				const customInput = document.getElementById("new-l2-input");
				const addBtn = document.getElementById("add-l2-btn");
				if (customInput && addBtn) {
					customInput.value = l2Name;
					addBtn.click();
				}
			}
		}

		function getMotifLetter(index) {
			let letter = "";
			let temp = index;
			while (temp >= 0) {
				letter = String.fromCharCode(65 + (temp % 26)) + letter;
				temp = Math.floor(temp / 26) - 1;
			}
			return `Motif ${letter}`;
		}

		const logoImgPreload = new Image();
		logoImgPreload.crossOrigin = "anonymous";
		logoImgPreload.src = "/images/java_batik_gold.png";

		function createWatermarkedDataUrl(file, callback) {
			const reader = new FileReader();
			reader.onload = (e) => {
				const img = new Image();
				img.onload = () => {
					const canvas = document.createElement("canvas");
					const width = img.width || 1000;
					const height = img.height || 1000;
					canvas.width = width;
					canvas.height = height;
					const ctx = canvas.getContext("2d");
					if (!ctx) {
						callback(e.target.result);
						return;
					}

					// 1. Draw base image
					ctx.drawImage(img, 0, 0, width, height);

					// 2. Draw logo (18% width on top right)
					if (logoImgPreload && logoImgPreload.complete && logoImgPreload.naturalWidth > 0) {
						const logoMargin = Math.round(width * 0.04);
						const logoW = Math.round(width * 0.18);
						const logoH = logoImgPreload.naturalHeight * (logoW / logoImgPreload.naturalWidth);
						ctx.imageSmoothingEnabled = true;
						ctx.imageSmoothingQuality = "high";
						ctx.drawImage(logoImgPreload, width - logoW - logoMargin, logoMargin, logoW, logoH);
					}

					// 3. Draw text code on bottom right
					const itemCodeInput = document.getElementById("product_item_code_input");
					const skuInput = document.getElementById("product_sku_input");
					let codeTxt = (itemCodeInput?.value || skuInput?.value || "").trim().replace(/[^a-zA-Z0-9_\-\s]/g, '');

					if (codeTxt) {
						const fontSize = Math.max(Math.round(height * 0.022), 12);
						const textMarginRight = Math.round(width * 0.04);
						const textY = height - Math.round(height * 0.05);
						ctx.font = `bold ${fontSize}px sans-serif`;
						ctx.textAlign = "right";
						ctx.textBaseline = "alphabetic";

						// Shadow
						ctx.fillStyle = "black";
						ctx.fillText(codeTxt, width - textMarginRight + 2, textY + 2);
						// White text
						ctx.fillStyle = "white";
						ctx.fillText(codeTxt, width - textMarginRight, textY);
					}

					try {
						callback(canvas.toDataURL("image/webp", 0.9));
					} catch(err) {
						callback(e.target.result);
					}
				};
				img.src = e.target.result;
			};
			reader.readAsDataURL(file);
		}

		function showFullscreenImageModal(src) {
			if (!src) return;
			const modal = document.createElement("div");
			modal.style.cssText = "position: fixed; inset: 0; background: rgba(0,0,0,0.85); z-index: 99999; display: flex; align-items: center; justify-content: center; cursor: zoom-out; padding: 20px;";

			const modalImg = new Image();
			modalImg.src = src;
			modalImg.style.cssText = "max-width: 95%; max-height: 90vh; object-fit: contain; border-radius: 8px; box-shadow: 0 10px 30px rgba(0,0,0,0.5);";

			modal.appendChild(modalImg);
			modal.onclick = () => document.body.removeChild(modal);
			document.body.appendChild(modal);
		}

