		function syncPhotosForMotif(motifName, dataUrl, file) {
			motifPhotoStore.set(motifName, {
				file: file || null,
				previewUrl: dataUrl,
				isCustom: !!file
			});

			// Update all rows with this motif
			document.querySelectorAll(".counter-table-row").forEach(row => {
				const rowMotif = row.querySelector(".v-motif-select")?.value;
				if (rowMotif === motifName) {
					const img = row.querySelector(".v-preview-img");
					const svg = row.querySelector(".v-placeholder-svg");
					const badge = row.querySelector(".v-custom-badge");
					const fileInp = row.querySelector(".v-row-file-input");

					if (img) {
						img.src = dataUrl;
						img.style.display = "block";
					}
					if (svg) svg.style.display = "none";
					if (badge) badge.style.display = "inline-block";

					// If an actual File object was provided, attach it to the row's input
					if (file && fileInp && window.DataTransfer) {
						try {
							const dt = new DataTransfer();
							dt.items.add(file);
							fileInp.files = dt.files;
						} catch(e) {}
					}
				}
			});

			renderMotifPhotoCards();
		}

