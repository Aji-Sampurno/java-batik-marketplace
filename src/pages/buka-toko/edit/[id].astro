				`;

				container.appendChild(row);

				// Connect Events
				const cb = row.querySelector(".v-counter-cb");
				const counterHidden = row.querySelector(".v-counter-hidden");
				const outletHidden = row.querySelector(".v-outlet-hidden");
				const sizeHidden = row.querySelector(".v-size-hidden");
				const skuHidden = row.querySelector(".v-sku-hidden");
				const sizeSelect = row.querySelector(".v-size-select");
				const sleeveSelect = row.querySelector(".v-sleeve-select");
				const fitSelect = row.querySelector(".v-fit-select");
				const priceDisp = row.querySelector(".v-price-display");
				const priceHidden = row.querySelector(".v-price-hidden");
				const stockInput = row.querySelector(".v-stock-input");
				const dalamanSelect = row.querySelector(".v-dalaman-select");
				const motifSelect = row.querySelector(".v-motif-select");
				const motifHidden = row.querySelector(".v-motif-hidden");
				const deleteBtn = row.querySelector(".btn-delete-row");
				const thumbBox = row.querySelector(".v-thumb-box");
				const fileInp = row.querySelector(".v-row-file-input");

				if (thumbBox) {
					thumbBox.addEventListener("click", () => {
						const groupKey = getRowPhotoGroupKey(row);
						const store = motifPhotoStore.get(groupKey) || motifPhotoStore.get(motifSelect?.value);
						if (store && store.previewUrl) {
							showFullscreenImageModal(store.previewUrl);
						} else {
							activeTargetMotif = groupKey;
							const card = document.querySelector(`.motif-photo-card[data-key="${groupKey}"]`) || document.querySelector(`.motif-photo-card[data-motif="${motifSelect?.value}"]`);
							if (card) {
								card.scrollIntoView({ behavior: 'smooth', block: 'center' });
								const cardFileInp = card.querySelector(".m-card-file-input");
								if (cardFileInp) cardFileInp.click();
							}
						}
					});
				}

				cb.addEventListener("change", () => {
					const active = cb.checked;
					row.style.opacity = active ? "1" : "0.45";
					counterHidden.disabled = !active;
					outletHidden.disabled = !active;
					sizeHidden.disabled = !active;
					skuHidden.disabled = !active;
					sizeSelect.disabled = !active;
					if (sleeveSelect) sleeveSelect.disabled = !active;
					if (fitSelect) fitSelect.disabled = !active;
					priceDisp.disabled = !active;
					priceHidden.disabled = !active;
					stockInput.disabled = !active;
					dalamanSelect.disabled = !active;
					motifSelect.disabled = !active;
					motifHidden.disabled = !active;
					if (fileInp) fileInp.disabled = !active;
					updateSelectedCounterBadge();
					renderMotifPhotoCards();
				});

				motifSelect.addEventListener("change", () => {
					motifHidden.value = motifSelect.value;
					renderMotifPhotoCards();
				});

				if (sleeveSelect) {
					sleeveSelect.addEventListener("change", () => {
						renderMotifPhotoCards();
					});
				}

				sizeSelect.addEventListener("change", () => {
					sizeHidden.value = sizeSelect.value;
				});

				priceDisp.addEventListener("input", (e) => {
					const num = e.target.value.replace(/\D/g, "");
					priceHidden.value = num || "0";
					priceDisp.value = num ? parseInt(num, 10).toLocaleString("id-ID") : "";
				});

				deleteBtn.addEventListener("click", () => {
					row.remove();
					updateSelectedCounterBadge();
					renderMotifPhotoCards();
				});
			});

			updateSelectedCounterBadge();
			renderMotifPhotoCards();
		}

		function updateSelectedCounterBadge() {
			const total = document.querySelectorAll(".counter-table-row").length;
			const checked = document.querySelectorAll(".counter-table-row .v-counter-cb:checked").length;
			const badge = document.getElementById("selectedCounterCountBadge");
			if (badge) {
				badge.textContent = `✓ ${checked} dari ${total} Varian Dipilih`;
				if (checked === 0) {
					badge.style.color = "#dc2626";
					badge.style.background = "#fee2e2";
					badge.style.borderColor = "#fecaca";
				} else {
					badge.style.color = "#16a34a";
					badge.style.background = "#dcfce7";
					badge.style.borderColor = "#bbf7d0";
				}
			}
		}

		// --- CATEGORY CASCADING LOGIC ---
		function renderSubCategoriesFromList(parentIds, selectedSubIds = []) {
			const container = document.getElementById("sub-category-checkboxes");
			if (!container) return;

			const hasExistingParents = parentIds && parentIds.length > 0 && parentIds[0] !== "";
			if (!hasExistingParents) {
				container.innerHTML = "";
				container.style.display = "none";
				return;
			}

			const l2Children = hierarchicalTypes.filter(t => parentIds.includes(t.parent_id));

			container.innerHTML = `
				<div style="background: #ffffff; border: 1px solid #cbd5e1; border-radius: 10px; padding: 0.9rem 1.1rem; margin-top: 0.75rem; box-shadow: 0 1px 2px rgba(0,0,0,0.02);">
					<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.65rem; flex-wrap: wrap; gap: 0.4rem;">
						<div style="display: flex; align-items: center; gap: 0.4rem;">
							<span style="font-size: 1rem;">👗</span>
							<label class="text-uppercase" style="font-size: 0.72rem; font-weight: 800; color: #1e293b; letter-spacing: 0.5px; margin: 0;">
								Jenis / Bahan Produk (Level 2)
							</label>
							<span style="font-size: 0.65rem; color: #64748b; background: #f1f5f9; padding: 2px 6px; border-radius: 4px; font-weight: 600;">
								Pilih 1
							</span>
						</div>
					</div>
					<div class="pill-badge-container" id="l2-selection-row"></div>
				</div>

				<div id="l3-selection-area" style="display: none; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 10px; padding: 0.9rem 1.1rem; margin-top: 0.75rem; box-shadow: 0 1px 2px rgba(0,0,0,0.02);">
					<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.65rem; flex-wrap: wrap; gap: 0.4rem;">
						<div style="display: flex; align-items: center; gap: 0.4rem;">
							<span style="font-size: 1rem;">✨</span>
							<label class="text-uppercase" style="font-size: 0.72rem; font-weight: 800; color: #1e293b; letter-spacing: 0.5px; margin: 0;">
								Pilihan Detail (Level 3)
							</label>
						</div>
					</div>
					<div class="pill-badge-container" id="l3-grid"></div>
				</div>
			`;
			container.style.display = "block";

			const l2Row = container.querySelector("#l2-selection-row");
			const l3Area = container.querySelector("#l3-selection-area");
			const l3Grid = container.querySelector("#l3-grid");

			function createCatPill(name, id, isL2, parentId) {
				const label = document.createElement("label");
				label.className = "cat-pill-label";
				label.title = name;

				const formattedName = name
					.split(" ")
					.map(w => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase())
					.join(" ");

				const isChecked = selectedSubIds.includes(String(id));

				label.innerHTML = `
					<input type="checkbox" name="category_ids" value="${id}" data-id="${id}" data-parent="${parentId}" data-name="${name}" ${isChecked ? 'checked' : ''} />
					<span class="cat-icon">${isL2 ? "👗" : "✨"}</span>
					<span class="cat-name">${formattedName}</span>
					<span class="check-icon">✓</span>
				`;

				const cb = label.querySelector("input");
				cb.addEventListener("change", () => {
					if (isL2 && cb.checked) {
						l2Row.querySelectorAll("input:checked").forEach(o => {
							if (o !== cb) o.checked = false;
						});
					}
					if (isL2) updateL3Selection();
					updateName();
				});

				return label;
			}

			function updateL3Selection() {
				const checkedL2 = Array.from(l2Row.querySelectorAll("input:checked")).map(i => i.dataset.id);
				if (checkedL2.length === 0) {
					l3Area.style.display = "none";
					l3Grid.innerHTML = "";
					return;
				}
				const l3Children = hierarchicalTypes.filter(t => checkedL2.includes(String(t.parent_id)));
				if (l3Children.length === 0) {
					l3Area.style.display = "none";
					l3Grid.innerHTML = "";
					return;
				}
				l3Grid.innerHTML = "";
				l3Children.forEach(child => {
					l3Grid.appendChild(createCatPill(child.name, child.id, false, child.parent_id));
				});
				l3Area.style.display = "block";
			}

			if (l2Children.length > 0) {
				l2Children.forEach(child => {
					l2Row.appendChild(createCatPill(child.name, child.id, true, child.parent_id));
				});
			}

			updateL3Selection();
		}

		function setupCategoryDropdown() {
			document.querySelectorAll('.searchable-select').forEach(container => {
				const input = container.querySelector(".ss-input");
				const dropdown = container.querySelector(".ss-dropdown");
				const search = container.querySelector(".ss-search");
				const options = container.querySelectorAll(".ss-option");
				const hidden = container.querySelector("input[type='hidden']");

				input?.addEventListener("click", (e) => {
					e.stopPropagation();
					document.querySelectorAll(".ss-dropdown").forEach(d => { if (d !== dropdown) d.style.display = "none"; });
					dropdown.style.display = dropdown.style.display === "block" ? "none" : "block";
					if (dropdown.style.display === "block") search?.focus();
				});

				search?.addEventListener("input", (e) => {
					const term = e.target.value.toLowerCase();
					options.forEach(opt => {
						const text = opt.textContent.toLowerCase();
						opt.style.display = text.includes(term) ? "flex" : "none";
					});
				});

				options.forEach(opt => {
					opt.addEventListener("click", () => {
						const val = opt.dataset.value;
						const text = opt.querySelector("span:first-child").textContent;
						if (hidden) hidden.value = val;
						if (input) input.value = text;
						dropdown.style.display = "none";

						renderSubCategoriesFromList([val]);
						updateName();
					});
				});
			});

			document.addEventListener("click", () => {
				document.querySelectorAll(".ss-dropdown").forEach(d => d.style.display = "none");
			});
		}

		function autoDetectAndSelectCategories(localProduct) {
			if (!localProduct) return;
			const catIds = (localProduct.categories || localProduct.product_categories || []).map(c => String(c.id || c.category_id));
			if (catIds.length === 0 && localProduct.type_id) {
				catIds.push(String(localProduct.type_id));
			}

			const l1Cat = hierarchicalTypes.find(t => catIds.includes(String(t.id)) && t.parent_id === null);
			if (l1Cat) {
				const container = document.querySelector('.searchable-select[data-ss-type="product-l1"]');
				if (container) {
					const input = container.querySelector(".ss-input");
					const hidden = document.getElementById("l1_category_input");
					if (hidden) hidden.value = l1Cat.id;
					if (input) input.value = l1Cat.name;
				}
				renderSubCategoriesFromList([l1Cat.id], catIds);
			}
		}

		// --- AUTO-NAME ENGINE ---
		function updateName() {
			// Optional real-time naming hook
		}

		function setupPriceMasking() {
			document.querySelectorAll(".currency-mask").forEach(input => {
				input.addEventListener("input", (e) => {
					const hiddenId = input.dataset.hiddenId;
					const hidden = document.getElementById(hiddenId);
					const rawVal = e.target.value.replace(/\D/g, "");
					if (hidden) hidden.value = rawVal;
					input.value = rawVal ? parseInt(rawVal, 10).toLocaleString("id-ID") : "";
				});
			});
		}

		function setupBatchControls() {
			// Select All / Deselect All Buttons
			document.getElementById("btnSelectAllCounters")?.addEventListener("click", () => {
				document.querySelectorAll(".v-counter-cb").forEach(cb => {
					if (!cb.checked) { cb.checked = true; cb.dispatchEvent(new Event("change")); }
				});
				updateSelectedCounterBadge();
			});

			document.getElementById("btnUnselectAllCounters")?.addEventListener("click", () => {
				document.querySelectorAll(".v-counter-cb").forEach(cb => {
					if (cb.checked) { cb.checked = false; cb.dispatchEvent(new Event("change")); }
				});
				updateSelectedCounterBadge();
			});

			const selectAll = document.getElementById("selectAllCountersCb");
			selectAll?.addEventListener("change", () => {
				const isChecked = selectAll.checked;
				document.querySelectorAll(".counter-table-row").forEach(row => {
					const cb = row.querySelector(".v-counter-cb");
					if (cb && cb.checked !== isChecked) {
						cb.checked = isChecked;
						cb.dispatchEvent(new Event("change"));
					}
				});
				updateSelectedCounterBadge();
			});

			// Batch Motif
			const handleBatchMotif = () => {
				const val = document.getElementById("globalBatchMotifSelect")?.value;
				if (!val) return;
				const checkedRows = Array.from(document.querySelectorAll(".counter-table-row")).filter(r => r.querySelector(".v-counter-cb")?.checked);
				if (checkedRows.length === 0) {
					alert("Silakan centang [✓] varian counter yang ingin diubah terlebih dahulu.");
					return;
				}
				checkedRows.forEach(row => {
					const sel = row.querySelector(".v-motif-select");
					const hidden = row.querySelector(".v-motif-hidden");
					if (sel) {
						sel.value = val;
						if (hidden) hidden.value = val;
						sel.dispatchEvent(new Event("change"));
					}
