			const groupKeys = new Set();
			activeRows.forEach(row => {
				groupKeys.add(getRowPhotoGroupKey(row));
			});

			if (groupKeys.size === 0) {
				groupKeys.add("Motif A");
			}

			container.innerHTML = "";

			Array.from(groupKeys).sort().forEach(key => {
				const parts = key.split("___");
				const motifName = parts[0];
				const sleeveName = parts[1] || "";

				const store = motifPhotoStore.get(key) || motifPhotoStore.get(motifName);
				const previewUrl = store ? store.previewUrl : "";

				const card = document.createElement("div");
				card.className = "motif-photo-card";
				card.dataset.key = key;
				card.dataset.motif = motifName;

				card.innerHTML = `
					<div class="m-card-thumb" style="width: 80px; height: 80px; border-radius: 8px; overflow: hidden; background: #e2e8f0; border: 1px solid #cbd5e1; flex-shrink: 0; display: flex; align-items: center; justify-content: center; cursor: pointer;">
						${previewUrl ? `
							<img src="${previewUrl}" style="width: 100%; height: 100%; object-fit: cover;" />
						` : `
							<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: #94a3b8;"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
						`}
					</div>
					<div style="flex: 1; min-width: 0;">
						<div style="display: flex; align-items: center; gap: 6px; margin-bottom: 4px;">
							<strong style="font-size: 0.85rem; color: #0f172a;">${motifName}</strong>
							${sleeveName ? `<span style="font-size: 0.65rem; background: #e0f2fe; color: #0369a1; padding: 1px 5px; border-radius: 4px; font-weight: 700;">${sleeveName}</span>` : ""}
						</div>
						<div style="display: flex; gap: 6px; align-items: center; margin-top: 6px;">
							<button type="button" class="btn-change-photo" style="font-size: 0.72rem; font-weight: 700; background: #0f172a; color: white; border: none; padding: 4px 8px; border-radius: 5px; cursor: pointer;">
								${previewUrl ? "Ganti Foto" : "Unggah Foto"}
							</button>
							<input type="file" accept="image/*" class="m-card-file-input" style="display: none;" />
						</div>
					</div>
				`;

				container.appendChild(card);

				const thumb = card.querySelector(".m-card-thumb");
				const uploadBtn = card.querySelector(".btn-change-photo");
				const fileInp = card.querySelector(".m-card-file-input");

				thumb?.addEventListener("click", () => {
					if (previewUrl) showFullscreenImageModal(previewUrl);
					else fileInp?.click();
				});

				uploadBtn?.addEventListener("click", () => {
					activeTargetMotif = key;
					fileInp?.click();
				});

				fileInp?.addEventListener("change", (e) => {
					const file = e.target.files?.[0];
					if (!file) return;

					if (typeof window.openImageCropper === 'function') {
						window.openImageCropper([file], (croppedFiles) => {
							if (!croppedFiles || croppedFiles.length === 0) return;
							const targetFile = croppedFiles[0];
							createWatermarkedDataUrl(targetFile, (watermarkedUrl, processedFile) => {
								syncPhotosForGroup(key, watermarkedUrl || "", processedFile || targetFile);
							});
						});
					} else {
						createWatermarkedDataUrl(file, (watermarkedUrl, processedFile) => {
							syncPhotosForGroup(key, watermarkedUrl || "", processedFile || file);
						});
					}
				});

				// Drag and Drop
				card.addEventListener("dragover", (e) => { e.preventDefault(); card.style.borderColor = "#0284c7"; card.style.background = "#f0f9ff"; });
				card.addEventListener("dragleave", () => { card.style.borderColor = "#e2e8f0"; card.style.background = "#f8fafc"; });
				card.addEventListener("drop", (e) => {
					e.preventDefault();
					card.style.borderColor = "#e2e8f0";
					card.style.background = "#f8fafc";
					const file = e.dataTransfer.files?.[0];
					if (file && file.type.startsWith("image/")) {
						if (typeof window.openImageCropper === 'function') {
							window.openImageCropper([file], (croppedFiles) => {
								if (!croppedFiles || croppedFiles.length === 0) return;
								const targetFile = croppedFiles[0];
								createWatermarkedDataUrl(targetFile, (watermarkedUrl, processedFile) => {
									syncPhotosForGroup(key, watermarkedUrl || "", processedFile || targetFile);
								});
							});
						} else {
							createWatermarkedDataUrl(file, (watermarkedUrl, processedFile) => {
								syncPhotosForGroup(key, watermarkedUrl || "", processedFile || file);
							});
						}
					}
				});
			});
		}

		function syncPhotosForGroup(groupKey, dataUrl, file) {
			motifPhotoStore.set(groupKey, {
				file: file || null,
				previewUrl: dataUrl,
				isCustom: !!file
			});

			renderMotifPhotoCards();

			document.querySelectorAll(".counter-table-row").forEach(row => {
				const rowKey = getRowPhotoGroupKey(row);
				if (rowKey === groupKey) {
					const img = row.querySelector(".v-preview-img");
					const svg = row.querySelector(".v-placeholder-svg");
					const photoHidden = row.querySelector(".v-photo-url-hidden");
					const fileInp = row.querySelector(".v-row-file-input");

					if (img) {
						img.src = dataUrl;
						img.style.display = dataUrl ? "block" : "none";
					}
					if (svg) svg.style.display = dataUrl ? "none" : "block";
					if (photoHidden) {
						if (dataUrl && dataUrl.startsWith("http") && !dataUrl.startsWith("blob:")) {
							photoHidden.value = dataUrl;
						} else {
							photoHidden.value = "";
						}
					}
					if (file && fileInp && window.DataTransfer) {
						try {
							const dt = new DataTransfer();
							dt.items.add(file);
							fileInp.files = dt.files;
						} catch(e) {}
					}
				}
			});
		}

		// Global paste handler for images
		window.addEventListener("paste", (e) => {
			const activeEl = document.activeElement;
			const isTextInput = activeEl && (activeEl.tagName === "INPUT" || activeEl.tagName === "TEXTAREA") && activeEl.type === "text";
			if (isTextInput) return;

			const items = e.clipboardData?.items;
			if (!items) return;

			let imageFile = null;
			for (let i = 0; i < items.length; i++) {
				if (items[i].type.indexOf("image") !== -1) {
					imageFile = items[i].getAsFile();
					break;
				}
			}

			if (imageFile) {
				const targetGroup = activeTargetMotif || (motifPhotoStore.keys().next().value || "Motif A");
				if (targetGroup) {
					e.preventDefault();
					if (typeof window.openImageCropper === 'function') {
						window.openImageCropper([imageFile], (croppedFiles) => {
							if (!croppedFiles || croppedFiles.length === 0) return;
							const targetFile = croppedFiles[0];
							createWatermarkedDataUrl(targetFile, (watermarkedUrl, processedFile) => {
								syncPhotosForGroup(targetGroup, watermarkedUrl || "", processedFile || targetFile);
							});
						});
					} else {
						createWatermarkedDataUrl(imageFile, (watermarkedUrl, processedFile) => {
							syncPhotosForGroup(targetGroup, watermarkedUrl || "", processedFile || imageFile);
						});
					}
				}
			}
		});

