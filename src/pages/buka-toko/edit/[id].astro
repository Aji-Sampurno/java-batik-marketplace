								<input name="code" id="product_sku_input" type="text" value={product.code || ""} placeholder="01930798" style="width: 100%; padding: 0.7rem; border: 1px solid #cbd5e1; border-radius: 6px; font-family: monospace; font-weight: 600;" />
							</div>
							<div>
								<label class="text-uppercase" style="font-size: 0.65rem; font-weight: 700; color: #64748b; display: block; margin-bottom: 0.3rem;">Harga Utama (Rp)</label>
								<input type="text" class="currency-mask" data-hidden-id="product_price_input" required id="product_price_input_display" value={Number(product.price || 0).toLocaleString("id-ID")} placeholder="450.000" style="width: 100%; padding: 0.7rem; border: 1px solid #cbd5e1; border-radius: 6px; font-weight: 700; font-size: 0.95rem;" />
								<input type="hidden" name="price" id="product_price_input" value={product.price || ""} />
								<div id="price_markup_preview" style="font-size: 0.65rem; color: #10b981; margin-top: 0.4rem; font-weight: 600; display: none;">
