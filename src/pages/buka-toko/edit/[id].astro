								<div style="display: flex; align-items: center; gap: 3px;">
									<span style="font-size: 0.75rem; font-weight: 700; color: #64748b;">Rp</span>
									<input type="text" value="${priceVal.toLocaleString('id-ID')}" class="v-price-display" style="width: 100%; padding: 5px 8px; font-size: 0.78rem; border: 1.5px solid #cbd5e1; border-radius: 6px; font-weight: 700; color: #0f172a; background: #fff;" />
