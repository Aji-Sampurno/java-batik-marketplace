								<label class="text-uppercase" style="font-size: 0.65rem; font-weight: 700; color: #64748b; margin: 0;">Nama Produk</label>
								<span style="font-size: 0.65rem; color: #0284c7; font-weight: 700; letter-spacing: 0.3px;">AUTO-NAME & DAPAT DIUBAH</span>
							</div>
							<input name="name" id="product_name_input" type="text" value={product.name || ""} required placeholder="Contoh: Kemeja Katun Printing Krem I327" style="width: 100%; padding: 0.7rem; border: 1px solid #cbd5e1; border-radius: 6px; font-weight: 600; font-size: 0.95rem;" />
						</div>

						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-md);">
