										<span>📏</span> Ukuran
									</label>
									<div style="display: flex; gap: 0.3rem;">
										<select id="globalBatchSizeSelect" style="flex: 1; min-width: 0; padding: 0.35rem 0.5rem; font-size: 0.75rem; border: 1px solid #cbd5e1; border-radius: 6px; font-weight: 600; background: #f8fafc; color: #0f172a;">
											{["ALL SIZE", "XS", "S", "M", "L", "XL", "XXL", "3XL", "4XL", "5XL", "2L", "3L", "4L", "5L", "6L", "7L"].map((sz) => (
