								<label class="text-uppercase" style="font-size: 0.72rem; font-weight: 800; color: #1e293b; margin: 0;">Palet Warna</label>
								<button type="button" id="btnDeselectAllColors" style="font-size: 0.65rem; color: #64748b; background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 4px; padding: 2px 6px; cursor: pointer;">Reset Warna</button>
