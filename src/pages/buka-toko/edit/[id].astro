									<span style="font-size: 0.62rem; color: #0284c7; font-weight: 700;">AUTO-NAME</span>
								</div>
								<input name="item_code" id="product_item_code_input" type="text" value={product.item_code || ""} placeholder="D021" style="width: 100%; padding: 0.7rem; border: 1.5px solid #bae6fd; border-radius: 6px; font-family: monospace; font-weight: 700; color: #0369a1; background: #f0f9ff;" />
							</div>
						</div>

						<div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-md);">
