						<span style="color: #94a3b8; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; display: block; margin-bottom: 2px;">📌 Kode Barcode POS (Lengkap)</span>
						<strong id="ref-pos-code-val" style="font-family: monospace; font-size: 0.95rem; color: #fbbf24; letter-spacing: 1px;">{product.code || "-"}</strong>
					</div>
					<div>
						<span style="color: #94a3b8; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; display: block; margin-bottom: 2px;">🏷️ Kode Barang (Model)</span>
						<strong id="ref-pos-itemcode-val" style="font-family: monospace; font-size: 0.95rem; color: #38bdf8;">{product.item_code || "-"}</strong>
					</div>
					<div style="grid-column: 1 / -1;">
						<span style="color: #94a3b8; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; display: block; margin-bottom: 2px;">📦 Nama Produk POS</span>
						<strong id="ref-pos-name-val" style="font-size: 0.95rem; color: #f8fafc;">{product.name || "-"}</strong>
					</div>
					<div style="grid-column: 1 / -1; background: rgba(0,0,0,0.25); padding: 8px 12px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.08);">
						<span style="color: #38bdf8; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; display: block; margin-bottom: 2px;">✨ Uraian Tipe Terdeteksi (API Noir POS)</span>
						<span id="ref-pos-type-val" style="font-size: 0.85rem; color: #e2e8f0; font-weight: 600;">-</span>
					</div>
				</div>
			</div>

			<!-- Live POS Notification Banner (Hidden initially) -->
