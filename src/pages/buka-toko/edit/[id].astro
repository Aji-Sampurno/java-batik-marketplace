<Layout title={`Edit Produk (Skema Counter) - ${product.name}`}>
	<section style="padding: 130px 0 var(--spacing-2xl) 0; background: #f8fafc; min-height: 100vh;">
		<div class="container" style="max-width: 1100px;">
			
			<!-- Header -->
			<div style="margin-bottom: var(--spacing-xl); display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem;">
				<div>
					<div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;">
						<h1 style="font-family: var(--font-serif); font-size: 2.2rem; margin: 0; font-weight: 400; color: #0f172a;">
							Edit Produk <span style="font-style: italic; color: #b45309;">Skema Counter</span>
						</h1>
						<span style="background: #e0f2fe; color: #0369a1; font-size: 0.7rem; font-weight: 800; padding: 0.25rem 0.75rem; border-radius: 20px; border: 1px solid #bae6fd;">
							Format Pra-Produk & Multi-Motif
						</span>
					</div>
					<p style="color: #64748b; margin-top: 0.5rem; font-size: 0.9rem;">
						Kelola detail produk, foto per motif, serta tabel varian counter yang terhubung langsung dengan sistem stok & katalog.
					</p>
				</div>

