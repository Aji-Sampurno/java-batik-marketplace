		function decodePosItemInfo(item) {
			const rawCode = (item.kode || item.code || item.sku || "").toUpperCase().trim();
			const rawName = (item.nama || item.name || "").toUpperCase().trim();

			let divisi = "";
			let kategori = "";
			let bahan = "";
			let proses = "";
			let warna = "";
			let ukuran = "";

			if (rawCode.length >= 1) {
				const char1 = rawCode.charAt(0);
				if (NOIR_TIPE_MAP.t1[char1]) divisi = NOIR_TIPE_MAP.t1[char1];
			}
			if (rawCode.length >= 2) {
				const char2 = rawCode.charAt(1);
				if (NOIR_TIPE_MAP.t2[char2]) kategori = NOIR_TIPE_MAP.t2[char2].name;
			}
			if (rawCode.length >= 3) {
				const char3 = rawCode.charAt(2);
				if (NOIR_TIPE_MAP.t5[char3]) ukuran = NOIR_TIPE_MAP.t5[char3];
			}
			if (rawCode.length >= 4) {
				const char4 = rawCode.charAt(3);
				if (NOIR_TIPE_MAP.t3[char4]) bahan = NOIR_TIPE_MAP.t3[char4].name;
			}
			if (rawCode.length >= 5) {
				const char5 = rawCode.charAt(4);
				if (NOIR_TIPE_MAP.t6[char5]) proses = NOIR_TIPE_MAP.t6[char5].name;
			}
			if (rawCode.length >= 6) {
				const char6 = rawCode.charAt(5);
				if (NOIR_TIPE_MAP.t4[char6]) warna = NOIR_TIPE_MAP.t4[char6];
			}

			const summaryParts = [];
			if (divisi) summaryParts.push(divisi);
			if (kategori) summaryParts.push(kategori);
			if (bahan) summaryParts.push(bahan);
			if (proses) summaryParts.push(proses);
			if (warna) summaryParts.push(warna);
			if (ukuran) summaryParts.push(`(Size: ${ukuran})`);

			return {
				divisi, kategori, bahan, proses, warna, ukuran,
				summary: summaryParts.length > 0 ? summaryParts.join(" • ") : (rawName || "Produk Batik")
			};
		}

		function getMotifLetter(idx) {
			return "Motif " + String.fromCharCode(65 + (idx % 26));
		}

		function getRowPhotoGroupKey(row) {
			const motifSelect = row.querySelector(".v-motif-select");
			const motif = motifSelect?.value || "Motif A";
			const sleeveSelect = row.querySelector(".v-sleeve-select");
			const sleeve = sleeveSelect?.value || "-";
			return (sleeve && sleeve !== "-") ? `${motif}___${sleeve}` : motif;
		}

		// --- WATERMARK & CANVAS GENERATOR ---
		function createWatermarkedDataUrl(file, callback) {
			const reader = new FileReader();
			reader.onload = (e) => {
				const img = new Image();
				img.onload = () => {
					const canvas = document.createElement("canvas");
					const ctx = canvas.getContext("2d");
					const maxDim = 1200;
					let w = img.width;
					let h = img.height;
					if (w > maxDim || h > maxDim) {
						if (w > h) { h = Math.round((h * maxDim) / w); w = maxDim; }
						else { w = Math.round((w * maxDim) / h); h = maxDim; }
					}
					canvas.width = w;
					canvas.height = h;
					ctx.drawImage(img, 0, 0, w, h);

					const logoUrl = document.getElementById("setting_logo_url")?.value;
					const itemCode = document.getElementById("product_item_code_input")?.value || document.getElementById("product_sku_input")?.value || "";

					const finalize = () => {
						const dataUrl = canvas.toDataURL("image/webp", 0.85);
						canvas.toBlob((blob) => {
							const processedFile = blob ? new File([blob], file.name.replace(/\.[^/.]+$/, "") + ".webp", { type: "image/webp" }) : file;
							callback(dataUrl, processedFile);
						}, "image/webp", 0.85);
					};

					const drawTextBadge = () => {
						if (itemCode) {
							const fontSize = Math.max(Math.round(h * 0.022), 14);
							ctx.font = `bold ${fontSize}px sans-serif`;
							ctx.textAlign = "right";
							ctx.fillStyle = "rgba(0,0,0,0.6)";
							ctx.fillText(itemCode, w - Math.round(w * 0.04) + 1, h - Math.round(h * 0.05) + 1);
							ctx.fillStyle = "white";
							ctx.fillText(itemCode, w - Math.round(w * 0.04), h - Math.round(h * 0.05));
						}
						finalize();
					};

					if (logoUrl) {
						const logo = new Image();
						logo.crossOrigin = "anonymous";
						logo.onload = () => {
							const logoW = Math.round(w * 0.18);
							const logoH = Math.round((logo.height * logoW) / logo.width);
							const margin = Math.round(w * 0.04);
							ctx.drawImage(logo, w - logoW - margin, margin, logoW, logoH);
							drawTextBadge();
						};
						logo.onerror = drawTextBadge;
						logo.src = logoUrl;
					} else {
						drawTextBadge();
					}
				};
				img.src = e.target.result;
			};
			reader.readAsDataURL(file);
		}

		function showFullscreenImageModal(src) {
			let modal = document.getElementById("fullscreenImageModal");
			if (!modal) {
				modal = document.createElement("div");
				modal.id = "fullscreenImageModal";
				modal.style.cssText = "display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.85); z-index: 9999999; align-items: center; justify-content: center; padding: 2rem;";
				modal.innerHTML = `
					<div style="position: relative; max-width: 90vw; max-height: 90vh;">
						<img id="fullscreenImageSrc" style="max-width: 100%; max-height: 90vh; border-radius: 8px; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5);" />
						<button type="button" id="btnCloseFullscreenImage" style="position: absolute; top: -14px; right: -14px; background: white; border: none; border-radius: 50%; width: 32px; height: 32px; font-weight: 800; cursor: pointer; box-shadow: 0 4px 6px rgba(0,0,0,0.3);">&times;</button>
					</div>
				`;
				document.body.appendChild(modal);
				modal.querySelector("#btnCloseFullscreenImage")?.addEventListener("click", () => { modal.style.display = "none"; });
				modal.addEventListener("click", (e) => { if (e.target === modal) modal.style.display = "none"; });
			}
			const imgEl = modal.querySelector("#fullscreenImageSrc");
			if (imgEl) imgEl.src = src;
			modal.style.display = "flex";
		}

