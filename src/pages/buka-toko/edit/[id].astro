								<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.3rem;">
									<label class="text-uppercase" style="font-size: 0.65rem; font-weight: 700; color: #64748b; margin: 0;">Kode Barcode POS (Lengkap)</label>
									<span style="font-size: 0.62rem; color: #b45309; font-weight: 700;">AKUNTANSI / POS</span>
								</div>
								<input name="pos_code" id="product_pos_code_input" type="text" value={product.code || ""} placeholder="WI0SP0JED99020311" style="width: 100%; padding: 0.7rem; border: 1.5px solid #fde047; border-radius: 6px; font-family: monospace; font-weight: 700; color: #854d0e; background: #fefce8;" />
							</div>
							<div>
								<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.3rem;">
