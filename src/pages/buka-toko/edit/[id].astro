							<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem; flex-wrap: wrap; gap: 0.4rem;">
								<label class="text-uppercase" style="font-size: 0.72rem; font-weight: 800; color: #1e293b; margin: 0;">Motif Batik</label>
								<button type="button" id="btnDeselectAllMotifs" style="font-size: 0.65rem; color: #64748b; background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 4px; padding: 2px 6px; cursor: pointer;">Reset Pilihan</button>
