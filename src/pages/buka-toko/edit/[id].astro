				}
				const mainPrice = document.getElementById("product_price_input")?.value;
				const promptVal = prompt(`Masukkan harga jual (Rp) untuk ${checkedRows.length} varian yang dicentang [✓]:`, mainPrice || "");
				if (promptVal !== null) {
					const num = parseInt(promptVal.replace(/\D/g, ""), 10) || 0;
					checkedRows.forEach(row => {
						const disp = row.querySelector(".v-price-display");
						const hdn = row.querySelector(".v-price-hidden");
						if (hdn) hdn.value = num;
						if (disp) disp.value = num ? num.toLocaleString("id-ID") : "";
					});
				}
			});

			// Apply Furing to Checked Rows
			document.getElementById("btnBatchFuring")?.addEventListener("click", () => {
				const checkedRows = Array.from(document.querySelectorAll(".counter-table-row")).filter(r => r.querySelector(".v-counter-cb")?.checked);
				if (checkedRows.length === 0) {
					alert("Silakan centang [✓] varian counter yang ingin diatur furingnya terlebih dahulu.");
					return;
				}
				checkedRows.forEach(row => {
					const sel = row.querySelector(".v-dalaman-select");
					if (sel) sel.value = "F";
				});
			});

			// Batch Dalaman Select
			document.getElementById("btnApplyBatchDalaman")?.addEventListener("click", () => {
				const val = document.getElementById("globalBatchDalamanSelect")?.value;
				document.querySelectorAll(".counter-table-row").forEach(row => {
					if (row.querySelector(".v-counter-cb")?.checked) {
						const sel = row.querySelector(".v-dalaman-select");
						if (sel) { sel.value = val; sel.dispatchEvent(new Event("change")); }
					}
				});
			});

			// Tambah Baris Manual
			document.getElementById("btnAddManualCounterRow")?.addEventListener("click", () => {
				const currentRows = document.querySelectorAll(".counter-table-row");
				const nextIdx = currentRows.length;
				const mainItem = {
					name: document.getElementById("product_name_input")?.value,
					price: document.getElementById("product_price_input")?.value,
					code: document.getElementById("product_sku_input")?.value,
				};
				const newDetail = {
					counter: `CTR-${nextIdx + 1}`,
					outlet: "Gudang",
					motif: getMotifLetter(nextIdx),
					size_name: "ALL SIZE",
					price: mainItem.price || 0,
					stock: 1,
					dalaman: "",
				};

				renderCounterRows([...Array.from(currentRows).map((r, i) => ({
					counter: r.querySelector(".v-counter-hidden")?.value || `CTR-${i+1}`,
					outlet: r.querySelector(".v-outlet-hidden")?.value || "Gudang",
					motif: r.querySelector(".v-motif-select")?.value || getMotifLetter(i),
					size_name: r.querySelector(".v-size-select")?.value || "ALL SIZE",
					fit: r.querySelector(".v-fit-select")?.value || "REG",
					sleeve: r.querySelector(".v-sleeve-select")?.value || "-",
					price: r.querySelector(".v-price-hidden")?.value || mainItem.price || 0,
					stock: r.querySelector(".v-stock-input")?.value || 1,
					dalaman: r.querySelector(".v-dalaman-select")?.value || "",
					sku: r.querySelector(".v-sku-hidden")?.value || "",
					image_url: r.querySelector(".v-photo-url-hidden")?.value || "",
				})), newDetail], mainItem);
			});
		}

		function setupDescGenerator() {
			const btn = document.getElementById("btn_generate_desc");
			const descInput = document.getElementById("description_input");
			const nameInput = document.getElementById("product_name_input");

			if (btn && descInput) {
				btn.addEventListener("click", async () => {
					const title = nameInput?.value.trim();
					if (!title) {
						alert("Silakan isi nama produk terlebih dahulu.");
						return;
					}
					btn.disabled = true;
					btn.innerHTML = "<span>✨ Menulis...</span>";

					try {
						const res = await fetch(`${publicApiUrl}/generate-description`, {
							method: "POST",
							headers: { "Content-Type": "application/json", "Accept": "application/json" },
							body: JSON.stringify({ name: title })
						});
						const json = await res.json();
						if (json && json.description) {
							descInput.value = json.description;
						} else {
							descInput.value = `Koleksi istimewa ${title}. Dibuat dari material batik berkualitas tinggi dengan pengerjaan teliti dan bahan yang nyaman dipakai. Cocok untuk acara formal maupun kasual.`;
						}
					} catch (e) {
						descInput.value = `Koleksi eksklusif ${title}. Desain motif batik tradisional elegan dengan potongan modern yang nyaman dan pas di tubuh.`;
					} finally {
						btn.disabled = false;
						btn.innerHTML = "<span>✨ Tulis dengan Gemini</span>";
					}
				});
			}
		}

		function setupFormSubmitLoading() {
			const form = document.getElementById("counterProductForm");
			const modal = document.getElementById("confirmSaveModal");
			const btnProceed = document.getElementById("btnProceedSubmitProduct");
			const btnCancel = document.getElementById("btnCancelConfirmModal");
			const btnCancelTop = document.getElementById("btnCancelConfirmModalTop");

			let isConfirmed = false;
			let isSubmitting = false;

			const closeModal = () => { if (modal) modal.style.display = "none"; };
			btnCancel?.addEventListener("click", closeModal);
			btnCancelTop?.addEventListener("click", closeModal);

			btnProceed?.addEventListener("click", (e) => {
				e.preventDefault();
				if (isSubmitting) return;
				isSubmitting = true;
				isConfirmed = true;

				if (btnProceed) {
					btnProceed.disabled = true;
					btnProceed.innerHTML = "⏳ Menyimpan...";
					btnProceed.style.opacity = "0.6";
				}

				const overlay = document.getElementById("loadingOverlay");
				if (overlay) overlay.style.display = "flex";

				closeModal();
				if (form) form.requestSubmit();
			});

			if (form) {
				form.addEventListener("submit", (e) => {
					const activeCheckboxes = Array.from(document.querySelectorAll(".v-counter-cb:checked"));
					if (activeCheckboxes.length === 0) {
						e.preventDefault();
						alert("⚠️ Harap pilih minimal 1 counter/varian untuk disimpan!");
						return;
					}

					if (!isConfirmed) {
						e.preventDefault();

						const allRows = Array.from(document.querySelectorAll(".counter-table-row"));
						const activeRows = allRows.filter(r => r.querySelector(".v-counter-cb")?.checked);
						const activeCount = activeRows.length;
						const totalCount = allRows.length;
						const uncheckedCount = totalCount - activeCount;

						const nameVal = document.getElementById("product_name_input")?.value || "Produk";
						const elProdName = document.getElementById("confirmModalProductName");
						if (elProdName) elProdName.textContent = nameVal;

						const elActiveCount = document.getElementById("confirmModalActiveCount");
						if (elActiveCount) elActiveCount.textContent = activeCount.toString();

						const elTotalStr = document.getElementById("confirmModalTotalCounterStr");
						if (elTotalStr) elTotalStr.textContent = `dari ${totalCount} counter`;

						let totalStock = 0;
						const motifCounts = new Map();

						activeRows.forEach(row => {
							const stockInp = row.querySelector(".v-stock-input");
							const stockVal = stockInp ? parseInt(stockInp.value || "1", 10) || 0 : 1;
							totalStock += stockVal;

							const motifSelect = row.querySelector(".v-motif-select");
							const motifVal = motifSelect ? motifSelect.value : "Motif A";
							motifCounts.set(motifVal, (motifCounts.get(motifVal) || 0) + 1);
						});

						const elBreakdown = document.getElementById("confirmModalMotifsBreakdown");
						if (elBreakdown) {
							elBreakdown.innerHTML = Array.from(motifCounts.entries())
								.map(([mName, mCount]) => `
									<span style="background: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; font-weight: 700; padding: 3px 8px; border-radius: 4px; font-size: 0.72rem;">
										🎨 ${mName}: <strong>${mCount} varian</strong>
									</span>
								`).join('');
						}

						const elWarn = document.getElementById("confirmModalUncheckedWarning");
						const elUncheckedCount = document.getElementById("confirmModalUncheckedCount");
						if (elWarn && elUncheckedCount) {
							if (uncheckedCount > 0) {
								elUncheckedCount.textContent = uncheckedCount.toString();
								elWarn.style.display = "block";
							} else {
								elWarn.style.display = "none";
							}
						}

						if (modal) modal.style.display = "flex";
						return;
					}

					// Synchronize files to row inputs before submit
					document.querySelectorAll(".counter-table-row").forEach(row => {
						const isChecked = row.querySelector(".v-counter-cb")?.checked;
						if (!isChecked) return;
						const key = getRowPhotoGroupKey(row);
						const motif = row.querySelector(".v-motif-select")?.value;
						const fileInp = row.querySelector(".v-row-file-input");
						const photoHidden = row.querySelector(".v-photo-url-hidden");

						const data = (key && motifPhotoStore.has(key)) ? motifPhotoStore.get(key) : (motif && motifPhotoStore.has(motif) ? motifPhotoStore.get(motif) : null);
						if (data) {
							if (data.file && fileInp && window.DataTransfer) {
								try {
									const dt = new DataTransfer();
									dt.items.add(data.file);
									fileInp.files = dt.files;
								} catch(err) {}
							}
							if (photoHidden && data.previewUrl && !photoHidden.value) {
								photoHidden.value = data.previewUrl;
							}
						}
					});

					const overlay = document.getElementById("loadingOverlay");
					if (overlay) overlay.style.display = "flex";

					const submitBtn = document.getElementById("btnSubmitProduct");
					if (submitBtn) {
						submitBtn.disabled = true;
						submitBtn.style.opacity = "0.6";
						submitBtn.textContent = "Sedang Menyimpan...";
					}
				});
			}
		}

		// Delete button trigger
		document.getElementById("btnDeleteProductTrigger")?.addEventListener("click", () => {
			const deleteForm = document.getElementById("deleteProductForm");
			if (deleteForm && typeof window.showDeleteConfirm === "function") {
				window.showDeleteConfirm(deleteForm, "Apakah Anda yakin ingin menghapus produk ini secara permanen dari katalog?");
			} else if (confirm("Apakah Anda yakin ingin menghapus produk ini secara permanen?")) {
				deleteForm?.submit();
			}
		});

		// Live Sync POS button
		document.getElementById("btn-sync-pos-live")?.addEventListener("click", async () => {
			const btn = document.getElementById("btn-sync-pos-live");
			const itemCode = document.getElementById("product_item_code_input")?.value || document.getElementById("product_sku_input")?.value;
			if (!itemCode) {
				alert("Kode item atau SKU belum terisi.");
				return;
			}
			if (btn) {
				btn.disabled = true;
				btn.innerHTML = "⏳ Menarik POS...";
			}

			try {
				// Ambil data produk aktif dari endpoint POS Noir /api/v1/produk
				let res = await fetch(`https://noir.grace.gracianna.web.id/api/v1/produk?q=${encodeURIComponent(itemCode)}`);
				let json = await res.json();
				let list = Array.isArray(json) ? json : (json.data?.data || json.data || []);

				// Fallback ke praProdukV2 jika tidak ditemukan di endpoint produk
				if (!list || list.length === 0) {
					res = await fetch(`https://noir.grace.gracianna.web.id/api/v1/praProdukV2?per_page=12&q=${encodeURIComponent(itemCode)}`);
					json = await res.json();
					list = Array.isArray(json) ? json : (json.data?.data || json.data || []);
				}

				const matched = list.find(p => p.kodeitem && p.kodeitem.toUpperCase() === itemCode.toUpperCase()) || list[0];

				if (matched) {
					const alertBox = document.getElementById("pos-sync-alert-box");
					const alertText = document.getElementById("pos-sync-alert-text");
					const detailsCount = Array.isArray(matched.details) ? matched.details.length : 1;

					if (alertBox && alertText) {
						alertText.textContent = `Ditemukan data produk POS: ${matched.nama || matched.kodeitem} dengan ${detailsCount} counter/outlet.`;
						alertBox.style.display = "flex";

						document.getElementById("btn-apply-pos-sync")?.addEventListener("click", () => {
							if (matched.id) {
								const mainPraInput = document.getElementById("main_praproduk_id_input");
								if (mainPraInput) mainPraInput.value = matched.id;
								const idBadge = document.getElementById("master-pos-id");
								if (idBadge) idBadge.textContent = `#${matched.id}`;
							}
							if (matched.kode || matched.counter) {
								const barcodeBadge = document.getElementById("master-pos-barcode");
								if (barcodeBadge) barcodeBadge.textContent = matched.kode || matched.counter;
							}
							if (matched.kodeitem) {
								const modelBadge = document.getElementById("master-pos-model");
								if (modelBadge) modelBadge.textContent = matched.kodeitem;
							}
							if (matched.nama) {
								const namaBadge = document.getElementById("master-pos-nama");
								if (namaBadge) namaBadge.textContent = matched.nama;
							}

							if (matched.details && Array.isArray(matched.details) && matched.details.length > 0) {
								renderCounterRows(matched.details, matched);
							}
							alertBox.style.display = "none";
						}, { once: true });
					}
				} else {
					alert(`Tidak ditemukan data barang POS untuk kata kunci '${itemCode}'.`);
				}
			} catch (err) {
				console.error("Gagal sinkron POS:", err);
				alert("Terjadi kendala koneksi ke API POS Noir.");
			} finally {
				if (btn) {
					btn.disabled = false;
					btn.innerHTML = "<span>⚡ Tarik Ulang Data POS</span>";
				}
			}
		});

		// --- DOMContentLoaded INITIAL HYDRATION ---
		document.addEventListener("DOMContentLoaded", () => {
			setupCategoryDropdown();
			setupPriceMasking();
			setupBatchControls();
			setupDescGenerator();
			setupFormSubmitLoading();

			// Parse Product Initial Data
			const rawJson = document.getElementById("initial-product-data")?.textContent;
			let localProduct = null;
			if (rawJson) {
				try {
					localProduct = JSON.parse(rawJson);
				} catch (e) {
					console.error("Error parse initial product data:", e);
				}
			}

			if (localProduct) {
				// Master POS reference badge
				const posDecoded = decodePosItemInfo(localProduct);
				const refPosType = document.getElementById("ref-pos-type-val");
				if (refPosType) refPosType.textContent = posDecoded.summary;

				const detectedRow = document.getElementById("detected-type-info-row");
				const detectedText = document.getElementById("detected-type-info-text");
				if (detectedRow && detectedText) {
					detectedText.innerHTML = `<strong>Tipe Terdeteksi dari Barcode POS:</strong> ${posDecoded.summary}`;
					detectedRow.style.display = "flex";
				}

				// Categories
				autoDetectAndSelectCategories(localProduct);

				// Motifs Checkboxes
				const selectedMotifIds = (localProduct.motifs || localProduct.product_motifs || []).map(m => String(m.id || m.motif_id));
				document.querySelectorAll("#motif-grid input[name='motif_ids']").forEach(cb => {
					if (selectedMotifIds.includes(String(cb.value))) {
						cb.checked = true;
					}
				});

				// Colors Checkboxes
				const selectedColors = (localProduct.colors || []).map(c => String(c).trim().toLowerCase());
				document.querySelectorAll("#color-grid input[name='colors']").forEach(cb => {
					if (selectedColors.includes(String(cb.value).trim().toLowerCase())) {
						cb.checked = true;
					}
				});

				// Pre-populate motifPhotoStore with product images
				const prodImages = localProduct.images || (localProduct.image_url ? [localProduct.image_url] : []);
				prodImages.forEach((imgUrl, i) => {
					const mLetter = getMotifLetter(i);
					if (imgUrl && !motifPhotoStore.has(mLetter)) {
						motifPhotoStore.set(mLetter, {
							file: null,
							previewUrl: imgUrl,
							isCustom: false
						});
					}
				});

				// Variants Table
				const variantsArr = localProduct.variants || localProduct.product_variants || [];
				if (Array.isArray(variantsArr) && variantsArr.length > 0) {
					renderCounterRows(variantsArr, localProduct);
				} else {
					// Fallback to single row
					renderCounterRows([{
						counter: localProduct.code || "01",
						outlet: "Gudang",
						motif: "Motif A",
						size_name: "ALL SIZE",
						price: localProduct.price || 0,
						stock: localProduct.total_stock || 1,
						dalaman: "",
						image_url: localProduct.image_url || null
					}], localProduct);
				}
			}
		});
	</script>
	<ImageCropModal />
	<DeleteConfirmModal />
</Layout>
