	<script is:inline define:vars={{ publicApiUrl, typesListServer: hierarchicalTypes, motifsListServer: motifs, sizesListServer: sizesData, colorsListServer: colorsData }}>
		const BASE_PHOTO_URL = "https://noir.grace.gracianna.web.id/foto/";
		const BASE_PHOTO_URL_FALLBACK = "https://noir.grace.gracianna.web.id/storage/";
		const BASE_PHOTO_URL_IMAGES = "https://noir.grace.gracianna.web.id/images/";

		const hierarchicalTypes = typesListServer || [];
		const motifsMasterList = Array.from({ length: 26 }, (_, i) => "Motif " + String.fromCharCode(65 + i));

		const standardSizesList = [
			"ALL SIZE", "XS", "S", "M", "L", "XL", "XXL", "3XL", "4XL", "5XL",
			"2L", "3L", "4L", "5L", "6L", "7L"
		];

		// Global store for uploaded files & previews per motif: motifName -> { file: File|null, previewUrl: string, isCustom: boolean }
		const motifPhotoStore = new Map();
		let activeTargetMotif = null;

		function cleanSize(rawSize, rawKode) {
			if (rawKode && rawKode.length >= 3) {
				const char3 = rawKode.charAt(2).toUpperCase();
				const sizeCodeMap = {
					'0': 'ALL SIZE', 'S': 'S', 'M': 'M', 'L': 'L', 'X': 'XL', 'Y': 'XXL',
					'2': '2L', '3': '3L', '4': '4L', '5': '5L', '6': '6L', '7': '7L'
				};
				if (sizeCodeMap[char3]) return sizeCodeMap[char3];
			}
			if (!rawSize) return "ALL SIZE";
			let s = String(rawSize).trim().toUpperCase();
			if (s === "00" || s === "0" || s === "ALL" || s === "ALLSIZE" || s === "ALL SIZE" || s === "-") {
				return "ALL SIZE";
			}
			s = s.replace(/\bSF\b/g, "").replace(/\bSLIM FIT\b/g, "").replace(/\bSLIM\b/g, "").trim();
			if (s.includes("-")) {
				const parts = s.split("-").map(p => p.trim());
				for (const p of parts) {
					if (standardSizesList.includes(p)) return p;
				}
			}
			if (standardSizesList.includes(s)) {
				return s;
			}
			for (const sz of ["7L", "6L", "5L", "4L", "3L", "2L", "5XL", "4XL", "3XL", "XXL", "XL", "XS", "L", "M", "S"]) {
				const regex = new RegExp(`\\b${sz}\\b`, 'i');
				if (regex.test(s)) return sz;
			}
			return s || "ALL SIZE";
		}

		const NOIR_TIPE_MAP = {
			t1: {
				L: "LADYS", M: "MAN", A: "ASESORIS", T: "TAS", J: "JAM", K: "KOSMETIK",
				S: "SEPATU", D: "SANDAL", E: "DOMPET", W: "WANITA", Y: "YUAN-YUAN",
				X: "KONSI", I: "KAIN", R: "SARIMBIT", G: "GULUNGAN", C: "METERAN", P: "KPJ"
			},
			t2: {
				K: { name: "KEMEJA", targetL1: "Kemeja", isAccessory: false },
				B: { name: "BLUES", targetL1: "Blues", isAccessory: false },
				P: { name: "DRESS", targetL1: "Dress", isAccessory: false },
				G: { name: "GAUN", targetL1: "Gaun", isAccessory: false },
				X: { name: "GAMIS", targetL1: "Gamis", isAccessory: false },
				R: { name: "ROK", targetL1: "Rok", isAccessory: false },
				C: { name: "CELANA", targetL1: "Celana", isAccessory: false },
				E: { name: "LEGGING", targetL1: "Legging", isAccessory: false },
				F: { name: "SARUNG", targetL1: "Sarung", isAccessory: false },
				O: { name: "OUTER", targetL1: "Outer", isAccessory: false },
				J: { name: "JAKET", targetL1: "Jaket", isAccessory: false },
				A: { name: "JAS", targetL1: "Jas", isAccessory: false },
				V: { name: "KEBAYA", targetL1: "Kebaya", isAccessory: false },
				S: { name: "STELAN", targetL1: "Setelan", isAccessory: false },
				U: { name: "JUMPSUIT", targetL1: "Jumpsuit", isAccessory: false },
				T: { name: "T - SHIRT", targetL1: "T - Shirt", isAccessory: false },
				N: { name: "TANK TOP", targetL1: "Tank Top", isAccessory: false },
				M: { name: "SARIMBIT", targetL1: "Sarimbit", isAccessory: false },
				L: { name: "SYAL", targetL1: "Accessories", isAccessory: true, subName: "Syal" },
				H: { name: "SELENDANG", targetL1: "Accessories", isAccessory: true, subName: "Selendang" },
				Q: { name: "KLG/ANTG", targetL1: "Accessories", isAccessory: true, subName: "Kalung / Anting" },
				W: { name: "BROS", targetL1: "Accessories", isAccessory: true, subName: "Bros" },
				I: { name: "TOPI", targetL1: "Accessories", isAccessory: true, subName: "Topi" },
				D: { name: "SABUK", targetL1: "Accessories", isAccessory: true, subName: "Sabuk" }
			},
			t3: {
				T: { name: "KATUN", targetL2: "Katun" },
				G: { name: "SUTRA", targetL2: "Sutra" },
