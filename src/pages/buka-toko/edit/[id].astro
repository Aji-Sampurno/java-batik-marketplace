---
export const prerender = false;
import Layout from "../../../layouts/Layout.astro";
import { apiFetch, uploadToLaravel } from "../../../lib/api";
import { uploadToFirebase } from "../../../lib/firebase";
import { getWatermarkLogoBuffer, getWatermarkFontBase64 } from "../../../lib/watermarkAssets";
import ImageCropModal from "../../../components/ImageCropModal.astro";
import DeleteConfirmModal from "../../../components/DeleteConfirmModal.astro";
import sharp from "sharp";

// 1. Check for session (Authentication Gate)
const session = Astro.cookies.get("admin_session");
if (session?.value !== "authenticated") {
	return Astro.redirect("/login");
}

const { id } = Astro.params;
const publicApiUrl = import.meta.env.PUBLIC_API_URL || "https://katalog.javabatikgallery.com/api";

let product: any = null;
let types: any[] = [];
let motifs: any[] = [];
let sizesData: any[] = [];
let colorsData: any[] = [];
let settings: any = null;
let message = "";
let isError = false;

try {
	// Fetch product data
	const pRes = await apiFetch<any>(`products/${id}`);
	product = pRes?.data || pRes;

	// Fetch Types, Motifs, Sizes, Colors, Settings
	const tRes = await apiFetch<any>("types");
	types = tRes?.data || tRes || [];

	const mRes = await apiFetch<any>("motifs");
	motifs = mRes?.data || mRes || [];

	const szRes = await apiFetch<any>("sizes");
	sizesData = (szRes?.data || szRes || []).filter((s: any) => {
		const name = (s.name || "").trim().toUpperCase();
		return !name.endsWith(" SF") && !name.includes("LENGAN");
	});

	const colRes = await apiFetch<any>("colors");
	colorsData = colRes?.data || colRes || [];

	// Sort sizes
	const sizeOrder = [
		"ALL SIZE", "XS", "S", "M", "L", "XL", "XXL", "2XL", "3XL", "4XL", "5XL", "6XL"
	];
	sizesData.sort((a, b) => {
		const nameA = (a.name || "").trim().toUpperCase();
		const nameB = (b.name || "").trim().toUpperCase();
		let idxA = sizeOrder.indexOf(nameA);
		let idxB = sizeOrder.indexOf(nameB);
		if (idxA === -1) idxA = 999;
		if (idxB === -1) idxB = 999;
		return idxA - idxB;
	});

	const sRes = await apiFetch<any>("settings");
	settings = sRes?.data || sRes || { site_name: "Batik Nusantara" };
} catch (e: any) {
	console.error("API Fetch Error:", e.message);
}

if (!product) {
	return Astro.redirect("/buka-toko");
}

// Color Palette Swatch Mapping & Formatting Helpers
const COLOR_PALETTE: Record<string, string> = {
	"coklat": "#78350f",
	"soga": "#92400e",
	"sogan": "#92400e",
	"abu-abu": "#64748b",
	"abu": "#64748b",
	"grey": "#64748b",
	"gray": "#64748b",
	"ungu": "#7c3aed",
	"purple": "#7c3aed",
	"kuning": "#eab308",
	"yellow": "#eab308",
	"biru": "#2563eb",
	"blue": "#2563eb",
	"navy": "#1e3a8a",
	"hitam": "#0f172a",
	"black": "#0f172a",
	"kombinasi": "linear-gradient(135deg, #ef4444 0%, #3b82f6 50%, #10b981 100%)",
	"multicolor": "linear-gradient(135deg, #ef4444 0%, #3b82f6 50%, #10b981 100%)",
	"hijau": "#16a34a",
	"green": "#16a34a",
	"krem": "#fef08a",
	"cream": "#fef08a",
	"merah": "#dc2626",
	"red": "#dc2626",
	"maroon": "#881337",
	"maron": "#881337",
	"putih": "#ffffff",
	"white": "#ffffff",
	"oranye": "#ea580c",
	"orange": "#ea580c",
	"gold": "#d97706",
	"emas": "#d97706",
	"merah muda": "#ec4899",
	"pink": "#ec4899",
	"tosca": "#0d9488",
	"toska": "#0d9488",
	"turquoise": "#0d9488",
	"silver": "#94a3b8",
	"perak": "#94a3b8",
	"denim": "#3b82f6",
	"khaki": "#a8a29e",
	"terrakota": "#c2410c",
	"terracotta": "#c2410c",
	"magenta": "#c026d3",
	"peach": "#fb923c",
	"salem": "#f472b6"
};

const getColorHex = (c: any): string => {
	if (c && c.hex && typeof c.hex === "string" && c.hex.startsWith("#")) return c.hex;
	const name = ((c && typeof c === "object" ? c.name : c) || "").trim().toLowerCase();
	return COLOR_PALETTE[name] || "#94a3b8";
};

const formatColorTitle = (name: string): string => {
	if (!name) return "";
	return name
		.split(" ")
		.map((w: string) => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase())
		.join(" ");
};

// Hierarchical Helper: Sort categories into a flat list with levels
const buildCategoryTree = (list: any[], parentId = null, depth = 0): any[] => {
	let result: any[] = [];
	list.filter((item) => item.parent_id === parentId).forEach((item) => {
		result.push({ ...item, depth });
		const children = buildCategoryTree(list, item.id, depth + 1);
		result = result.concat(children);
	});
	return result;
};

const hierarchicalTypes = buildCategoryTree(types);

// Handle Form Submission (Server Side)
if (Astro.request.method === "POST") {
	const contentType = Astro.request.headers.get("content-type");
	if (contentType?.includes("form")) {
		try {
			const formData = await Astro.request.formData();
			const action = formData.get("action");

			// Action: Delete Product
			if (action === "delete_product") {
				await apiFetch(`products/${id}`, { method: "DELETE" });
				return Astro.redirect("/buka-toko?success=delete");
			}

			// Action: Edit Product
			if (action === "edit_product") {
				const name = formData.get("name");
				const price = formData.get("price");
				const raw_category_ids = formData.getAll("category_ids");
				const category_chain = formData.getAll("category_chain");
				const motif_ids = formData.getAll("motif_ids");
				const colors = formData.getAll("colors");
				const description = formData.get("description");
				const code = formData.get("code");
				const tokopedia_url = formData.get("tokopedia_url");
				const original_price = formData.get("original_price");
				const item_code = formData.get("item_code");
				const is_active = formData.get("is_active") === "off" ? false : true;

				// Resolve categories: Check or create custom category
				let resolvedCategoryIds: string[] = [];
				let resolvedL1Id: string | null = null;

				for (let i = 0; i < raw_category_ids.length; i++) {
					const catVal = String(raw_category_ids[i]).trim();
					if (!catVal) continue;

					const existingType = types.find((t: any) => String(t.id) === catVal);
					if (existingType) {
						resolvedCategoryIds.push(existingType.id);
						if (i === 0) resolvedL1Id = existingType.id;
					} else {
						const matchedByName = types.find((t: any) => (t.name || "").trim().toLowerCase() === catVal.toLowerCase());
						if (matchedByName) {
							resolvedCategoryIds.push(matchedByName.id);
							if (i === 0) resolvedL1Id = matchedByName.id;
						} else {
							try {
								const parent_id: string | null = i === 0 ? null : (resolvedL1Id || null);
								const newTypeRes: any = await apiFetch<any>("types", {
									method: "POST",
									body: JSON.stringify({ name: catVal, parent_id }),
								});
								const newId: any = newTypeRes?.data?.id || newTypeRes?.id;
								if (newId) {
									resolvedCategoryIds.push(newId);
									if (i === 0) resolvedL1Id = newId;
									types.push({ id: newId, name: catVal, parent_id });
								}
							} catch (createTypeErr) {
								console.error("Gagal auto-create type baru:", catVal, createTypeErr);
							}
						}
					}
				}

				const category_ids = resolvedCategoryIds;
				const type_id = category_ids[0] || null;

				// Variant Arrays
				const variant_motif_names = formData.getAll("variant_motif_name") as string[];
				const variant_image_files = formData.getAll("variant_image_file") as File[];
				const variant_image_urls = formData.getAll("variant_image_url") as string[];
				const variant_sizes = formData.getAll("variant_size") as string[];
				const variant_counters = formData.getAll("variant_counter") as string[];
				const variant_outlets = formData.getAll("variant_outlet") as string[];
				const variant_fits = formData.getAll("variant_fit") as string[];
				const variant_sleeves = formData.getAll("variant_sleeve") as string[];
				const variant_skus = formData.getAll("variant_sku") as string[];
				const variant_prices = formData.getAll("variant_price") as string[];
				const variant_stocks = formData.getAll("variant_stock") as string[];
				const variant_dalamans = formData.getAll("variant_dalaman") as string[];

				const selectedType = hierarchicalTypes.find((t: any) => t.id === type_id) || types.find((t: any) => t.id === type_id);
				let jenisProduk = "umum";
				if (selectedType && selectedType.name) {
					jenisProduk = selectedType.name
						.toLowerCase()
						.replace(/[^a-z0-9]+/g, "-")
						.replace(/(^-|-$)+/g, "");
				} else if (name) {
					const firstWord = name.toString().trim().split(/\s+/)[0].toLowerCase();
					if (firstWord) {
						jenisProduk = firstWord.replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)+/g, "");
					}
				}
				if (!jenisProduk) jenisProduk = "umum";

				// Fetch logo buffer & font base64 for watermarking
				let logoBuffer: Buffer | null = null;
				let fontBase64 = "";
				try {
					logoBuffer = getWatermarkLogoBuffer();
					fontBase64 = getWatermarkFontBase64();
				} catch (e) {
					console.error("Failed to load assets for watermark", e);
				}

				// -------------------------------------------------------------
				// DEDUPLICATE IMAGES BY MOTIF & SLEEVE
				// -------------------------------------------------------------
				const motifImagesMap = new Map<string, { file: File | null, existingUrl: string }>();

				variant_motif_names.forEach((motif, idx) => {
					const file = variant_image_files[idx];
					const rawExistingUrl = (variant_image_urls[idx] || "").trim();
					const existingUrl = (rawExistingUrl && !rawExistingUrl.startsWith("blob:") && (rawExistingUrl.startsWith("http://") || rawExistingUrl.startsWith("https://"))) ? rawExistingUrl : "";
					const sleeve = variant_sleeves[idx];
					const cleanMotif = (motif || `Motif-${idx}`).trim();
					const cleanKey = (sleeve && sleeve !== "-") ? `${cleanMotif}___${sleeve}` : cleanMotif;

					if (!motifImagesMap.has(cleanKey)) {
						motifImagesMap.set(cleanKey, {
							file: (file && file.size > 0) ? file : null,
							existingUrl
						});
					} else {
						const current = motifImagesMap.get(cleanKey)!;
						if (!current.file && file && file.size > 0) {
							motifImagesMap.set(cleanKey, { file, existingUrl: current.existingUrl || existingUrl });
						}
					}
				});

				let images: string[] = [];
				let raw_images: string[] = [];
				let motifIdx = 0;
				const motifFinalUrlMap = new Map<string, string>();

				for (const [motifKey, imgData] of motifImagesMap.entries()) {
					motifIdx++;
					let finalMotifUrl = "";

					if (imgData.file && imgData.file.size > 0) {
						const file = imgData.file;
						const actualCode = (item_code || code || "PRODUK").toString().trim().replace(/[^a-zA-Z0-9_\-]/g, '') || "PRODUK";
						const cleanMotifTag = motifKey.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)+/g, '') || `motif-${motifIdx}`;
						const timestamp = Date.now();

						// 1. Process & Compress Raw Image to WebP (No Watermark) and Upload to Firebase
						let rawWebpBuffer: Buffer;
						try {
							rawWebpBuffer = await sharp(Buffer.from(await file.arrayBuffer()))
								.webp({ quality: 85 })
								.toBuffer();
						} catch (e) {
							console.error("Raw WebP compression error:", e);
							rawWebpBuffer = Buffer.from(await file.arrayBuffer());
						}

						const rawCustomName = `${actualCode}_${cleanMotifTag}_raw_${timestamp}_${motifIdx}.webp`;
						const rawFileToUpload = new File([new Uint8Array(rawWebpBuffer)], rawCustomName, { type: "image/webp" });

						let rawPublicUrl = "";
						const fbPathRaw = `products/${jenisProduk}/${actualCode}/${cleanMotifTag}/raw/${rawCustomName}`;
						try {
							rawPublicUrl = await uploadToFirebase(rawFileToUpload, fbPathRaw);
							console.log(`[Firebase Raw] Upload success -> ${rawPublicUrl}`);
						} catch (fbErr) {
							console.warn("[Firebase Raw] Fallback to Laravel:", fbErr);
							rawPublicUrl = await uploadToLaravel(rawFileToUpload, `products/${jenisProduk}/${actualCode}/${cleanMotifTag}/raw`).catch(() => "");
						}

						if (rawPublicUrl) {
							raw_images.push(rawPublicUrl);
						}

						// 2. Process Watermarked & WebP Compressed Image (Logo + Code Text)
						let webpBuffer: Buffer;
						try {
							const imgBuffer = Buffer.from(await file.arrayBuffer());
							const imgSharp = sharp(imgBuffer);
							const metadata = await imgSharp.metadata();
							const width = metadata.width || 1000;
							const height = metadata.height || 1000;

							const compositeArr: any[] = [];

							if (logoBuffer) {
								const logoWidth = Math.round(width * 0.18);
								const resizedLogo = await sharp(logoBuffer)
									.resize({ width: logoWidth, withoutEnlargement: true })
									.toBuffer();
								const resizedMeta = await sharp(resizedLogo).metadata();
								const actualLogoW = resizedMeta.width || logoWidth;
								const logoMargin = Math.round(width * 0.04);

								compositeArr.push({
									input: resizedLogo,
									top: logoMargin,
									left: width - actualLogoW - logoMargin,
									blend: "over",
								});
							}

							const textCode = (item_code || code || "")
								.toString()
								.replace(/[\r\n\t\f\v\u00A0\uFEFF]/g, '')
								.replace(/[^a-zA-Z0-9_\-\s]/g, '')
								.trim();
							if (textCode) {
								const fontSize = Math.max(Math.round(height * 0.022), 14);
								const textMarginRight = Math.round(width * 0.04);
								const textY = height - Math.round(height * 0.05);
								const svgText = `
									<svg width="${width}" height="${height}">
										<style>
											@font-face {
												font-family: 'Roboto';
												src: url('data:font/ttf;base64,${fontBase64}');
											}
											.title { fill: white; font-size: ${fontSize}px; font-weight: bold; font-family: 'Roboto', sans-serif; }
											.shadow { fill: black; font-size: ${fontSize}px; font-weight: bold; font-family: 'Roboto', sans-serif; }
										</style>
										<text x="${width - textMarginRight + 2}" y="${textY + 2}" text-anchor="end" class="shadow">${textCode}</text>
										<text x="${width - textMarginRight}" y="${textY}" text-anchor="end" class="title">${textCode}</text>
									</svg>
								`;
								compositeArr.push({
									input: Buffer.from(svgText),
									top: 0,
									left: 0,
								});
							}

							if (compositeArr.length > 0) {
								webpBuffer = await imgSharp
									.composite(compositeArr)
									.webp({ quality: 80 })
									.toBuffer();
							} else {
								webpBuffer = await imgSharp
									.webp({ quality: 80 })
									.toBuffer();
							}
						} catch (e) {
							console.error("Sharp WebP & Watermark error:", e);
							webpBuffer = Buffer.from(await file.arrayBuffer());
						}

						const webpCustomName = `${actualCode}_${cleanMotifTag}_${timestamp}_${motifIdx}.webp`;
						const webpFileToUpload = new File([new Uint8Array(webpBuffer)], webpCustomName, { type: "image/webp" });

						let publicUrl = "";
						const fbPathWebp = `products/${jenisProduk}/${actualCode}/${cleanMotifTag}/katalog/${webpCustomName}`;
						try {
							publicUrl = await uploadToFirebase(webpFileToUpload, fbPathWebp);
							console.log(`[Firebase WebP] Upload success -> ${publicUrl}`);
						} catch (fbErr) {
							console.warn("[Firebase WebP] Fallback to Laravel:", fbErr);
							publicUrl = await uploadToLaravel(webpFileToUpload, `products/${jenisProduk}/${actualCode}/${cleanMotifTag}/katalog`).catch(() => "");
						}

						if (publicUrl) {
							images.push(publicUrl);
							finalMotifUrl = publicUrl;
						}
					} else if (imgData.existingUrl) {
						images.push(imgData.existingUrl);
						raw_images.push(imgData.existingUrl);
						finalMotifUrl = imgData.existingUrl;
					}

					if (finalMotifUrl) {
						motifFinalUrlMap.set(motifKey, finalMotifUrl);
					}
				}

				// Final deduplication & primary image
				images = [...new Set(images.filter(Boolean))];
				raw_images = [...new Set(raw_images.filter(Boolean))];

				// Fallback to existing product images if empty
				if (images.length === 0 && Array.isArray(product.images) && product.images.length > 0) {
					images = [...product.images];
				}
				if (raw_images.length === 0 && Array.isArray(product.raw_images) && product.raw_images.length > 0) {
					raw_images = [...product.raw_images];
				} else if (raw_images.length === 0 && images.length > 0) {
					raw_images = [...images];
				}
				if (images.length === 0 && raw_images.length > 0) {
					images = [...raw_images];
				}

				const image_url = images[0] || product.image_url || null;
				const raw_image_url = raw_images[0] || image_url || product.raw_image_url || null;

				// -------------------------------------------------------------
				// UPDATE AI_FOTO KE NOIR API JIKA TERHUBUNG KE POS
				// -------------------------------------------------------------
				const variant_praproduk_ids = formData.getAll("variant_praproduk_id") as string[];
				const main_praproduk_id = formData.get("main_praproduk_id") as string;
				const NOIR_API_BASE = "https://noir.grace.gracianna.web.id/api/v1";

				const updateTasks: Promise<any>[] = [];

				for (let i = 0; i < variant_praproduk_ids.length; i++) {
					const detailId = variant_praproduk_ids[i];
					const motifName = (variant_motif_names[i] || `Motif-${i}`).trim();
					const photoUrlForMotif = motifFinalUrlMap.get(motifName) || image_url;

					if (detailId && photoUrlForMotif) {
						updateTasks.push(
							fetch(`${NOIR_API_BASE}/beli1/${detailId}/ai-foto`, {
								method: "PUT",
								headers: {
									"Content-Type": "application/json",
									"Accept": "application/json"
								},
								body: JSON.stringify({
									AI_foto: photoUrlForMotif
								})
							}).catch(err => {
								console.error(`[Noir API] Gagal update AI_foto detail #${detailId}:`, err);
							})
						);
					}
				}

				if (main_praproduk_id && image_url) {
					updateTasks.push(
						fetch(`${NOIR_API_BASE}/beli1/${main_praproduk_id}/ai-foto`, {
							method: "PUT",
							headers: {
								"Content-Type": "application/json",
								"Accept": "application/json"
							},
							body: JSON.stringify({
								AI_foto: image_url
							})
						}).catch(err => {
							console.error(`[Noir API] Gagal update AI_foto parent #${main_praproduk_id}:`, err);
						})
					);
				}

				if (updateTasks.length > 0) {
					await Promise.allSettled(updateTasks);
					console.log(`[Noir API] Berhasil memproses update ${updateTasks.length} foto pra-produk secara paralel.`);
				}

				// Build variants array from Counter schema
				const variants = variant_sizes.map((size, index) => {
					const motif = variant_motif_names[index] || "";
					const counter = variant_counters[index] || variant_skus[index] || "";
					const outlet = variant_outlets[index] || "Gudang";
					const fit = variant_fits[index] || (size.includes("SF") ? "SF" : "REG");
					const sleeve = variant_sleeves[index] && variant_sleeves[index] !== "-" ? variant_sleeves[index] : null;
					const cleanKey = (sleeve && sleeve !== "-") ? `${motif}___${sleeve}` : motif;
					const rawMotifImg = motifFinalUrlMap.get(cleanKey) || motifFinalUrlMap.get(motif) || variant_image_urls[index] || "";
					const motifImageUrl = (rawMotifImg && !rawMotifImg.startsWith("blob:")) ? rawMotifImg : "";

					return {
						size_name: size,
						sku: variant_skus[index] || counter || null,
						counter: counter || null,
						outlet: outlet || null,
						motif: motif || null,
						fit: fit || null,
						sleeve: sleeve || null,
						image_url: motifImageUrl || null,
						price: parseFloat(variant_prices[index] || price?.toString() || "0"),
						stock: parseInt(variant_stocks[index] || "0", 10),
						dalaman: variant_dalamans[index] || null,
					};
				});

				const productPayload = {
					name,
					price,
					type_id,
					category_ids,
					category_chain,
					motif_ids,
					colors,
					description,
					code,
					original_price,
					item_code,
					image_url,
					images,
					raw_image_url,
					raw_images,
					tokopedia_url,
					variants,
					is_active,
				};

				console.log(`[Product Update] Mengirim PUT products/${id}...`);
				await apiFetch(`products/${id}`, {
					method: "PUT",
					body: JSON.stringify(productPayload),
				});

				return Astro.redirect("/buka-toko?success=status");
			}
		} catch (e: any) {
			isError = true;
			message = "Gagal memperbarui produk: " + e.message;
		}
	}
}

