							<!-- Stok -->
							<div style="width: 100px;">
								<span style="display: block; font-size: 0.65rem; font-weight: 800; color: #475569; text-transform: uppercase; margin-bottom: 4px; letter-spacing: 0.3px;">📦 Stok</span>
								<input type="number" name="variant_stock" value="${stockVal}" min="0" class="v-stock-input" style="width: 100%; padding: 5px 6px; font-size: 0.78rem; border: 1.5px solid #cbd5e1; border-radius: 6px; text-align: center; font-weight: 800; color: #0f172a; background: #fff;" required />
							</div>
						</div>
					</div>

					<!-- Hidden inputs -->
					<input type="hidden" name="variant_counter" value="${counterCode}" class="v-counter-hidden" />
					<input type="hidden" name="variant_outlet" value="${outletName}" class="v-outlet-hidden" />
					<input type="hidden" name="variant_sku" value="${skuVal}" class="v-sku-hidden" />
					<input type="hidden" name="variant_praproduk_id" value="${d.id || ''}" class="v-praproduk-id-hidden" />
