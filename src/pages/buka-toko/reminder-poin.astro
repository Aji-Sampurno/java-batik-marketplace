					.filter(Boolean);
				const phoneText = phones.join('\n');
				navigator.clipboard.writeText(phoneText);
				showToast(`Berhasil menyalin ${phones.length} nomor WhatsApp!`);
			});

			// Export to CSV
			btnExportCSV.addEventListener('click', () => {
				if (filteredReminders.length === 0) {
					showToast('Tidak ada data untuk diekspor.');
					return;
				}
				const headers = ['ID', 'Nama Member', 'No WhatsApp', 'Outlet', 'Kode Voucher', 'Saldo Poin', 'Total Kredit', 'Total Debit', 'Total Transaksi', 'Transaksi Terakhir', 'Status WA'];
				const rows = filteredReminders.map(r => [
					r.id || '',
					`"${(r.name || '').replace(/"/g, '""')}"`,
					`"${cleanPhone(r.tlp)}"`,
					`"${(r.outlet || '').replace(/"/g, '""')}"`,
					r.voucher_code || '',
					r.total_poin || 0,
					r.total_kredit || 0,
					r.total_debit || 0,
					r.total_transaksi || 0,
					`"${r.last_transaction || ''}"`,
					r.wa_sent ? 'Sudah Kirim' : 'Belum Kirim'
				]);

				const csvContent = 'data:text/csv;charset=utf-8,' + [headers.join(','), ...rows.map(e => e.join(','))].join('\n');
				const encodedUri = encodeURI(csvContent);
				const link = document.createElement('a');
				link.setAttribute('href', encodedUri);
				link.setAttribute('download', `reminder_member_poin_${new Date().toISOString().split('T')[0]}.csv`);
				document.body.appendChild(link);
				link.click();
				document.body.removeChild(link);
				showToast('File CSV berhasil diunduh!');
			});

			// Async Refresh Data from API
			async function reloadData() {
				if (refreshSpinner) refreshSpinner.style.animation = 'spinAnim 1s linear infinite';
				try {
					const res = await fetch('https://noir.grace.gracianna.web.id/api/v1/getReminders');
					if (!res.ok) throw new Error(`HTTP error ${res.status}`);
					const json = await res.json();
					if (json && json.reminders) {
						allReminders = json.reminders;
						updateStats(json);
						populateOutletDropdown(allReminders);
						applyFilters();
						showToast('Data reminder berhasil diperbarui!');
					}
				} catch (err) {
					console.error('Fetch getReminders failed:', err);
					showToast('Gagal memuat pembaruan data dari API.');
				} finally {
					if (refreshSpinner) refreshSpinner.style.animation = '';
				}
			}

			btnRefresh.addEventListener('click', reloadData);

			// Initial Setup
			populateOutletDropdown(allReminders);
			applyFilters();
		});
	</script>
</Layout>
