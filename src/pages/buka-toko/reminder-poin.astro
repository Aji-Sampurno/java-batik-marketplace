---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import { apiFetch } from "../../lib/api";

// Authentication Gate
const session = Astro.cookies.get("admin_session");
if (session?.value !== "authenticated") {
	return Astro.redirect("/login");
}

let settings: any = { site_name: "Batik Nusantara" };
try {
	const sRes = await apiFetch<any>("settings");
	const s = sRes?.data || sRes;
	if (s) settings = s;
} catch (e: any) {
	console.error("Settings fetch error:", e.message);
}

// Fetch reminders data from Noir API
let initialData: any = null;
let fetchError = "";

try {
	const response = await fetch("https://noir.grace.gracianna.web.id/api/v1/getReminders", {
		headers: {
			"Accept": "application/json"
		}
	});
	if (response.ok) {
		initialData = await response.json();
	} else {
		fetchError = `Gagal memuat API Noir (Status: ${response.status})`;
	}
} catch (err: any) {
	fetchError = `Koneksi ke API Noir terputus: ${err.message}`;
}
