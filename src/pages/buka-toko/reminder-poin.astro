	<script is:inline define:vars={{ initialData }}>
		document.addEventListener('DOMContentLoaded', () => {
			let allReminders = initialData?.reminders || [];
			let filteredReminders = [...allReminders];

			// State filters
			let currentStatusFilter = 'all'; // 'all', 'pending', 'sent'
			let currentOutletFilter = 'all';
			let currentSort = 'poin_desc';
			let currentSearch = '';

			// DOM Elements
			const tableBody = document.getElementById('reminderTableBody');
			const emptyState = document.getElementById('emptyTableState');
			const searchInput = document.getElementById('searchInput');
			const clearSearchBtn = document.getElementById('clearSearchBtn');
			const outletSelect = document.getElementById('outletSelect');
			const sortSelect = document.getElementById('sortSelect');
			const segButtons = document.querySelectorAll('.seg-btn');
			const filteredCountEl = document.getElementById('filteredCount');
			const totalAvailableCountEl = document.getElementById('totalAvailableCount');
			const btnResetFilters = document.getElementById('btnResetFilters');

			// Header stats
			const cardTotalMembers = document.getElementById('cardTotalMembers');
			const cardPendingMembers = document.getElementById('cardPendingMembers');
			const cardSentMembers = document.getElementById('cardSentMembers');
			const cardTotalPoin = document.getElementById('cardTotalPoin');
			const cardTotalTransaksi = document.getElementById('cardTotalTransaksi');
			const pillCountAll = document.getElementById('pillCountAll');
			const pillCountPending = document.getElementById('pillCountPending');
			const pillCountSent = document.getElementById('pillCountSent');
			const todayBadge = document.getElementById('todayBadge');

			// Action Buttons
			const btnRefresh = document.getElementById('btnRefresh');
			const refreshSpinner = document.getElementById('refreshSpinner');
			const btnCopyAllPhones = document.getElementById('btnCopyAllPhones');
			const btnExportCSV = document.getElementById('btnExportCSV');

			// Template Accordion
			const toggleTemplateBtn = document.getElementById('toggleTemplateBtn');
			const templateContent = document.getElementById('templateContent');
			const templateToggleIcon = document.getElementById('templateToggleIcon');
			const templateToggleText = document.getElementById('templateToggleText');

			// Modal
			const modal = document.getElementById('memberDetailModal');
			const closeModalBtn = document.getElementById('closeModalBtn');
			const modalAvatar = document.getElementById('modalAvatar');
			const modalName = document.getElementById('modalName');
			const modalId = document.getElementById('modalId');
			const modalPoin = document.getElementById('modalPoin');
			const modalKredit = document.getElementById('modalKredit');
			const modalDebit = document.getElementById('modalDebit');
			const modalTransaksi = document.getElementById('modalTransaksi');
			const modalPhone = document.getElementById('modalPhone');
			const modalVoucher = document.getElementById('modalVoucher');
			const modalOutlet = document.getElementById('modalOutlet');
			const modalLastTrx = document.getElementById('modalLastTrx');
			const modalVoucherDate = document.getElementById('modalVoucherDate');
			const modalWaStatus = document.getElementById('modalWaStatus');
			const modalMessagePreview = document.getElementById('modalMessagePreview');
			const modalCopyMsgBtn = document.getElementById('modalCopyMsgBtn');
			const modalSendWaBtn = document.getElementById('modalSendWaBtn');

			// Toast
			const toast = document.getElementById('toastNotification');
			const toastMsg = document.getElementById('toastMessage');
			let toastTimer = null;

			function showToast(message) {
				if (toastTimer) clearTimeout(toastTimer);
				toastMsg.textContent = message;
				toast.style.display = 'flex';
				toastTimer = setTimeout(() => {
					toast.style.display = 'none';
				}, 2600);
			}

			// Helper: Format phone number into clean international 62 format
			function cleanPhone(rawPhone) {
				if (!rawPhone) return '';
				let cleaned = String(rawPhone).replace(/\D/g, '');
				if (cleaned.startsWith('0')) {
					cleaned = '62' + cleaned.substring(1);
				} else if (cleaned.startsWith('8')) {
					cleaned = '62' + cleaned;
				}
				return cleaned;
			}

			// Helper: Format phone for user readable display
			function formatPhoneDisplay(rawPhone) {
				const p = cleanPhone(rawPhone);
				if (!p) return '-';
				if (p.startsWith('62')) {
					return '+62 ' + p.substring(2, 5) + '-' + p.substring(5, 9) + '-' + p.substring(9);
				}
				return p;
			}

			// Helper: Get user avatar initials
			function getInitials(name) {
				if (!name) return 'MB';
				const parts = name.trim().split(/\s+/);
				if (parts.length >= 2) {
					return (parts[0][0] + parts[1][0]).toUpperCase();
				}
				return name.substring(0, 2).toUpperCase();
			}

			// Helper: Build WhatsApp reminder message
			function buildReminderMessage(member) {
				const name = member.name ? member.name.trim() : 'Kakak';
				const poin = Number(member.total_poin || 0).toLocaleString('id-ID');
				const voucher = member.voucher_code || '-';
				const outlet = member.outlet ? member.outlet.trim() : 'Galeri & Online';

				return `Halo Kak ${name}! ✨

Kami dari Java Batik ingin menginformasikan bahwa Anda memiliki saldo poin reward keanggotaan:
🎁 *Saldo Poin:* ${poin} Poin
🏷️ *Kode Voucher:* ${voucher}
📍 *Outlet Terdaftar:* ${outlet}

Poin Anda dapat langsung ditukarkan dengan potongan belanja atau voucher menarik di kasir outlet Java Batik! 😊👗

👉 *Lihat Katalog Koleksi Terbaru:*
https://javabatikgallery.com/products

💬 *Konsultasi & Pemesanan Online:*
Butuh bantuan motif, ukuran, atau rekomendasi busana? Anda dapat langsung membalas pesan WhatsApp ini ya Kak. Terima kasih! 🙏✨`;
			}

			// Build WhatsApp Direct Link
			function buildWaLink(member) {
				const phone = cleanPhone(member.tlp);
				const text = encodeURIComponent(buildReminderMessage(member));
				return `https://wa.me/${phone}?text=${text}`;
			}

			// Populate Outlet Select dynamically
			function populateOutletDropdown(items) {
				const outlets = new Set();
				items.forEach(item => {
					if (item.outlet && item.outlet.trim()) {
						outlets.add(item.outlet.trim());
					}
				});

				const sortedOutlets = Array.from(outlets).sort();
				outletSelect.innerHTML = '<option value="all">Semua Outlet</option>';
				sortedOutlets.forEach(o => {
					const opt = document.createElement('option');
					opt.value = o;
					opt.textContent = o;
					outletSelect.appendChild(opt);
				});
			}

			// Update Stat Cards & Header Counts
			function updateStats(data) {
				if (!data) return;
				const total = data.total ?? allReminders.length;
				const sent = data.total_wa_sent ?? allReminders.filter(r => r.wa_sent).length;
				const pending = total - sent;
				const poin = data.total_poin ?? allReminders.reduce((acc, cur) => acc + (cur.total_poin || 0), 0);
				const trx = data.total_transaksi ?? allReminders.reduce((acc, cur) => acc + (cur.total_transaksi || 0), 0);

				if (cardTotalMembers) cardTotalMembers.textContent = Number(total).toLocaleString('id-ID');
				if (cardPendingMembers) cardPendingMembers.textContent = Number(pending).toLocaleString('id-ID');
				if (cardSentMembers) cardSentMembers.textContent = Number(sent).toLocaleString('id-ID');
				if (cardTotalPoin) cardTotalPoin.textContent = Number(poin).toLocaleString('id-ID');
				if (cardTotalTransaksi) cardTotalTransaksi.textContent = Number(trx).toLocaleString('id-ID');

				if (pillCountAll) pillCountAll.textContent = total;
				if (pillCountPending) pillCountPending.textContent = pending;
				if (pillCountSent) pillCountSent.textContent = sent;

				if (data.today && todayBadge) todayBadge.textContent = data.today;
			}

			// Render Table Rows with Direct Inline Styles
			function renderTable(items) {
				filteredCountEl.textContent = items.length;
				totalAvailableCountEl.textContent = allReminders.length;

				// Toggle Reset Filter Button
				const isFiltering = currentSearch || currentStatusFilter !== 'all' || currentOutletFilter !== 'all';
				if (btnResetFilters) {
					btnResetFilters.style.display = isFiltering ? 'inline-block' : 'none';
				}

				if (items.length === 0) {
					tableBody.innerHTML = '';
					emptyState.style.display = 'block';
					return;
				}

				emptyState.style.display = 'none';

				const rowsHtml = items.map((member, index) => {
					const initials = getInitials(member.name);
					const phoneClean = cleanPhone(member.tlp);
					const phoneDisplay = formatPhoneDisplay(member.tlp);
					const waLink = buildWaLink(member);
					const poinFormatted = Number(member.total_poin || 0).toLocaleString('id-ID');
					const kreditFormatted = Number(member.total_kredit || 0).toLocaleString('id-ID');
					const debitFormatted = Number(member.total_debit || 0).toLocaleString('id-ID');
					const isWaSent = Boolean(member.wa_sent);
					const memberJson = encodeURIComponent(JSON.stringify(member));

					return `
						<tr class="table-row-item" data-member="${memberJson}" style="border-bottom: 1px solid #f1f5f9; transition: background-color 0.15s;">
							<td style="padding: 0.85rem 1rem; text-align: center; color: #94a3b8; font-weight: 600; font-size: 0.8rem;">
