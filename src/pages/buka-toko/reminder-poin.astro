			function getMemberCardUrl(phone, name) {
				let clean = String(phone || '6282334059852').replace(/[^0-9]/g, '');
				if (clean.startsWith('0')) clean = '62' + clean.slice(1);
				const encName = encodeURIComponent(name || 'MEMBER SETIA');
				return `https://connect.gooproper.com/api/member-card?phone=${clean}&name=${encName}&business=JAVA+BATIK`;
			}

			function updateCardPreview() {
				const phone = wabaInputPhone.value.trim() || '6282334059852';
				const name = (wabaParamFullName ? wabaParamFullName.value.trim() : '') || 'MEMBER SETIA';
				const cardUrl = getMemberCardUrl(phone, name);
				wabaInputImage.value = cardUrl;
				wabaCardPreviewImg.src = cardUrl;
			}

			async function fetchMemberFromDb(phoneToFetch) {
				let clean = String(phoneToFetch || '').replace(/[^0-9]/g, '');
				if (!clean) return;
				if (clean.startsWith('0')) clean = '62' + clean.slice(1);
				if (dbFetchStatus) {
					dbFetchStatus.textContent = 'Mengambil data dari DB...';
					dbFetchStatus.style.color = '#0284c7';
				}
				try {
					const res = await fetch(`/api/check-member-db?phone=${clean}`);
					const json = await res.json();
					if (res.ok && json && json.success && json.data) {
						const d = json.data;
						const fullName = (d.name || 'Aji Sampurno').trim();
						const nickname = fullName.split(/\s+/)[0] || 'Aji';
						wabaParamNickname.value = nickname;
						wabaParamFullName.value = fullName;
						wabaParamPoin.value = Number(d.poin || 0).toLocaleString('id-ID');
						wabaParamTransaksi.value = d.transaksi ? `${d.transaksi}x belanja` : '1x belanja';
						wabaParamLastTrx.value = d.last_transaction || '-';
						if (dbFetchStatus) {
							dbFetchStatus.textContent = `✓ Data ${d.name} (${Number(d.poin || 0).toLocaleString('id-ID')} Poin) Ditemukan!`;
							dbFetchStatus.style.color = '#059669';
						}
						updateCardPreview();
						showToast(`Data member "${d.name}" berhasil ditarik dari database!`);
					} else {
						if (dbFetchStatus) {
							dbFetchStatus.textContent = '⚠️ Tidak terdaftar di DB Noir';
							dbFetchStatus.style.color = '#d97706';
						}
						updateCardPreview();
					}
				} catch (err) {
					if (dbFetchStatus) {
						dbFetchStatus.textContent = '❌ Gagal koneksi DB';
						dbFetchStatus.style.color = '#dc2626';
					}
					updateCardPreview();
				}
			}

