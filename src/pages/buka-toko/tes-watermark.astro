	<script is:inline>
		const imageInput = document.getElementById('imageInput');
		const dropzoneContainer = document.getElementById('dropzoneContainer');
		const dropzonePlaceholder = document.getElementById('dropzonePlaceholder');
		const previewSelected = document.getElementById('previewSelected');
		const selectedImgThumbnail = document.getElementById('selectedImgThumbnail');
		const selectedImgName = document.getElementById('selectedImgName');
		const selectedImgSize = document.getElementById('selectedImgSize');
		const btnChangeImg = document.getElementById('btnChangeImg');
		const testForm = document.getElementById('testForm');
		const btnSubmit = document.getElementById('btnSubmit');
		const processingIndicator = document.getElementById('processingIndicator');
		const itemCodeInput = document.getElementById('itemCodeInput');
		const customTextInput = document.getElementById('customTextInput');

		if (itemCodeInput && customTextInput) {
			itemCodeInput.addEventListener('input', (e) => {
				if (!customTextInput.dataset.userEdited) {
					customTextInput.value = e.target.value;
				}
			});
			customTextInput.addEventListener('input', () => {
				customTextInput.dataset.userEdited = "true";
			});
		}

		if (imageInput) {
			imageInput.addEventListener('change', function(e) {
				const file = this.files[0];
				if (file) {
					const reader = new FileReader();
					reader.onload = function(evt) {
						selectedImgThumbnail.src = evt.target.result;
						selectedImgName.innerText = file.name;
						selectedImgSize.innerText = (file.size / 1024).toFixed(1) + " KB (" + file.type + ")";
						dropzonePlaceholder.style.display = "none";
						previewSelected.style.display = "flex";
					};
					reader.readAsDataURL(file);
				}
			});
		}

		if (btnChangeImg) {
			btnChangeImg.addEventListener('click', (e) => {
				e.stopPropagation();
				imageInput.value = "";
				dropzonePlaceholder.style.display = "block";
				previewSelected.style.display = "none";
			});
		}

		if (testForm) {
			testForm.addEventListener('submit', () => {
				if (btnSubmit && processingIndicator) {
					btnSubmit.disabled = true;
					btnSubmit.style.opacity = "0.5";
					processingIndicator.style.display = "block";
				}
			});
		}

		window.fillMockup = function(code, jenis, motif) {
			if (itemCodeInput) itemCodeInput.value = code;
			if (customTextInput) customTextInput.value = code;
			const jInput = document.querySelector('input[name="jenis_produk"]');
			if (jInput) jInput.value = jenis;
			const mInput = document.querySelector('input[name="motif_name"]');
			if (mInput) mInput.value = motif;
		};

		window.copyToClipboard = function(inputId, btn) {
			const input = document.getElementById(inputId);
			if (input) {
				input.select();
				navigator.clipboard.writeText(input.value).then(() => {
					const orig = btn.innerText;
					btn.innerText = "✓ Disalin!";
					btn.style.background = "#10b981";
					btn.style.color = "white";
					setTimeout(() => {
						btn.innerText = orig;
						btn.style.background = "white";
						btn.style.color = "#334155";
					}, 2000);
				});
			}
		};

		// Auto scroll to results if present
		window.addEventListener('DOMContentLoaded', () => {
			const resultSection = document.getElementById('resultSection');
			if (resultSection) {
				setTimeout(() => {
					resultSection.scrollIntoView({ behavior: 'smooth' });
				}, 100);
			}
		});
	</script>
</Layout>
