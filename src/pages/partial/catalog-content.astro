---
export const prerender = false;
import { apiFetch } from "../../lib/api";
import ProductCard from "../../components/ProductCard.astro";
import { KNOWN_OUTLET_LIST, matchOutlet } from "../../lib/outlet";
import { buildCategoryTree, getAncestry, resolveCategoryIds } from "../../lib/category";

const { searchParams } = Astro.url;
const typeFilter = searchParams.get("type") || searchParams.get("type_id");
const motifFilter = searchParams.get("motif");
const sizeFilter = searchParams.get("size"); 
const fitFilter = searchParams.get("fit");
const colorFilter = searchParams.get("color");
const outletFilter = searchParams.get("outlet");
const searchQuery = searchParams.get("q");
const minPrice = searchParams.get("minP")
	? Number(searchParams.get("minP"))
	: null;
const maxPrice = searchParams.get("maxP")
	? Number(searchParams.get("maxP"))
	: null;
const sort = searchParams.get("sort") || "newest";

const getSortUrl = (newSort: string) => {
	const p = new URLSearchParams(searchParams);
	p.set("sort", newSort);
	p.delete("page"); 
	return `?${p.toString()}`;
};

const hasActiveFilters = Boolean(
	typeFilter || motifFilter || sizeFilter || fitFilter || colorFilter || outletFilter || searchQuery || minPrice || maxPrice
);

let activeFilterCount = 0;
if (typeFilter) activeFilterCount++;
if (outletFilter) activeFilterCount++;
if (sizeFilter) activeFilterCount++;
if (fitFilter) activeFilterCount++;
if (colorFilter) activeFilterCount++;
if (motifFilter) activeFilterCount++;
if (minPrice || maxPrice) activeFilterCount++;

const getClearFilterUrl = (paramToRemove: string) => {
	const p = new URLSearchParams(searchParams);
	p.delete(paramToRemove);
	if (paramToRemove === "type") p.delete("type_id");
	p.delete("page");
	return `?${p.toString()}`;
};

const getCleanBaseSizes = (rawSizes: any[]) => {
	if (!rawSizes || rawSizes.length === 0) return [];
	const sfRegex = /\bSF\b|\bSlim\s*Fit\b|\bSlim\b/i;
	const mapped = rawSizes.map((s: any) => {
		let name = typeof s === "string" ? s : (s?.name || "");
		let base = name.trim();
		if (base.includes(" - ")) {
			base = base.split(" - ")[0].trim();
		}
		if (sfRegex.test(base)) {
			base = base.replace(sfRegex, "").replace(/[-_\s/]+$/, "").trim();
		}
		return base.toUpperCase();
	});

	const unique = [...new Set(mapped)].filter(
		(sz) => sz && (isNaN(Number(sz)) || sz.length <= 3)
	);

	const sizeOrder = ["S", "M", "L", "XL", "XXL", "3XL", "4XL", "5XL", "ALL SIZE"];
	unique.sort((a, b) => {
		const idxA = sizeOrder.indexOf(a);
		const idxB = sizeOrder.indexOf(b);
		if (idxA !== -1 && idxB !== -1) return idxA - idxB;
		if (idxA !== -1) return -1;
		if (idxB !== -1) return 1;
		return a.localeCompare(b);
	});
	return unique;
};

let typesData: any[] = [];
let motifsData: any[] = [];
let sizesData: any[] = [];
let colorsData: any[] = [];
let hierarchicalTypes: any[] = [];
let activePathIds: any[] = [];
let targetType: any = null;
let matchingTypeIds: string[] = [];
let settings: any = { contact_whatsapp: "628123456789" };

const itemsPerPage = 12;
const currentPage = Number(searchParams.get("page") || "1");

let totalItems = 0;
let totalPages = 1;
let paginatedProducts: any[] = [];
const productParams = new URLSearchParams();

try {
	const [tRes, mRes, szRes, colRes, sRes] = await Promise.all([
		apiFetch<any>("types").catch(() => []),
		apiFetch<any>("motifs").catch(() => []),
		apiFetch<any>("sizes").catch(() => []),
		apiFetch<any>("colors").catch(() => []),
		apiFetch<any>("settings").catch(() => null),
	]);

	typesData = tRes?.data || tRes || [];
	motifsData = mRes?.data || mRes || [];
	sizesData = szRes?.data || szRes || [];
	colorsData = colRes?.data || colRes || [];

	const s = sRes?.data || sRes;
	if (s) settings = s;

	hierarchicalTypes = buildCategoryTree(typesData);

	let rootType: any = null;
	if (typeFilter) {
		const catResolved = resolveCategoryIds(typesData, typeFilter);
		targetType = catResolved.targetType;
		rootType = catResolved.rootType;
		matchingTypeIds = catResolved.matchingTypeIds;
		activePathIds = getAncestry(typesData, targetType?.id || null);
	}

	productParams.set("page", String(currentPage));
	productParams.set("per_page", String(itemsPerPage));

	if (targetType) {
		if (rootType) {
			productParams.set("type_id", rootType.id);
		}
		// If level 2 or level 3 (has parent_id), filter by specific category ID in categories relation
		if (targetType.parent_id) {
			productParams.set("type", targetType.id);
		}
	} else if (matchingTypeIds.length === 1) {
		productParams.set("type_id", matchingTypeIds[0]);
	} else if (matchingTypeIds.length > 1) {
		matchingTypeIds.forEach((id) => productParams.append("type_id[]", id));
	}

	if (motifFilter) productParams.set("motif", motifFilter);

	let effectiveSizeParam = sizeFilter || "";
	if (fitFilter === "slim_fit" || fitFilter === "sf" || fitFilter === "Slim Fit") {
		if (sizeFilter) {
			effectiveSizeParam = `${sizeFilter} SF`;
		} else {
			effectiveSizeParam = "%SF%";
		}
	}
	if (effectiveSizeParam) productParams.set("size", effectiveSizeParam);

	if (colorFilter) productParams.set("color", colorFilter);
	if (searchQuery) productParams.set("search", searchQuery);
	if (minPrice) productParams.set("min_price", String(minPrice));
	if (maxPrice) productParams.set("max_price", String(maxPrice));
	productParams.set("sort", sort);

	const pRes = await apiFetch<any>(`products?${productParams.toString()}`).catch(() => null);

	if (pRes) {
		let rawProducts = pRes?.data || [];
		const meta = pRes?.meta || pRes;
		const lastPage = Number(meta?.last_page || 1);

		const isSlimFit = (sizeName: string) => /\bSF\b|\bSlim\s*Fit\b|\bSlim\b/i.test(sizeName || "");
		const getBaseSize = (sizeName: string) => {
			let s = (sizeName || "").trim();
			if (s.includes(" - ")) s = s.split(" - ")[0].trim();
			const sfRegex = /\bSF\b|\bSlim\s*Fit\b|\bSlim\b/i;
			if (sfRegex.test(s)) {
				s = s.replace(sfRegex, "").replace(/[-_\s/]+$/, "").trim();
			}
			return s.toUpperCase();
		};

		const isSlimFitMode = (fit: string | null) => {
			if (!fit) return false;
			const norm = fit.trim().toLowerCase();
			return norm === "slim_fit" || norm === "sf" || norm === "slim fit" || norm === "slim";
		};

		const isRegularMode = (fit: string | null) => {
			if (!fit) return false;
			const norm = fit.trim().toLowerCase();
			return norm === "regular" || norm === "reguler" || norm === "regular fit" || norm === "reguler fit";
		};

		const realSizeFilter = (sizeFilter && !sizeFilter.includes("%")) ? sizeFilter.trim().toUpperCase() : null;

		const filterProduct = (p: any) => {
			if (matchingTypeIds.length > 0) {
				const pTypeId = p.type_id || p.type?.id;
				const pCategoryIds = (p.categories || []).map((c: any) => c.id);
				const matchesType = (pTypeId && matchingTypeIds.includes(pTypeId)) ||
					pCategoryIds.some((cid: string) => matchingTypeIds.includes(cid));
				if (!matchesType) return false;
			}

			if (outletFilter) {
				const pOutlet = (p.outlet || p.outlet_location || "").trim();
				const variants = p.variants || p.product_variants || [];
				const matchesOutlet = (
					(pOutlet && matchOutlet(pOutlet, outletFilter)) ||
					variants.some((v: any) => {
						const vOutlet = (v.outlet || v.outlet_location || v.counter_name || "").trim();
						return vOutlet && matchOutlet(vOutlet, outletFilter);
					})
				);
				if (!matchesOutlet) return false;
			}

			if (!fitFilter && !realSizeFilter) return true;
			const variants = p.variants || p.product_variants || [];
			if (variants.length === 0) {
				if (p.sizes && Array.isArray(p.sizes) && p.sizes.length > 0) {
					return p.sizes.some((sName: string) => {
						const sf = isSlimFit(sName);
						if (isSlimFitMode(fitFilter) && !sf) return false;
						if (isRegularMode(fitFilter) && sf) return false;
						if (realSizeFilter) return getBaseSize(sName) === realSizeFilter;
						return true;
					});
				}
				return false;
			}

			return variants.some((v: any) => {
				const sName = v.size_name || "";
				const sf = isSlimFit(sName);
				if (isSlimFitMode(fitFilter) && !sf) return false;
				if (isRegularMode(fitFilter) && sf) return false;
				if (realSizeFilter) {
					const base = getBaseSize(sName);
					if (base !== realSizeFilter && sName.trim().toUpperCase() !== realSizeFilter) {
						return false;
					}
				}
				return true;
			});
		};

		rawProducts = rawProducts.filter(filterProduct);

		let fetchPage = currentPage;
		while (rawProducts.length < itemsPerPage && fetchPage < lastPage) {
			fetchPage++;
			productParams.set("page", String(fetchPage));
			const nextPageRes = await apiFetch<any>(`products?${productParams.toString()}`).catch(() => null);
			const nextPageData = nextPageRes?.data || [];
			if (nextPageData.length === 0) break;
			const filteredNext = nextPageData.filter(filterProduct);
			rawProducts.push(...filteredNext);
		}

		paginatedProducts = rawProducts.slice(0, itemsPerPage);
		if (fitFilter || sizeFilter || outletFilter || matchingTypeIds.length > 0) {
			if (fetchPage >= lastPage && rawProducts.length < itemsPerPage) {
				totalItems = (currentPage - 1) * itemsPerPage + rawProducts.length;
				totalPages = currentPage;
			} else {
				totalItems = Number(meta?.total || paginatedProducts.length);
				totalPages = lastPage;
			}
		} else {
			totalItems = Number(meta?.total || paginatedProducts.length);
			totalPages = lastPage;
		}
	}
} catch (e: any) {
	console.error("Catalog API Fetch Error", e.message);
}
---

<div class="products-layout">
	<!-- Sidebar Filters -->
	<aside class="filters-sidebar" id="filters-sidebar">
		<div class="sidebar-mobile-header">
			<div class="drag-handle"></div>
			<div class="header-title-row">
				<div class="header-title-left">
					<h3>Filter & Kategori</h3>
					{activeFilterCount > 0 && (
						<span class="active-filter-badge">{activeFilterCount}</span>
					)}
				</div>
				<button type="button" class="close-sidebar-btn" id="close-sidebar-btn" aria-label="Tutup filter">
					<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<line x1="18" y1="6" x2="6" y2="18"></line>
						<line x1="6" y1="6" x2="18" y2="18"></line>
					</svg>
				</button>
			</div>
		</div>

		<!-- Scrollable content area -->
		<div class="sidebar-scroll-content" id="sidebar-scroll-content">
			<input
				type="hidden"
				name="q"
				value={searchParams.get("q") || ""}
			/>

		<div class="filter-group">
			<div class="filter-group-header">
				<h3 class="filter-title">Rentang Harga</h3>
				{(minPrice || maxPrice) && (
					<a
						href={`/products?${new URLSearchParams({ ...Object.fromEntries(Array.from(searchParams.entries()).filter(([k]) => k !== "minP" && k !== "maxP")), page: "1" })}`}
						class="filter-reset-small"
					>
						Hapus
					</a>
				)}
			</div>
			<form
				action="/products"
				method="GET"
				class="price-filter-form"
			>
				{
					Array.from(searchParams.entries()).map(
						([key, value]) =>
							key !== "minP" &&
							key !== "maxP" && 
							key !== "page" && (
								<input
									type="hidden"
									name={key}
									value={value}
								/>
							),
					)
				}

				<div class="price-inputs-row">
					<input
						type="text"
						inputmode="numeric"
						name="minP"
						value={minPrice
							? `Rp ${minPrice.toLocaleString("id-ID")}`
							: ""}
						placeholder="Rp Min"
						class="price-input js-price-input"
					/>
					<span class="price-divider">—</span>
					<input
						type="text"
						inputmode="numeric"
						name="maxP"
						value={maxPrice
							? `Rp ${maxPrice.toLocaleString("id-ID")}`
							: ""}
						placeholder="Rp Maks"
						class="price-input js-price-input"
					/>
					<button type="submit" class="apply-price-btn" title="Terapkan Harga">
						<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="9 18 15 12 9 6"></polyline>
						</svg>
					</button>
				</div>
			</form>
		</div>

		<details open class="filter-group">
			<summary class="filter-group-summary">
				<span class="filter-title">Jenis Produk</span>
				<svg
					class="chevron"
					width="12"
					height="12"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2.5"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<polyline points="6 9 12 15 18 9"></polyline>
				</svg>
			</summary>
			<div class="category-tree">
				<a
					href={`/products?${new URLSearchParams({ ...Object.fromEntries(searchParams), type: "", page: "1" })}`}
					class={`cat-node cat-depth-0 ${!typeFilter ? "is-selected" : ""}`}
				>
					<span class="cat-label">Semua Jenis</span>
					{!typeFilter && (
						<svg class="cat-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="20 6 9 17 4 12"></polyline>
						</svg>
					)}
				</a>
				{
					hierarchicalTypes
						?.filter((t) => {
							return (
								t.parent_id === null ||
								activePathIds.includes(t.parent_id)
							);
						})
						.map((t) => {
							const isSelected = typeFilter === t.fullPath || typeFilter === t.id;
							const isParentActive = activePathIds.includes(t.id);
							const hasChildren = hierarchicalTypes.some((c) => c.parent_id === t.id);

							return (
								<a
									href={`/products?${new URLSearchParams({ ...Object.fromEntries(searchParams), type: t.fullPath, page: "1" })}`}
									class={`cat-node cat-depth-${t.depth} ${isSelected ? "is-selected" : ""} ${isParentActive && !isSelected ? "is-parent" : ""}`}
								>
									<span class="cat-label">
										{t.name}
									</span>
									{isSelected ? (
										<svg class="cat-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
											<polyline points="20 6 9 17 4 12"></polyline>
										</svg>
									) : hasChildren && isParentActive ? (
										<svg class="cat-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
											<polyline points="6 9 12 15 18 9"></polyline>
										</svg>
									) : null}
								</a>
							);
						})
				}
			</div>
		</details>

		<!-- Lokasi Outlet Filter -->
		<details open class="filter-group">
			<summary class="filter-group-summary">
				<span class="filter-title">Lokasi Outlet</span>
				<svg
					class="chevron"
					width="12"
					height="12"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2.5"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<polyline points="6 9 12 15 18 9"></polyline>
				</svg>
			</summary>
			<div class="chips-wrap">
				<a
					href={`/products?${new URLSearchParams({ ...Object.fromEntries(searchParams), outlet: "", page: "1" })}`}
					class={!outletFilter ? "active-chip" : "chip"}
				>
					Semua Outlet
				</a>
				{
					KNOWN_OUTLET_LIST.map((outName) => {
						const isActive = outletFilter && outletFilter.toLowerCase() === outName.toLowerCase();
						return (
							<a
								href={`/products?${new URLSearchParams({ ...Object.fromEntries(searchParams), outlet: outName, page: "1" })}`}
								class={isActive ? "active-chip" : "chip"}
							>
								<span>📍</span> {outName}
							</a>
						);
					})
				}
			</div>
		</details>

		<div class="filter-group">
			<div class="filter-group-header">
				<h3 class="filter-title">Ukuran</h3>
				{sizeFilter && (
					<a
						href={`/products?${new URLSearchParams({ ...Object.fromEntries(searchParams), size: "", page: "1" })}`}
						class="filter-reset-small"
					>
						Hapus
					</a>
				)}
			</div>
			<div class="chips-wrap">
				<a
					href={`/products?${new URLSearchParams({ ...Object.fromEntries(searchParams), size: "", page: "1" })}`}
					class={!sizeFilter ? "active-chip" : "chip"}
				>
					Semua
				</a>
				{
					getCleanBaseSizes(sizesData).map((sName) => {
						const normFilter = sizeFilter ? sizeFilter.trim().toUpperCase() : "";
						const isActive = normFilter && (
							normFilter === sName ||
							normFilter.startsWith(sName) ||
							sName.startsWith(normFilter)
						);
						return (
							<a
								href={`/products?${new URLSearchParams({ ...Object.fromEntries(searchParams), size: sName, page: "1" })}`}
								class={isActive ? "active-chip" : "chip"}
							>
								{sName === "ALL SIZE" ? "All Size" : sName}
							</a>
						);
					})
				}
			</div>
		</div>
		
		<div class="filter-group">
			<div class="filter-group-header">
				<h3 class="filter-title">Potongan Baju</h3>
				{fitFilter && (
					<a
						href={`/products?${new URLSearchParams({ ...Object.fromEntries(searchParams), fit: "", page: "1" })}`}
						class="filter-reset-small"
					>
						Hapus
					</a>
				)}
			</div>
			<div class="chips-wrap">
				<a
					href={`/products?${new URLSearchParams({ ...Object.fromEntries(searchParams), fit: "", page: "1" })}`}
					class={!fitFilter ? "active-chip" : "chip"}
				>
					Semua
				</a>
				<a
					href={`/products?${new URLSearchParams({ ...Object.fromEntries(searchParams), fit: "slim_fit", page: "1" })}`}
					class={fitFilter === "slim_fit" ? "active-chip" : "chip"}
				>
					Slim Fit
				</a>
				<a
					href={`/products?${new URLSearchParams({ ...Object.fromEntries(searchParams), fit: "regular", page: "1" })}`}
					class={fitFilter === "regular" ? "active-chip" : "chip"}
				>
					Regular Fit
				</a>
			</div>
		</div>

		<div class="filter-group">
			<div class="filter-group-header">
				<h3 class="filter-title">Warna</h3>
				{colorFilter && (
					<a
						href={`/products?${new URLSearchParams({ ...Object.fromEntries(searchParams), color: "", page: "1" })}`}
						class="filter-reset-small"
					>
						Hapus
					</a>
				)}
			</div>
			<div class="chips-wrap">
				<a
					href={`/products?${new URLSearchParams({ ...Object.fromEntries(searchParams), color: "", page: "1" })}`}
					class={!colorFilter ? "active-chip" : "chip"}
				>
					Semua Warna
				</a>
				{
					colorsData?.map((c) => (
						<a
							href={`/products?${new URLSearchParams({ ...Object.fromEntries(searchParams), color: c.name, page: "1" })}`}
							class={
								colorFilter === c.name
									? "active-chip"
									: "chip"
							}
						>
							{c.name}
						</a>
					))
				}
			</div>
		</div>

		<details class="filter-group">
			<summary class="filter-group-summary">
				<span class="filter-title">Motif Batik</span>
				<svg
					class="chevron"
					width="12"
					height="12"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2.5"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<polyline points="6 9 12 15 18 9"></polyline>
				</svg>
			</summary>
			<div class="chips-wrap" style="padding-top: 0.3rem;">
				<a
					href={`/products?${new URLSearchParams({ ...Object.fromEntries(searchParams), motif: "", page: "1" })}`}
					class={!motifFilter ? "active-chip" : "chip"}
				>
					Semua Motif
				</a>
				{
					motifsData?.map((m) => (
						<a
							href={`/products?${new URLSearchParams({ ...Object.fromEntries(searchParams), motif: m.name, page: "1" })}`}
							class={
								motifFilter === m.name
									? "active-chip"
									: "chip"
							}
						>
							{m.name}
						</a>
					))
				}
			</div>
		</details>

			<div
				style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid #f1f5f9;"
			>
				<p
					style="font-size: 0.75rem; opacity: 0.5; font-style: italic; margin: 0;"
				>
					Menampilkan {totalItems} produk dari koleksi kami.
				</p>
			</div>
		</div>

		<!-- Sticky Bottom Action for Mobile -->
		<div class="sidebar-mobile-footer">
			{hasActiveFilters && (
				<a href="/products" class="mobile-reset-btn">
					Reset
				</a>
			)}
			<button type="button" class="mobile-apply-btn" id="mobile-apply-filter-btn">
				<span>Terapkan Filter</span>
				<span class="mobile-apply-count">({totalItems} Produk)</span>
			</button>
		</div>
	</aside>

	<!-- Product Grid -->
	<main>
		<div
			style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;"
		>
			<div class="results-info">
				Menampilkan <strong
					>{totalItems}</strong
				> produk
			</div>
			<div class="sorting-controls">
				<span class="sort-label">Urutkan:</span>
				<div class="custom-dropdown" id="sortDropdown">
