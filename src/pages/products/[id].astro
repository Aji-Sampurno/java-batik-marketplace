		if (thumbs && thumbs.length > 0) {
			thumbs.forEach(thumb => {
				thumb.addEventListener('click', () => {
					const newSrc = thumb.getAttribute('data-src');
					const thumbMotif = thumb.getAttribute('data-motif');

					if (mainImg && newSrc) {
						mainImg.style.opacity = '0.3';
						setTimeout(() => {
							mainImg.src = newSrc;
							mainImg.style.opacity = '1';
						}, 150);
						thumbs.forEach(t => t.classList.remove('active'));
						thumb.classList.add('active');
					}

					// Mutual Trigger: Selecting a thumbnail automatically triggers the corresponding Motif Button!
					if (thumbMotif) {
						const motifBtns = document.querySelectorAll('.var-motif-btn');
						const matchedBtn = Array.from(motifBtns).find(b => b.getAttribute('data-motif') === thumbMotif);
						if (matchedBtn && !matchedBtn.classList.contains('active')) {
							matchedBtn.click();
						}
					}
				});
			});
		}

		let currentSelectedMotif = '';

		// Color Swatch Click Handler -> Instantly switches main image according to selected color
		const colorBtns = document.querySelectorAll('.color-swatch-btn');
		if (colorBtns.length > 0) {
			colorBtns.forEach(btn => {
				btn.addEventListener('click', () => {
					const colorImg = btn.getAttribute('data-image');
					if (mainImg && colorImg) {
						mainImg.style.opacity = '0.3';
						setTimeout(() => {
							mainImg.src = colorImg;
							mainImg.style.opacity = '1';
						}, 150);
					}
					colorBtns.forEach(b => {
						b.classList.remove('active');
						b.style.borderColor = '#e2e8f0';
						b.style.background = '#fff';
					});
					btn.classList.add('active');
					btn.style.borderColor = '#8c7851';
					btn.style.background = '#fdfbf7';

					if (thumbs) {
						thumbs.forEach(thumb => {
							if (thumb.getAttribute('data-src') === colorImg) {
								thumbs.forEach(t => t.classList.remove('active'));
								thumb.classList.add('active');
							}
						});
					}
				});
			});
		}

		// Variant Selection Logic
		const baseSzBtns = document.querySelectorAll('.base-sz-btn');
		const subVarBtns = document.querySelectorAll('.sub-var-btn');
		const priceDisplay = document.querySelector('.product-price');
		const badgeDisplay = document.getElementById('stock-badge');
		const waBtn = document.getElementById('wa-btn');

		if (baseSzBtns.length > 0 && subVarBtns.length > 0 && priceDisplay) {
			const updateAvailability = (stock) => {
				const isAvailable = stock > 0;
				if (badgeDisplay) {
					badgeDisplay.className = `status-badge ${stock === 0 ? 'out-of-stock' : stock <= 5 ? 'warning-stock' : ''}`;
					if (stock === 0) {
						badgeDisplay.innerHTML = '🔴 HABIS';
					} else if (stock <= 5) {
						badgeDisplay.innerHTML = '⚠️ Sisa ' + stock + ' pcs';
					} else {
						badgeDisplay.innerHTML = '🟢 Ready Stock';
					}
				}
				if (waBtn && waBtn.getAttribute('target') !== '_self') {
					waBtn.classList.toggle('btn-disabled', !isAvailable);
					const btnText = waBtn.querySelector('.btn-text');
					if (btnText) btnText.innerText = isAvailable ? 'Chat Admin' : 'Stok Ukuran Habis';
				}
			};

			const updateDalaman = (dalaman) => {
				const dynamicDalamanInfo = document.getElementById('dynamic-dalaman-info');
				if (dynamicDalamanInfo) {
					if (dalaman === 'F') {
						dynamicDalamanInfo.innerHTML = '<span style="color: #8b5a2b; background: #fff8f0; border: 1px solid #e1d3c1; padding: 4px 10px; border-radius: 6px; font-size: 0.8rem; font-weight: 700; display: inline-flex; align-items: center; gap: 4px;">✨ Furing (F)</span>';
					} else {
						dynamicDalamanInfo.innerHTML = '';
					}
				}
			};

			const updateWAMessage = (selectedVar, dalaman, subName, counter, outlet) => {
				if (waBtn) {
					const code = `${product.code || ''}`;
					const name = `${product.name || ''}`;
					let detailsArr = [];
					if (currentSelectedMotif) detailsArr.push(`Motif: ${currentSelectedMotif}`);
					if (subName) detailsArr.push(`Model: ${subName}`);
					if (selectedVar) detailsArr.push(`Ukuran: ${selectedVar}`);
					if (dalaman === 'F') detailsArr.push(`Dalaman: Furing (F)`);
					else if (dalaman === 'TF') detailsArr.push(`Dalaman: Non Furing`);
					if (counter) detailsArr.push(`Counter: ${counter}`);
					if (outlet) detailsArr.push(`Outlet: ${outlet}`);
					
					const specText = detailsArr.length > 0 ? ` [${detailsArr.join(' | ')}]` : '';
					const msg = encodeURIComponent(`Halo, saya tertarik memesan produk ${name} (${code})${specText}. Apakah masih tersedia?`);
					waBtn.setAttribute('href', `https://wa.me/${waNumber}?text=${msg}`);
				}
			};

			const selectBaseSize = (size, currentMotif) => {
				let visibleCount = 0;
				// Hide all sub-variants first
				subVarBtns.forEach(btn => {
					const matchSize = btn.getAttribute('data-base-size') === size;
					const btnMotif = btn.getAttribute('data-motif');
					const matchMotif = !currentMotif || !btnMotif || btnMotif === currentMotif;

					if (matchSize && matchMotif) {
						btn.style.display = 'flex';
						visibleCount++;
					} else {
						btn.style.display = 'none';
					}
					btn.classList.remove('active');
				});

				// Dynamic Hide Step 2 if only 1 sub-variant exists
				const subVarContainer = document.getElementById('sub-variant-options')?.parentElement;
				if (subVarContainer) {
					if (visibleCount <= 1) {
						subVarContainer.style.display = 'none';
					} else {
						subVarContainer.style.display = 'block';
					}
				}

				// Auto-select the first visible sub-variant
				const firstVisible = Array.from(subVarBtns).find(btn => {
					const matchSize = btn.getAttribute('data-base-size') === size;
					const btnMotif = btn.getAttribute('data-motif');
					return matchSize && (!currentMotif || !btnMotif || btnMotif === currentMotif);
				});

				if (firstVisible) {
					firstVisible.classList.add('active');
					const price = parseInt(firstVisible.getAttribute('data-price') || '0', 10);
					if (price > 0) priceDisplay.innerText = "Rp " + price.toLocaleString('id-ID');
					const stock = parseInt(firstVisible.getAttribute('data-stock') || '0', 10);
					const dalaman = firstVisible.getAttribute('data-dalaman') || "";
					const subName = firstVisible.getAttribute('data-subname') || "";
					const counter = firstVisible.getAttribute('data-counter') || "";
					const outlet = firstVisible.getAttribute('data-outlet') || "";
					updateAvailability(stock);
					updateDalaman(dalaman);
					updateWAMessage(firstVisible.getAttribute('data-fullname'), dalaman, subName, counter, outlet);
				}
			};

			subVarBtns.forEach(btn => {
				btn.addEventListener('click', () => {
					subVarBtns.forEach(b => b.classList.remove('active'));
					btn.classList.add('active');
					const price = parseInt(btn.getAttribute('data-price') || '0', 10);
					if (price > 0) priceDisplay.innerText = "Rp " + price.toLocaleString('id-ID');
					const stock = parseInt(btn.getAttribute('data-stock') || '0', 10);
					const dalaman = btn.getAttribute('data-dalaman') || "";
					const subName = btn.getAttribute('data-subname') || "";
					const counter = btn.getAttribute('data-counter') || "";
					const outlet = btn.getAttribute('data-outlet') || "";
					updateAvailability(stock);
					updateDalaman(dalaman);
					updateWAMessage(btn.getAttribute('data-fullname'), dalaman, subName, counter, outlet);
				});
			});

			baseSzBtns.forEach(btn => {
				btn.addEventListener('click', () => {
					baseSzBtns.forEach(b => b.classList.remove('active'));
					btn.classList.add('active');

					const bImg = btn.getAttribute('data-image');
					if (mainImg && bImg) {
						mainImg.style.opacity = '0.3';
						setTimeout(() => {
							mainImg.src = bImg;
							mainImg.style.opacity = '1';
						}, 150);
					}

					selectBaseSize(btn.getAttribute('data-size'), currentSelectedMotif);
				});
			});

			// Outlet Badges Filter by Motif
			const filterOutletBadges = (motifName) => {
				const outletBadges = document.querySelectorAll('.outlet-pill-badge');
				const outletLabel = document.getElementById('outlet-section-label');
				let visibleCount = 0;

				outletBadges.forEach(badge => {
					const motifsAttr = badge.getAttribute('data-motifs') || '';
					const motifsList = motifsAttr.split(',').map(m => m.trim()).filter(Boolean);
					if (!motifName || motifsList.length === 0 || motifsList.includes(motifName)) {
						badge.style.display = 'inline-flex';
						visibleCount++;
					} else {
						badge.style.display = 'none';
					}
				});

				if (outletLabel) {
					if (motifName) {
						outletLabel.innerText = `Lokasi Outlet untuk ${motifName} (${visibleCount})`;
					} else {
						outletLabel.innerText = `Lokasi Outlet Tersedia (${visibleCount})`;
					}
				}
			};

			// Variant Motif Button Logic
			const varMotifBtns = document.querySelectorAll('.var-motif-btn');
			if (varMotifBtns.length > 0) {
				const selectMotif = (motifName) => {
					currentSelectedMotif = motifName;
					let firstMatchBtn = null;

					// Filter outlet badges according to motif
					filterOutletBadges(motifName);

					// Filter base sizes according to motif
					baseSzBtns.forEach(btn => {
						const btnMotif = btn.getAttribute('data-motif');
						if (!btnMotif || btnMotif === motifName) {
							btn.style.display = 'inline-flex';
							if (!firstMatchBtn) firstMatchBtn = btn;
						} else {
							btn.style.display = 'none';
						}
						btn.classList.remove('active');
					});

					// Auto-select first matching size
					if (firstMatchBtn) {
						firstMatchBtn.classList.add('active');
						selectBaseSize(firstMatchBtn.getAttribute('data-size'), motifName);
					}
				};

				varMotifBtns.forEach(btn => {
					btn.addEventListener('click', () => {
						varMotifBtns.forEach(b => {
							b.classList.remove('active');
							b.style.borderColor = '#e2e8f0';
							b.style.background = '#fff';
							b.style.color = '#1e293b';
						});
						btn.classList.add('active');
						btn.style.borderColor = '#0f172a';
						btn.style.background = '#0f172a';
						btn.style.color = '#fff';

						const mImg = btn.getAttribute('data-image');
						const mName = btn.getAttribute('data-motif');

						if (mainImg && mImg) {
							mainImg.style.opacity = '0.3';
							setTimeout(() => {
								mainImg.src = mImg;
								mainImg.style.opacity = '1';
							}, 150);
						}

						// Mutual Trigger: Synchronize active thumbnail with selected motif
						if (thumbs && thumbs.length > 0) {
							thumbs.forEach(t => {
								const tSrc = t.getAttribute('data-src');
								const tMotif = t.getAttribute('data-motif');
								if ((mImg && tSrc === mImg) || (mName && tMotif === mName)) {
									thumbs.forEach(item => item.classList.remove('active'));
									t.classList.add('active');
								}
							});
						}

						selectMotif(mName);
					});
				});

				// Initial motif selection
				if (varMotifBtns[0]) {
					selectMotif(varMotifBtns[0].getAttribute('data-motif'));
				}
			} else {
				filterOutletBadges('');
				// Initial state without motif filter
				const initialSize = baseSzBtns[0]?.getAttribute('data-size');
				if (initialSize) selectBaseSize(initialSize, '');
			}
		}

		// Start the engines
	</script>
</Layout>
