---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { apiFetch } from '../../lib/api';
import { getOutletAlias } from '../../lib/outlet';

const PUBLIC_API_URL = import.meta.env.PUBLIC_API_URL || "https://java.batik.katalog.gooproper.id/api";

const { id } = Astro.params;

let product: any = null;
let relatedProducts: any[] = [];
const waBaseUrl = "https://wa.me/";
let settings: any = { contact_whatsapp: '628123456789' };

try {
  // Fetch main product
  const resProduct = await apiFetch<any>(`products/${id}`);
  const p = resProduct?.data || resProduct;
  
  if (p) {
    product = p;
    // Fetch related products (same type, excluding current)
    try {
      const resProducts = await apiFetch<any>(`products?type=${p.type_id}&per_page=5`);
      const allProducts = resProducts?.data || resProducts || [];
      relatedProducts = allProducts
        .filter((item: any) => item.is_active && item.id !== id)
        .slice(0, 4);
    } catch (e) {}
  }

  const resSettings = await apiFetch<any>("settings");
  const s = resSettings?.data || resSettings;
  if (s) settings = s;
} catch (e: any) {
  console.error("API Fetch Error:", e.message);
}

if (!product) {
  return Astro.redirect('/404');
}

const productMotifs = (product.motifs || product.product_motifs || []).map((pm: any) => pm.name || pm.motifs?.name || '').filter(Boolean) || [];
// Get and sort categories by level
const productCategories = (product.categories || product.product_categories || [])
  ?.map((pc: any) => pc.name ? pc : pc.types)
  .filter(Boolean)
  .sort((a: any, b: any) => (a.category_level || a.level || 0) - (b.category_level || b.level || 0)) || [];

const isSetelanProduct =
  productCategories.some((c: any) => (c.name || '').toUpperCase().includes('SETELAN') || (c.name || '').toUpperCase().includes('STELAN')) ||
  (product.types?.name || '').toUpperCase().includes('SETELAN') ||
  (product.types?.name || '').toUpperCase().includes('STELAN') ||
  (product.name || '').toUpperCase().includes('SETELAN') ||
  (product.name || '').toUpperCase().startsWith('S ');

let effectiveProductPrice = Number(product.price || 0);
const rawProductVariants = product.variants || product.product_variants || [];
if (isSetelanProduct && rawProductVariants.length > 0) {
  const validPrices = rawProductVariants.map((v: any) => Number(v.price || 0)).filter((p: number) => p > 0);
  if (validPrices.length >= 2 && effectiveProductPrice < (validPrices[0] + validPrices[1])) {
    effectiveProductPrice = validPrices[0] + validPrices[1];
  }
}

const waNumber = settings.contact_whatsapp || "628123456789";
const waMessage = encodeURIComponent(`Halo, saya tertarik dengan produk ${product.name} (${product.code || ''}). Apakah masih tersedia?`);
const isOutOfStock = !product.is_active || product.total_stock === 0 || product.stock_status === 'habis';

const colorsList: string[] = product.colors || [];
const imagesList: string[] = product.images || (product.image_url ? [product.image_url] : []);
const rawImagesList: string[] = product.raw_images || (product.raw_image_url ? [product.raw_image_url] : []);

// Fallback logic for raw image URLs if raw_images array is not explicitly set
const effectiveRawImages: string[] = rawImagesList.length > 0
  ? rawImagesList
  : imagesList.map((url: string) => {
      if (url.includes('_raw_')) return url;
      return url.replace(/_(\d+_\d+)\.(webp|jpg|jpeg|png)$/i, '_raw_$1.$2').replace(/\.webp$/i, '.jpg');
    });

const isAdminMode = Astro.url.searchParams.get("admin") === "true" || Astro.url.searchParams.get("from") === "admin" || Astro.url.searchParams.has("admin");

let detectedColors: string[] = [...colorsList];
if (detectedColors.length === 0) {
  const knownColors = ["HITAM","PUTIH","MERAH","KUNING","HIJAU","BIRU","COKLAT","BROWN","BLACK","RED","BLUE","GREEN","WHITE","YELLOW","ORANGE","PINK","ABU-ABU","GREY","GRAY","KREM","UNGU","NAVY","MAROON","MARON","SOGA","TERACOTTA","PEACH","LAVENDER","MINT","OLIVE","DENIM","DUSTY","ROSE","GOLD","SILVER","TOSCA","KHAKI"];
  const nameUpper = (product.name || '').toUpperCase();
  const vars = product.variants || product.product_variants || [];
  const found = new Set<string>();
  knownColors.forEach(c => {
    if (nameUpper.includes(c)) found.add(c);
  });
  vars.forEach((v: any) => {
    const vName = (v.size_name || v.name || '').toUpperCase();
    knownColors.forEach(c => {
      if (vName.includes(c)) found.add(c);
    });
  });
  detectedColors = Array.from(found);
}

// Motif Swatches Mapping for Interactive Selector
const motifSwatches: { name: string; image: string }[] = [];
if (imagesList.length > 0) {
  imagesList.forEach((imgUrl: string, idx: number) => {
    let motifLabel = "";
    const motifMatch = imgUrl.match(/_MOTIF_([A-Z0-9]+)_/i);
    if (motifMatch) {
      motifLabel = `Motif ${motifMatch[1].toUpperCase()}`;
    } else if (productMotifs[idx]) {
      motifLabel = productMotifs[idx];
    } else if (imagesList.length > 1) {
      const letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
      motifLabel = `Motif ${letters[idx] || (idx + 1)}`;
    } else if (productMotifs.length > 0) {
      motifLabel = productMotifs[0];
    }

    if (motifLabel && !motifSwatches.some(m => m.name.toLowerCase() === motifLabel.toLowerCase())) {
      motifSwatches.push({
        name: motifLabel,
        image: imgUrl
      });
    }
  });
}
if (motifSwatches.length === 0 && productMotifs.length > 0) {
  productMotifs.forEach((mName: string, idx: number) => {
    motifSwatches.push({
      name: mName,
      image: imagesList[idx % imagesList.length] || product.image_url
    });
  });
}

const variants = product.variants || product.product_variants || [];
let hasVariantMotifs = false;

let parsedVariantsList = variants.map((v: any) => {
  let sizeName = (v.size_name || '').trim();
  let baseSize = sizeName;
  let motifName = (v.motif || '').trim();
  let isSF = v.fit === 'SF' || (v.fit && String(v.fit).toUpperCase().includes('SLIM')) || false;
  let sleeve = (v.sleeve || '').trim();
  if (sleeve === '-') sleeve = '';

  if (motifName) {
    hasVariantMotifs = true;
  }

  if (sizeName.includes(' SF')) {
    isSF = true;
    sizeName = sizeName.replace(' SF', '');
  }

  if (sizeName.includes(' - ')) {
    const parts = sizeName.split(' - ');
    if (/^motif\b/i.test(parts[0].trim())) {
      if (!motifName) motifName = parts[0].trim();
      baseSize = parts[1].trim();
      hasVariantMotifs = true;
    } else {
      baseSize = parts[0].trim();
      if (!sleeve) sleeve = parts[1].trim();
    }
  } else if (/^motif\b/i.test(sizeName)) {
    if (!motifName) motifName = sizeName;
    baseSize = 'ALL SIZE';
    hasVariantMotifs = true;
  } else {
    baseSize = sizeName.trim();
  }

  baseSize = baseSize.replace(/\s*\([^)]*\)$/, '').trim().toUpperCase();

  let sleeveLabel = sleeve ? (sleeve.toLowerCase().includes('lengan') ? sleeve : `Lengan ${sleeve}`) : '';
  let fitLabel = isSF ? 'Slim Fit' : 'Regular Fit';
  let subName = '';
  if (sleeveLabel && !isSetelanProduct && !/^motif\b/i.test(sleeveLabel)) {
    subName = `${sleeveLabel} (${fitLabel})`;
  } else {
    subName = fitLabel;
  }

  // Find image for this motif
  let motifImage = v.image_url || "";
  if (!motifImage && motifName) {
    const motifClean = motifName.replace(/[^a-zA-Z0-9]/g, '').toUpperCase();
    motifImage = imagesList.find((url: string) => url.toUpperCase().includes(motifClean)) || "";
  }
  if (!motifImage && imagesList.length > 0) {
    motifImage = imagesList[0];
  }

  let displayLabel = baseSize;
  if (motifName && !isSetelanProduct) {
    displayLabel = `${motifName} - ${baseSize}`;
  }

  let rawOutlet = (v.outlet || v.outlet_location || v.counter_name || v.counter || product.outlet_location || product.counter || '').trim();
  let outletAlias = rawOutlet ? getOutletAlias(rawOutlet) : '';

  return {
    ...v,
    motifName: motifName || (productMotifs[0] || ""),
    baseSize,
    sleeve: sleeveLabel,
    displayLabel,
    subName,
    isSF,
    motifImage,
    outlet: outletAlias || rawOutlet
  };
});

const variantMotifsList = [...new Set(parsedVariantsList.map((v: any) => v.motifName).filter(Boolean))];

const rawAllOutlets = [
  product.outlet_location,
  product.counter,
  ...(variants || []).map((v: any) => v.outlet || v.outlet_location || v.counter_name || v.counter)
].filter(Boolean);

const uniqueOutletsList = [...new Set(rawAllOutlets.map(o => getOutletAlias(o)).filter(Boolean))];

const outletMotifsMap: Record<string, string[]> = {};
parsedVariantsList.forEach((v: any) => {
  const out = v.outlet;
  const motif = v.motifName;
  if (out && motif) {
    if (!outletMotifsMap[out]) outletMotifsMap[out] = [];
    if (!outletMotifsMap[out].includes(motif)) {
      outletMotifsMap[out].push(motif);
    }
  }
});

if (isSetelanProduct) {
  const consolidatedMap = new Map<string, any>();
  parsedVariantsList.forEach((v: any) => {
    const key = v.baseSize;
    if (!consolidatedMap.has(key)) {
      consolidatedMap.set(key, { ...v, parts: [v] });
    } else {
      const existing = consolidatedMap.get(key);
      existing.parts.push(v);
    }
  });

  parsedVariantsList = Array.from(consolidatedMap.values()).map((c: any) => {
    const parts = c.parts;
    let combinedPrice = Number(c.price || 0);
    if (parts.length >= 2) {
      const partPrices = parts.map((p: any) => Number(p.price || 0)).filter((pr: number) => pr > 0);
      if (partPrices.length >= 2) {
        combinedPrice = partPrices[0] + partPrices[1];
      }
    }
    if (combinedPrice < effectiveProductPrice) {
      combinedPrice = effectiveProductPrice;
    }

    let combinedStock = Math.min(...parts.map((p: any) => parseInt(p.stock || 0)));
    let combinedDalaman = parts.some((p: any) => p.dalaman === 'F') ? 'F' : (c.dalaman || '');

    return {
      ...c,
      price: combinedPrice,
      stock: combinedStock,
      dalaman: combinedDalaman,
      size_name: c.baseSize,
      subName: c.isSF ? 'Slim Fit (1 Set)' : 'Regular Fit (1 Set)'
    };
  });
}

const baseSizesList = [...new Set(parsedVariantsList.map((v: any) => v.baseSize))].filter(Boolean);
const sizeOrder = ['S', 'M', 'L', 'XL', 'XXL', '3XL', 'ALL SIZE'];
baseSizesList.sort((a: any, b: any) => {
  const idxA = sizeOrder.indexOf(a);
  const idxB = sizeOrder.indexOf(b);
  if (idxA !== -1 && idxB !== -1) return idxA - idxB;
  if (idxA !== -1) return -1;
  if (idxB !== -1) return 1;
  return a.localeCompare(b);
});

const sizeStockMap: Record<string, number> = {};
parsedVariantsList.forEach((v: any) => {
  const stock = parseInt(v.stock || 0);
  sizeStockMap[v.baseSize] = (sizeStockMap[v.baseSize] || 0) + stock;
});

// Group unique (motif, baseSize) for clean size chips display
interface UniqueMotifSize {
  motifName: string;
  baseSize: string;
  totalStock: number;
  motifImage: string;
  isOutOfStock: boolean;
}

const motifSizeMap = new Map<string, UniqueMotifSize>();
parsedVariantsList.forEach((v: any) => {
  const mName = v.motifName || '';
  const bSize = v.baseSize || 'ALL SIZE';
  const key = `${mName}___${bSize}`;
  const stockNum = parseInt(v.stock || 0);

  if (!motifSizeMap.has(key)) {
    motifSizeMap.set(key, {
      motifName: mName,
      baseSize: bSize,
      totalStock: stockNum,
      motifImage: v.motifImage || '',
      isOutOfStock: false
    });
  } else {
    const existing = motifSizeMap.get(key)!;
    existing.totalStock += stockNum;
    if (!existing.motifImage && v.motifImage) {
      existing.motifImage = v.motifImage;
    }
  }
});

const uniqueMotifSizeList = Array.from(motifSizeMap.values()).map(item => ({
  ...item,
  isOutOfStock: item.totalStock <= 0
}));

uniqueMotifSizeList.sort((a, b) => {
  const idxA = sizeOrder.indexOf(a.baseSize);
  const idxB = sizeOrder.indexOf(b.baseSize);
  if (idxA !== -1 && idxB !== -1) return idxA - idxB;
  if (idxA !== -1) return -1;
  if (idxB !== -1) return 1;
  return a.baseSize.localeCompare(b.baseSize);
});

// Group consolidated sub-variants by (motif, baseSize, subName, price, dalaman)
const consolidatedSubVariantsMap = new Map<string, any>();
parsedVariantsList.forEach((v: any) => {
  const mName = v.motifName || '';
  const bSize = v.baseSize || 'ALL SIZE';
  const sName = v.subName || '';
  const priceVal = Number(v.price || 0);
  const dalamanVal = v.dalaman || '';
  const key = `${mName}___${bSize}___${sName}___${priceVal}___${dalamanVal}`;
  const stockNum = parseInt(v.stock || 0);
  const outName = v.outlet || '';

  if (!consolidatedSubVariantsMap.has(key)) {
    consolidatedSubVariantsMap.set(key, {
      ...v,
      totalStock: stockNum,
      counterCodes: [v.counter || v.sku || ''].filter(Boolean),
      outlets: [outName].filter(Boolean)
    });
  } else {
    const existing = consolidatedSubVariantsMap.get(key);
    existing.totalStock += stockNum;
    if (v.counter || v.sku) {
      existing.counterCodes.push(v.counter || v.sku);
    }
    if (outName && !existing.outlets.includes(outName)) {
      existing.outlets.push(outName);
    }
  }
});

const consolidatedSubVariantsList = Array.from(consolidatedSubVariantsMap.values()).map(item => ({
  ...item,
  stock: item.totalStock,
  counterSummary: item.counterCodes.join(', '),
  outletSummary: item.outlets.join(', ')
}));

function renderMarkdown(md: string): string {
  if (!md) return '';
  
  // Escape HTML to prevent XSS
  let html = md
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');

  // Render Horizontal Lines: --- or ___ or ***
  html = html.replace(/^\s*[-_*]{3,}\s*$/gm, '<hr style="border: 0; border-top: 1px solid #eee; margin: 1.5rem 0;" />');

  // Render Bold: **text**
  html = html.replace(/\*\*(.*?)\*\*/g, '<strong style="font-weight: 700; color: #1e293b;">$1</strong>');

  // Render Italic: *text* or _text_
  html = html.replace(/\*(.*?)\*/g, '<em style="font-style: italic;">$1</em>');
  html = html.replace(/_(.*?)_/g, '<em style="font-style: italic;">$1</em>');

  // Render Lists: * item or - item
  const lines = html.split('\n');
  let inList = false;
  const processedLines = lines.map(line => {
    const trimmed = line.trim();
    const listMatch = line.match(/^\s*[-*]\s+(.*)$/);
    if (listMatch) {
      const content = listMatch[1];
      if (!inList) {
        inList = true;
        return '<ul style="list-style-type: disc; margin-left: 1.5rem; margin-top: 0.5rem; margin-bottom: 0.5rem; display: flex; flex-direction: column; gap: 0.25rem;">\n<li style="font-size: 1.05rem; line-height: 1.8; font-weight: 300; opacity: 0.85;">' + content + '</li>';
      }
      return '<li style="font-size: 1.05rem; line-height: 1.8; font-weight: 300; opacity: 0.85;">' + content + '</li>';
    } else {
      if (inList) {
        inList = false;
        return '</ul>\n' + (trimmed ? '<p style="margin-bottom: 1rem; font-size: 1.05rem; line-height: 1.8; font-weight: 300; opacity: 0.8;">' + line + '</p>' : '');
      }
      return trimmed ? '<p style="margin-bottom: 1rem; font-size: 1.05rem; line-height: 1.8; font-weight: 300; opacity: 0.8;">' + line + '</p>' : '';
    }
  });

  if (inList) {
    processedLines.push('</ul>');
  }

  return processedLines.join('\n');
}
---

<Layout title={product.name}>
	<section class="product-detail-section" style="padding: 140px 0 0 0; background: #fff;">
		<div class="container">
			<!-- Breadcrumbs -->
			<nav class="breadcrumb-nav">
				<a href="/" class="breadcrumb-link">Home</a> 
				<span class="sep">|</span> 
				<a href="/products" class="breadcrumb-link">Katalog</a> 
				<span class="sep">|</span> 
				<span class="current-crumb">{product.name}</span>
			</nav>

			<div class="detail-grid">
				<!-- Left: Image Gallery -->
				<div class="image-gallery reveal-left">
					<div class="main-image-container">
						<img id="main-product-img" src={product.image_url} alt={product.name} class="main-image" />
						{isOutOfStock && (
							<div class="ribbon-wrapper">
								<div class="ribbon">HABIS</div>
							</div>
						)}

					</div>

					
					{product.images && product.images.length > 1 && (
						<div class="thumbnail-strip">
							{product.images.map((img: string, i: number) => {
								let matchedMotif = "";
								const motifMatch = img.match(/_MOTIF_([A-Z0-9]+)_/i);
								if (motifMatch) {
									matchedMotif = `Motif ${motifMatch[1].toUpperCase()}`;
								} else {
									const foundVar = parsedVariantsList.find((v: any) => v.motifImage === img || (v.image_url && v.image_url === img));
									matchedMotif = foundVar?.motifName || (variantMotifsList[i] || "");
								}
								return (
									<div class={`thumb-item ${i === 0 ? 'active' : ''}`} data-src={img} data-motif={matchedMotif}>
										<img src={img} alt={`${product.name} view ${i+1}`} />
									</div>
								);
							})}
						</div>
					)}
				</div>

				<!-- Right: Product Info -->
				<div class="product-info-panel reveal-right">
					<div class="info-header">
						<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem;">
							<p class="sku-code">{product.code || 'NO SKU'}</p>
							<div id="stock-badge" class={`status-badge ${isOutOfStock ? 'out-of-stock' : (product.total_stock > 0 && 5 >= product.total_stock) ? 'warning-stock' : ''}`}>
								{isOutOfStock ? '🔴 HABIS' : (product.total_stock > 0 && 5 >= product.total_stock) ? `⚠️ Sisa ${product.total_stock} pcs` : '🟢 Ready Stock'}
							</div>
						</div>
						<h1 class="product-name">{product.name}</h1>
						<div style="display: flex; align-items: center; gap: 1rem; margin-bottom: var(--spacing-lg);">
							<p class="product-price" style="margin: 0;">Rp {Number(effectiveProductPrice).toLocaleString('id-ID')}</p>
							{product.original_price && product.original_price > effectiveProductPrice && (
								<div style="display: flex; flex-direction: column;">
									<span style="text-decoration: line-through; color: #999; font-size: 0.9rem;">
										Rp {Number(product.original_price).toLocaleString('id-ID')}
									</span>
									<span style="color: #10b981; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 1px;">
										Hemat Rp {Number(product.original_price - effectiveProductPrice).toLocaleString("id-ID")}
									</span>
								</div>
							)}
						</div>
						<div style="display: flex; gap: 0.75rem; align-items: center; margin-top: -0.5rem; margin-bottom: 1.5rem; flex-wrap: wrap;">
							<div id="dynamic-dalaman-info" style="font-size: 0.9rem; font-weight: 600;"></div>
						</div>
					</div>

					<div class="meta-section">
						<!-- Product Spec Info: Kategori, Motif, Outlet in a clean modern row -->
						<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1.25rem; padding: 1.1rem; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; margin-bottom: 1.25rem;">
							<div>
								<span style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px; color: #64748b; font-weight: 700; display: block; margin-bottom: 0.25rem;">Kategori</span>
								<div class="tag-container" style="gap: 6px; font-size: 0.85rem;">
									{productCategories.map((cat: any, i: number) => (
										<>
											<span style={i > 0 ? "color: #64748b;" : "font-weight: 700; color: #0f172a;"}>
												{cat.name}
											</span>
											{i < productCategories.length - 1 && <span style="color: #cbd5e1;">›</span>}
										</>
									))}
									{productCategories.length === 0 && <span style="font-weight: 700; color: #0f172a;">{product.types?.name || '-'}</span>}
								</div>
							</div>

							{productMotifs.length > 0 && (
								<div>
									<span style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px; color: #64748b; font-weight: 700; display: block; margin-bottom: 0.25rem;">Motif Batik</span>
									<span style="font-weight: 700; color: #0f172a; font-size: 0.85rem;">
										{productMotifs.join(", ")}
									</span>
								</div>
							)}

							{uniqueOutletsList.length > 0 && (
								<div id="product-outlet-section" style="grid-column: 1 / -1; border-top: 1px dashed #e2e8f0; padding-top: 0.75rem;">
									<span style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px; color: #64748b; font-weight: 700; display: block; margin-bottom: 0.4rem;">
										<span id="outlet-section-label">Lokasi Outlet Tersedia</span>:
									</span>
									<div id="outlet-pills-container" style="display: flex; flex-wrap: wrap; gap: 0.45rem;">
										{uniqueOutletsList.map(out => {
											const associatedMotifs = outletMotifsMap[out] || [];
											return (
												<span 
													class="outlet-pill-badge" 
													data-outlet={out}
													data-motifs={associatedMotifs.join(",")}
													style="background: #f0f9ff; color: #0369a1; border: 1px solid #bae6fd; padding: 4px 10px; border-radius: 6px; font-size: 0.8rem; font-weight: 700; display: inline-flex; align-items: center; gap: 4px; transition: all 0.2s;"
												>
													📍 {out}
												</span>
											);
										})}
									</div>
								</div>
							)}
						</div>

						{/* Variant & Size Selection */}
						{parsedVariantsList.length > 0 ? (
							<div class="meta-item" style="margin-top: 0.5rem;">
								<span class="meta-label" style="font-weight: 800; color: #0f172a; font-size: 0.95rem; display: block; margin-bottom: 0.75rem;">
									{hasVariantMotifs && variantMotifsList.length > 0 ? "Pilihan Motif & Ukuran" : "Pilihan Ukuran"}
								</span>
								<div id="variant-group-selector" style="display: flex; flex-direction: column; gap: 1.25rem; width: 100%;">
									
									<!-- 1. Motif Selection (Muncul jika produk memiliki varian motif) -->
