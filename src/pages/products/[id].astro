			.detail-grid {
				grid-template-columns: 1fr;
				gap: var(--spacing-xl);
			}

			.main-image-container {
				position: static;
				margin-top: 0;
			}

			.product-name {
				font-size: 1.8rem;
			}
		}

		.breadcrumb-nav {
			margin-bottom: 3rem;
			font-size: 0.65rem;
			text-transform: uppercase;
			letter-spacing: 0.25em;
			display: flex;
			align-items: center;
			gap: 0.8rem;
			opacity: 0.8;
			font-weight: 500;
			position: relative;
			z-index: 10;
			flex-wrap: wrap;
		}

		.breadcrumb-link {
			color: var(--color-text);
			text-decoration: none;
			transition: all 0.3s ease;
			position: relative;
			padding-bottom: 2px;
		}

		.breadcrumb-link::after {
			content: "";
			position: absolute;
			bottom: 0;
			left: 0;
			width: 0;
			height: 1px;
			background: var(--color-accent);
			transition: width 0.3s ease;
		}

		.breadcrumb-link:hover {
			color: var(--color-accent);
		}

		.breadcrumb-link:hover::after {
			width: 100%;
		}

		.breadcrumb-nav .sep {
			opacity: 0.2;
			font-weight: 200;
			font-size: 0.8rem;
			margin: 0 0.5rem;
		}

		.breadcrumb-nav .current-crumb {
			color: var(--color-accent);
			font-weight: 600;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
			max-width: 300px;
		}
	</style>



	<script is:inline define:vars={{ productData: product, waNumberData: waNumber }}>
		window.product = productData;
		window.waNumber = waNumberData;
	</script>
	<script is:inline>
		// =========================================================================
		// 3-STEP HIERARCHICAL SELECTOR: MOTIF -> SLEEVE -> SIZE
		// =========================================================================
		const mainImg = document.getElementById('main-product-img');
		const thumbs = document.querySelectorAll('.thumb-item');
		const varMotifBtns = document.querySelectorAll('.var-motif-btn');
		const varSleeveBtns = document.querySelectorAll('.var-sleeve-btn');
		const baseSzBtns = document.querySelectorAll('.base-sz-btn');
		const priceDisplay = document.querySelector('.product-price');
		const badgeDisplay = document.getElementById('stock-badge');
		const waBtn = document.getElementById('wa-btn');

		let currentSelectedMotif = '';
		let currentSelectedSleeve = '';

		// 1. Synchronize Active Thumbnail
		const syncActiveThumbnail = (src) => {
			if (!thumbs || thumbs.length === 0 || !src) return;
			const cleanUrl = (u) => (u || '').split('?')[0].trim();
			const targetClean = cleanUrl(src);
			let found = false;
			thumbs.forEach(t => {
				const tSrc = cleanUrl(t.getAttribute('data-src'));
				if (tSrc === targetClean || (targetClean && tSrc && (targetClean.endsWith(tSrc) || tSrc.endsWith(targetClean)))) {
					t.classList.add('active');
					found = true;
				} else {
					t.classList.remove('active');
				}
			});
			if (!found && thumbs[0]) {
				thumbs[0].classList.add('active');
			}
		};

		// 2. Update Dynamic Badges & WhatsApp URL
		const updateAvailability = (stock) => {
			const isAvailable = stock > 0;
			if (badgeDisplay) {
				badgeDisplay.className = `status-badge ${stock === 0 ? 'out-of-stock' : stock <= 5 ? 'warning-stock' : ''}`;
				if (stock === 0) {
					badgeDisplay.innerHTML = '🔴 HABIS';
				} else if (stock <= 5) {
					badgeDisplay.innerHTML = '⚠️ Sisa ' + stock + ' pcs';
				} else {
					badgeDisplay.innerHTML = '🟢 Ready Stock';
				}
			}
			if (waBtn && waBtn.getAttribute('target') !== '_self') {
				waBtn.classList.toggle('btn-disabled', !isAvailable);
				const btnText = waBtn.querySelector('.btn-text');
				if (btnText) btnText.innerText = isAvailable ? 'Chat Admin' : 'Stok Ukuran Habis';
			}
		};

		const updateDalaman = (dalaman) => {
			const dynamicDalamanInfo = document.getElementById('dynamic-dalaman-info');
			if (dynamicDalamanInfo) {
				if (dalaman === 'F') {
					dynamicDalamanInfo.innerHTML = '<span style="color: #8b5a2b; background: #fff8f0; border: 1px solid #e1d3c1; padding: 4px 10px; border-radius: 6px; font-size: 0.8rem; font-weight: 700; display: inline-flex; align-items: center; gap: 4px;">✨ Furing (F)</span>';
				} else {
					dynamicDalamanInfo.innerHTML = '';
				}
			}
		};

		const updateSleeveInfo = (sleeve, subName) => {
			const dynamicSleeveInfo = document.getElementById('dynamic-sleeve-info');
			if (dynamicSleeveInfo) {
				let finalSleeve = sleeve || '';
				if (!finalSleeve && subName) {
					if (subName.toLowerCase().includes('lengan')) {
						finalSleeve = subName.split('(')[0].trim();
					}
				}
				if (finalSleeve) {
					const cleanSleeve = finalSleeve.toLowerCase().includes('lengan') ? finalSleeve : `Lengan ${finalSleeve}`;
					dynamicSleeveInfo.innerHTML = `<span style="color: #0369a1; background: #f0f9ff; border: 1px solid #bae6fd; padding: 4px 10px; border-radius: 6px; font-size: 0.8rem; font-weight: 700; display: inline-flex; align-items: center; gap: 4px;">👔 ${cleanSleeve}</span>`;
				} else {
					dynamicSleeveInfo.innerHTML = '';
				}
			}
		};

		const updateWAMessage = (selectedVar, dalaman, subName, counter, outlet) => {
			if (waBtn) {
				const code = `${product.code || ''}`;
				const name = `${product.name || ''}`;
				let detailsArr = [];
				if (currentSelectedMotif) detailsArr.push(`Motif: ${currentSelectedMotif}`);
				if (currentSelectedSleeve) detailsArr.push(`Lengan: ${currentSelectedSleeve}`);
				if (subName) detailsArr.push(`Model: ${subName}`);
				if (selectedVar) detailsArr.push(`Ukuran: ${selectedVar}`);
				if (dalaman === 'F') detailsArr.push(`Dalaman: Furing (F)`);
				else if (dalaman === 'TF') detailsArr.push(`Dalaman: Non Furing`);
				if (counter) detailsArr.push(`Counter: ${counter}`);
				if (outlet) detailsArr.push(`Outlet: ${outlet}`);
				
				const specText = detailsArr.length > 0 ? ` [${detailsArr.join(' | ')}]` : '';
				const msg = encodeURIComponent(`Halo, saya tertarik memesan produk ${name} (${code})${specText}. Apakah masih tersedia?`);
				waBtn.setAttribute('href', `https://wa.me/${waNumber}?text=${msg}`);
			}
		};

		// 3. Outlet Badges Filter by Motif
		const filterOutletBadges = (motifName) => {
			const outletBadges = document.querySelectorAll('.outlet-pill-badge');
			const outletLabel = document.getElementById('outlet-section-label');
			let visibleCount = 0;

			outletBadges.forEach(badge => {
				const motifsAttr = badge.getAttribute('data-motifs') || '';
				const motifsList = motifsAttr.split(',').map(m => m.trim()).filter(Boolean);
				if (!motifName || motifsList.length === 0 || motifsList.includes(motifName)) {
					badge.style.display = 'inline-flex';
					visibleCount++;
				} else {
					badge.style.display = 'none';
				}
			});

			if (outletLabel) {
				if (motifName) {
					outletLabel.innerText = `Lokasi Outlet untuk ${motifName} (${visibleCount})`;
				} else {
					outletLabel.innerText = `Lokasi Outlet Tersedia (${visibleCount})`;
				}
			}
		};

		// 4. Apply Size Details (Step 3 Target)
		const applySizeDetails = (btn) => {
			if (!btn) return;
			const price = parseInt(btn.getAttribute('data-price') || '0', 10);
			if (price > 0 && priceDisplay) priceDisplay.innerText = "Rp " + price.toLocaleString('id-ID');
			const stock = parseInt(btn.getAttribute('data-stock') || '0', 10);
			const dalaman = btn.getAttribute('data-dalaman') || "";
			const subName = btn.getAttribute('data-subname') || "";
			const sleeve = btn.getAttribute('data-sleeve') || currentSelectedSleeve || "";
			const counter = btn.getAttribute('data-counter') || "";
			const outlet = btn.getAttribute('data-outlet') || "";
			const bImg = btn.getAttribute('data-image');

			updateAvailability(stock);
			updateDalaman(dalaman);
			updateSleeveInfo(sleeve, subName);
			updateWAMessage(btn.getAttribute('data-fullname') || btn.getAttribute('data-size'), dalaman, subName, counter, outlet);

			if (mainImg && bImg) {
				mainImg.style.opacity = '0.3';
				setTimeout(() => {
					mainImg.src = bImg;
					mainImg.style.opacity = '1';
				}, 150);
				syncActiveThumbnail(bImg);
			}
		};

		// 5. Filter Sizes (Step 3 based on Motif & Sleeve)
		const filterSizes = (motifName, sleeveName) => {
			let firstVisibleSize = null;
			let visibleCount = 0;

			baseSzBtns.forEach(btn => {
				const btnMotif = btn.getAttribute('data-motif');
				const btnSleeve = btn.getAttribute('data-sleeve');

				const matchMotif = !motifName || !btnMotif || btnMotif === motifName;
				const matchSleeve = !sleeveName || !btnSleeve || btnSleeve === sleeveName;

				if (matchMotif && matchSleeve) {
					btn.style.display = 'inline-flex';
					visibleCount++;
					if (!firstVisibleSize) firstVisibleSize = btn;
				} else {
					btn.style.display = 'none';
				}
			});

			// Auto-activate first visible size
			const activeSize = Array.from(baseSzBtns).find(b => b.classList.contains('active') && b.style.display !== 'none');
			if (activeSize) {
				applySizeDetails(activeSize);
			} else if (firstVisibleSize) {
				baseSzBtns.forEach(b => b.classList.remove('active'));
				firstVisibleSize.classList.add('active');
				applySizeDetails(firstVisibleSize);
			}
		};

		// 6. Filter Sleeves (Step 2 based on Motif)
		const filterSleeves = (motifName) => {
			let firstVisibleSleeve = null;
			let visibleCount = 0;

			varSleeveBtns.forEach(btn => {
				const btnMotif = btn.getAttribute('data-motif');
				const matchMotif = !motifName || !btnMotif || btnMotif === motifName;

				if (matchMotif) {
					btn.style.display = 'inline-flex';
					visibleCount++;
					if (!firstVisibleSleeve) firstVisibleSleeve = btn;
				} else {
					btn.style.display = 'none';
				}
			});

			const stepSleeve = document.getElementById('selector-step-sleeve');
			if (stepSleeve) {
				stepSleeve.style.display = visibleCount > 0 ? 'block' : 'none';
			}

			// Auto-activate first visible sleeve if needed
			const activeSleeve = Array.from(varSleeveBtns).find(b => b.classList.contains('active') && b.style.display !== 'none');
			if (activeSleeve) {
				currentSelectedSleeve = activeSleeve.getAttribute('data-sleeve') || '';
			} else if (firstVisibleSleeve) {
				varSleeveBtns.forEach(b => {
					b.classList.remove('active');
					b.style.borderColor = '#cbd5e1';
					b.style.background = '#fff';
					b.style.color = '#1e293b';
				});
				firstVisibleSleeve.classList.add('active');
				firstVisibleSleeve.style.borderColor = '#0f172a';
				firstVisibleSleeve.style.background = '#0f172a';
				firstVisibleSleeve.style.color = '#fff';
				currentSelectedSleeve = firstVisibleSleeve.getAttribute('data-sleeve') || '';
			} else {
				currentSelectedSleeve = '';
			}

			filterSizes(motifName, currentSelectedSleeve);
		};

		// 7. Event Handlers: Motif Buttons (Step 1)
		if (varMotifBtns.length > 0) {
			varMotifBtns.forEach(btn => {
				btn.addEventListener('click', () => {
					varMotifBtns.forEach(b => {
						b.classList.remove('active');
						b.style.borderColor = '#cbd5e1';
						b.style.background = '#fff';
						b.style.color = '#1e293b';
					});
					btn.classList.add('active');
					btn.style.borderColor = '#0f172a';
					btn.style.background = '#0f172a';
					btn.style.color = '#fff';

					const mImg = btn.getAttribute('data-image');
					const mName = btn.getAttribute('data-motif') || '';
					currentSelectedMotif = mName;

					if (mainImg && mImg) {
						mainImg.style.opacity = '0.3';
						setTimeout(() => {
							mainImg.src = mImg;
							mainImg.style.opacity = '1';
						}, 150);
						syncActiveThumbnail(mImg);
					}

					filterOutletBadges(mName);
					filterSleeves(mName);
				});
			});
		}

		// 8. Event Handlers: Sleeve Buttons (Step 2)
		if (varSleeveBtns.length > 0) {
			varSleeveBtns.forEach(btn => {
				btn.addEventListener('click', () => {
					varSleeveBtns.forEach(b => {
						b.classList.remove('active');
						b.style.borderColor = '#cbd5e1';
						b.style.background = '#fff';
						b.style.color = '#1e293b';
					});
					btn.classList.add('active');
					btn.style.borderColor = '#0f172a';
					btn.style.background = '#0f172a';
					btn.style.color = '#fff';

					const sName = btn.getAttribute('data-sleeve') || '';
					const sImg = btn.getAttribute('data-image');
					currentSelectedSleeve = sName;

					if (mainImg && sImg) {
						mainImg.style.opacity = '0.3';
						setTimeout(() => {
							mainImg.src = sImg;
							mainImg.style.opacity = '1';
						}, 150);
						syncActiveThumbnail(sImg);
					}

					filterSizes(currentSelectedMotif, sName);
				});
			});
		}

		// 9. Event Handlers: Size Buttons (Step 3)
		if (baseSzBtns.length > 0) {
			baseSzBtns.forEach(btn => {
				btn.addEventListener('click', () => {
					baseSzBtns.forEach(b => b.classList.remove('active'));
					btn.classList.add('active');
					applySizeDetails(btn);
				});
			});
		}

		// 10. Event Handlers: Thumbnails Strip (2-Way Mutual Synchronization)
		if (thumbs && thumbs.length > 0) {
			thumbs.forEach(thumb => {
				thumb.addEventListener('click', () => {
					const newSrc = thumb.getAttribute('data-src');
					const thumbMotif = thumb.getAttribute('data-motif');
					const thumbSleeve = thumb.getAttribute('data-sleeve');
					const thumbSize = thumb.getAttribute('data-size');

					if (mainImg && newSrc) {
						mainImg.style.opacity = '0.3';
						setTimeout(() => {
							mainImg.src = newSrc;
							mainImg.style.opacity = '1';
						}, 150);
						thumbs.forEach(t => t.classList.remove('active'));
						thumb.classList.add('active');
					}

					// 1. Sync Motif Button if available
					if (thumbMotif && varMotifBtns.length > 0) {
						const matchedMotifBtn = Array.from(varMotifBtns).find(b => b.getAttribute('data-motif') === thumbMotif);
						if (matchedMotifBtn && !matchedMotifBtn.classList.contains('active')) {
							matchedMotifBtn.click();
						}
					}

					// 2. Sync Sleeve Button if available
					if (thumbSleeve && varSleeveBtns.length > 0) {
						const matchedSleeveBtn = Array.from(varSleeveBtns).find(b => b.getAttribute('data-sleeve') === thumbSleeve && b.style.display !== 'none');
						if (matchedSleeveBtn && !matchedSleeveBtn.classList.contains('active')) {
							matchedSleeveBtn.click();
						}
					}

					// 3. Sync Size Button
					if (thumbSize && baseSzBtns.length > 0) {
						const matchedSzBtn = Array.from(baseSzBtns).find(b => b.getAttribute('data-size') === thumbSize && b.style.display !== 'none');
						if (matchedSzBtn && !matchedSzBtn.classList.contains('active')) {
							matchedSzBtn.click();
						}
					} else if (newSrc) {
						const cleanUrl = (u) => (u || '').split('?')[0].trim();
						const targetClean = cleanUrl(newSrc);
						const matchedSzBtn = Array.from(baseSzBtns).find(b => {
							const bImg = cleanUrl(b.getAttribute('data-image'));
							return bImg === targetClean && b.style.display !== 'none';
						});
						if (matchedSzBtn && !matchedSzBtn.classList.contains('active')) {
							matchedSzBtn.click();
						}
					}
				});
			});
		}

		// 11. Initial State Activation
		if (varMotifBtns.length > 0 && varMotifBtns[0]) {
			varMotifBtns[0].click();
		} else {
			filterOutletBadges('');
			filterSleeves('');
		}
	</script>
</Layout>
